LOAD FILE=../../../../plumedOpenACC.so
# With MPI the tasks of the GPU actions are split in blocks between the 4 processes, and
# the results summed. The contact matrix c1 has 3 rows and 108 columns: the last process
# computes no row, but some of the columns in the second pass of the low memory force
# gathering (used by default on the GPU), so it must upload the positions there.
# The CPU references come from regtest/adjmat/rt-nogather-serial-mpi
c1: CONTACT_MATRIX GROUPA=1-3 GROUPB=1-108 SWITCH={RATIONAL R_0=1 NN=6 MM=12 D_MAX=2} USEGPU
ones: ONES SIZE=108
cc: MATRIX_VECTOR_PRODUCT ARG=c1,ones USEGPU
mtc: MORE_THAN ARG=cc SWITCH={RATIONAL D_0=2 R_0=2} USEGPU
s: SUM ARG=mtc PERIODIC=NO
BIASVALUE ARG=s

c2: CONTACT_MATRIX GROUP=1-20 SWITCH={RATIONAL R_0=1.5 NN=6 MM=12} USEGPU
c22: MATRIX_PRODUCT ARG=c2,c2 USEGPU
diag: DIAGONALIZE ARG=c22 VECTORS=1
BIASVALUE ARG=diag.vals-1

PRINT ARG=s,diag.vals-1 FILE=colvar FMT=%10.5f
