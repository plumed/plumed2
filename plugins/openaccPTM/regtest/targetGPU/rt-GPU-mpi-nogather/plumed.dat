LOAD FILE=../../../../plumedOpenACC.so
# With MULTIGPU the tasks of the GPU actions are split in blocks between the 4 processes,
# and the results summed. AVOID_THREAD_GATHER asks for the low memory force gathering.
# The contact matrix c1 has 3 rows and 108 columns: the last process computes no row,
# but some of the columns in the second pass of the low memory force gathering, so it
# must upload the positions there.
# The CPU references come from regtest/adjmat/rt-nogather-serial-mpi
c1: CONTACT_MATRIX GROUPA=1-3 GROUPB=1-108 SWITCH={RATIONAL R_0=1 NN=6 MM=12 D_MAX=2} USEGPU MULTIGPU AVOID_THREAD_GATHER
ones: ONES SIZE=108
cc: MATRIX_VECTOR_PRODUCT ARG=c1,ones USEGPU MULTIGPU
mtc: MORE_THAN ARG=cc SWITCH={RATIONAL D_0=2 R_0=2} USEGPU MULTIGPU
s: SUM ARG=mtc PERIODIC=NO
BIASVALUE ARG=s

c2: CONTACT_MATRIX GROUP=1-20 SWITCH={RATIONAL R_0=1.5 NN=6 MM=12} USEGPU MULTIGPU
c22: MATRIX_PRODUCT ARG=c2,c2 USEGPU MULTIGPU AVOID_THREAD_GATHER
diag: DIAGONALIZE ARG=c22 VECTORS=1
BIASVALUE ARG=diag.vals-1

PRINT ARG=s,diag.vals-1 FILE=colvar FMT=%10.5f
