type=driver
mpiprocs=2
arg="--plumed plumed.dat --ixyz trajectory.xyz --dump-forces forces --dump-forces-fmt=%10.5f"
extra_files="../../trajectories/trajectory.xyz"
# some contributions are computed in single precision on the GPU: the last printed digit may differ from the CPU
plumed_tolerance=(forces.0:1e-4 forces.1:1e-4 colvar:1e-4)
