LOAD FILE=../../../../plumedOpenACC.so
# With SERIAL only the first of the 2 processes computes the GPU actions, on its GPU, and
# sends the results to the other one.
# The CPU references come from regtest/adjmat/rt-nogather-serial-mpi
c1: CONTACT_MATRIX GROUPA=1-3 GROUPB=1-108 SWITCH={RATIONAL R_0=1 NN=6 MM=12 D_MAX=2} USEGPU SERIAL
ones: ONES SIZE=108
cc: MATRIX_VECTOR_PRODUCT ARG=c1,ones USEGPU SERIAL
mtc: MORE_THAN ARG=cc SWITCH={RATIONAL D_0=2 R_0=2} USEGPU SERIAL
s: SUM ARG=mtc PERIODIC=NO
BIASVALUE ARG=s

c2: CONTACT_MATRIX GROUP=1-20 SWITCH={RATIONAL R_0=1.5 NN=6 MM=12} USEGPU SERIAL
c22: MATRIX_PRODUCT ARG=c2,c2 USEGPU SERIAL
diag: DIAGONALIZE ARG=c22 VECTORS=1
BIASVALUE ARG=diag.vals-1

PRINT ARG=s,diag.vals-1 FILE=colvar FMT=%10.5f
