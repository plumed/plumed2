LOAD FILE=../../../../plumedOpenACC.so
MOLINFO STRUCTURE=amyloid.pdb
b1: ANTIBETARMSD RESIDUES=all STRANDS_CUTOFF=1 R_0=0.1 USEGPU
b3: ANTIBETARMSD RESIDUES=all STYLE=inter NOPBC STRANDS_CUTOFF=1.2 R_0=0.12 USEGPU
b5: ANTIBETARMSD RESIDUES=all STYLE=intra R_0=0.1 USEGPU
p1: PARABETARMSD RESIDUES=all STRANDS_CUTOFF=1 R_0=0.1 USEGPU
p3: PARABETARMSD RESIDUES=all STYLE=inter NOPBC R_0=0.1 USEGPU
p4: PARABETARMSD RESIDUES=all STRANDS_CUTOFF=1 LESS_THAN={RATIONAL R_0=0.1 NN=8 MM=12} USEGPU
RESTRAINT ARG=b1,b3,b5,p1,p3,p4.lessthan AT=0,0,0,0,0,0 KAPPA=1,2,3,4,5,6
PRINT ARG=b1,b3,b5,p1,p3,p4.lessthan FILE=colvar FMT=%10.6f
