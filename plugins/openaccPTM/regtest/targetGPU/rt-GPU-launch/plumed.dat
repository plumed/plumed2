LOAD FILE=../../../../plumedOpenACC.so
MOLINFO STRUCTURE=amyloid.pdb
b1: ANTIBETARMSD RESIDUES=all STRANDS_CUTOFF=1 R_0=0.1 USEGPU
d: DISTANCE ATOMS=1,20
a1: ALPHARMSD RESIDUES=all R_0=0.1 USEGPU
p1: PARABETARMSD RESIDUES=all STYLE=inter NOPBC R_0=0.1 STRANDS_CUTOFF=0 USEGPU
FIT_TO_TEMPLATE REFERENCE=amyloid.pdb TYPE=OPTIMAL
p2: PARABETARMSD RESIDUES=all STRANDS_CUTOFF=1 R_0=0.1 USEGPU
s: SAXS ATOMISTIC ATOMS=1-2520 QVALUE1=0.05 QVALUE2=0.15 QVALUE3=0.3 USEGPU
RESTRAINT ARG=b1,d,a1,p1,p2,s.q-1 AT=0,0,0,0,0,0 KAPPA=1,2,3,4,5,1000
PRINT ARG=b1,d,a1,p1,p2,(s\.q-.*) FILE=colvar FMT=%10.6f
