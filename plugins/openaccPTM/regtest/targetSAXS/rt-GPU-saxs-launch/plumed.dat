LOAD FILE=../../../../plumedOpenACC.so
MOLINFO STRUCTURE=protein.pdb
s1: SAXS USEGPU NOPBC ATOMS=1-3439 ONEBEAD TEMPLATE=protein.pdb QVALUE1=0.01 QVALUE2=0.07 QVALUE3=0.13 QVALUE4=0.19
d: DISTANCE ATOMS=1,3439
FIT_TO_TEMPLATE REFERENCE=protein.pdb TYPE=OPTIMAL
s2: SANS USEGPU NOPBC ATOMS=1-3439 ONEBEAD TEMPLATE=protein.pdb DEUTER_CONC=0.5 SOLVATION_CORRECTION=0.05 SOLVATION_STRIDE=1 SASA_CUTOFF=0.5 QVALUE1=0.01 QVALUE2=0.07 QVALUE3=0.13 QVALUE4=0.19
RESTRAINT ARG=s1.q-1,d,s2.q-2 AT=0,0,0 SLOPE=10,1,20
PRINT ARG=(s1\.q-.*),d,(s2\.q-.*) FILE=colvar FMT=%12.8f
