# The native build reads only these two restricted top-level YAML fields.
# Keep the grammar in sync with maketools/module-header.awk and module_header.py.
function(plumed_read_module declaration type_out use_out)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${declaration}")
  file(STRINGS "${declaration}" _lines REGEX "^[\"']?(type|use)[\"']?[ \t]*:")
  set(_nt 0)
  set(_nu 0)
  set(_use "")
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^type: (always|default-on|default-off)$")
      math(EXPR _nt "${_nt}+1")
      set(_type "${CMAKE_MATCH_1}")
    elseif(_line MATCHES "^use: \\[([a-z][a-z0-9_-]*(, [a-z][a-z0-9_-]*)*)?\\]$")
      math(EXPR _nu "${_nu}+1")
      set(_use "${CMAKE_MATCH_1}")
      string(REPLACE ", " ";" _use "${_use}")
    else()
      message(FATAL_ERROR "${declaration}: invalid type/use header syntax")
    endif()
  endforeach()
  if(NOT _nt EQUAL 1 OR NOT _nu EQUAL 1)
    message(FATAL_ERROR "${declaration}: exactly one type and use field required")
  endif()
  set(${type_out} "${_type}" PARENT_SCOPE)
  set(${use_out} "${_use}" PARENT_SCOPE)
endfunction()

# Fail explicitly for user modules that have not migrated their declarations.
function(plumed_check_obsolete_modules src_root)
  file(GLOB _obsolete "${src_root}/src/*/module.type")
  if(_obsolete)
    list(GET _obsolete 0 _declaration)
    message(FATAL_ERROR "${_declaration}: module.type is obsolete, use module.yml")
  endif()
endfunction()

# Only native build settings contribute to binary compatibility, not descriptions
# or packaging policy. Sorted paths also identify added/removed declarations.
function(plumed_module_headers src_root result)
  file(GLOB _declarations "${src_root}/src/*/module.yml")
  list(SORT _declarations)
  set(_headers "")
  foreach(_declaration IN LISTS _declarations)
    plumed_read_module("${_declaration}" _type _use)
    file(RELATIVE_PATH _relative "${src_root}" "${_declaration}")
    string(APPEND _headers ";${_relative}:${_type}:${_use}")
  endforeach()
  set(${result} "${_headers}" PARENT_SCOPE)
endfunction()

# Native USE is a graph, not a DAG (core/tools intentionally form a cycle).
# Resolve before library probing; check_only guards backend-specific removals.
function(plumed_resolve_modules src_root selected excluded check_only result)
  set(_queue ${selected})
  set(_resolved ${selected})
  set(_warnings)
  foreach(_mod IN LISTS selected)
    set(_path_${_mod} "${_mod}")
  endforeach()
  while(_queue)
    list(POP_FRONT _queue _mod)
    if(_mod IN_LIST excluded)
      message(FATAL_ERROR "PLUMED_MODULES: ${_path_${_mod}} is explicitly disabled")
    endif()
    plumed_read_module("${src_root}/src/${_mod}/module.yml" _type _use)
    foreach(_dep IN LISTS _use)
      if(_dep STREQUAL "config")
        continue()
      endif()
      set(_reason "${_path_${_mod}} -> ${_dep}")
      if(NOT EXISTS "${src_root}/src/${_dep}/module.yml")
        message(FATAL_ERROR "PLUMED_MODULES: ${_reason}: unknown module")
      endif()
      if(_dep IN_LIST excluded)
        message(FATAL_ERROR "PLUMED_MODULES: ${_reason}: required module ${_dep} is explicitly disabled")
      endif()
      if(NOT _dep IN_LIST _resolved)
        if(check_only)
          message(FATAL_ERROR "PLUMED_MODULES: ${_reason}: required module ${_dep} is unavailable after feature checks")
        endif()
        list(APPEND _resolved "${_dep}")
        list(APPEND _queue "${_dep}")
        set(_path_${_dep} "${_reason}")
        list(APPEND _warnings "enabling module ${_dep} required by ${_reason}")
      endif()
    endforeach()
  endwhile()
  foreach(_warning IN LISTS _warnings)
    message(WARNING "PLUMED_MODULES: ${_warning}")
  endforeach()
  list(REMOVE_DUPLICATES _resolved)
  list(SORT _resolved)
  set(${result} ${_resolved} PARENT_SCOPE)
endfunction()
