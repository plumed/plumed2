# Install rules for the CMake build of PLUMED.
#
# This mirrors the essential parts of `make install` from src/lib/Makefile
# for the static-kernel (non-dlopen) build produced by this CMake project:
#
#   <prefix>/bin/plumed.exe                      the main executable
#   <prefix>/lib/plumedKernel.lib                the static kernel
#   <prefix>/include/plumed/**                   all headers (rewritten includes)
#   <prefix>/lib/plumed/src/lib/Plumed.inc       link flags for MD engines (make)
#   <prefix>/lib/plumed/src/lib/Plumed.cmake     the same, as a CMake file
#   <prefix>/lib/plumed/patches|scripts|fortran  patches, scripts, fortran API
#   <prefix>/lib/pkgconfig/plumed.pc             pkg-config file
#
# Plumed.inc / Plumed.cmake follow the same format as the files generated by
# src/lib/Makefile (targets Plumed.inc.static / Plumed.cmake.static), with the
# absolute paths of the installed kernel.

# --- headers ---------------------------------------------------------------
# Copy every module header, rewriting "#include "module/x.h" to
# "#include "../module/x.h" exactly as src/maketools/install.headers does.
function(plumed_install_headers src_root dest)
  file(GLOB _headers "${src_root}/src/*/*.h" "${src_root}/src/*/*/*.h")
  foreach(_h IN LISTS _headers)
    file(RELATIVE_PATH _rel "${src_root}/src" "${_h}")
    set(_out "${dest}/${_rel}")
    get_filename_component(_outdir "${_out}" DIRECTORY)
    file(MAKE_DIRECTORY "${_outdir}")
    file(READ "${_h}" _text)
    string(REGEX REPLACE "#[ \t]*include[ \t]*\"([A-Za-z0-9_]+)/" "#include \"../\\1/" _text "${_text}")
    file(WRITE "${_out}" "${_text}")
  endforeach()
  list(LENGTH _headers _n)
  message(STATUS "  headers: ${_n} files")
endfunction()

# --- Plumed.inc / Plumed.cmake ---------------------------------------------
# Same content as the Plumed.inc.static / Plumed.cmake.static targets in
# src/lib/Makefile, but pointing at the installed kernel archive.
function(plumed_write_link_files kernel_file libdir program_name out_dir src_root)
  file(TO_CMAKE_PATH "${kernel_file}" _kernel)
  file(TO_CMAKE_PATH "${src_root}" _srcroot)
  set(_inc "# PLUMED: static installation\n")
  string(APPEND _inc "PLUMED_STATIC_LOAD=${_kernel}\n")
  string(APPEND _inc "PLUMED_STATIC_DEPENDENCIES=${_kernel}\n")
  string(APPEND _inc "PLUMED_FORTRAN=${_srcroot}/fortran/plumed.f90\n")
  file(WRITE "${out_dir}/Plumed.inc" "${_inc}")
  # inc2cmake: turn "KEY=value" lines into set(KEY value)
  set(_cm "# PLUMED: static installation\n")
  string(APPEND _cm "# Generated from Plumed.inc by the CMake build (inc2cmake).\n")
  string(REPLACE "\n" ";" _lines "${_inc}")
  foreach(_l IN LISTS _lines)
    if(_l MATCHES "^([A-Z0-9_]+)=(.*)$")
      string(APPEND _cm "set(${CMAKE_MATCH_1} ${CMAKE_MATCH_2})\n")
    endif()
  endforeach()
  file(WRITE "${out_dir}/Plumed.cmake" "${_cm}")
endfunction()

# --- pkg-config file --------------------------------------------------------
function(plumed_write_pkgconfig program_name prefix includedir libdir version out_file)
  set(_pc "prefix=${prefix}\n")
  string(APPEND _pc "exec_prefix=${prefix}\n")
  string(APPEND _pc "includedir=${includedir}\n")
  string(APPEND _pc "libdir=${libdir}\n")
  string(APPEND _pc "\n")
  string(APPEND _pc "Name: ${program_name}\n")
  string(APPEND _pc "Description: Plumed library (static installation)\n")
  string(APPEND _pc "URL: http://www.plumed.org\n")
  string(APPEND _pc "Version: ${version}\n")
  string(APPEND _pc "Cflags: -I\${includedir}\n")
  string(APPEND _pc "Libs: -L\${libdir} -l${program_name}Kernel\n")
  file(WRITE "${out_file}" "${_pc}")
endfunction()
