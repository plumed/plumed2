# Generated by extensions/conda_recipe.py from meta.yaml.in and module conda.mk files.
{% set name = "plumed" %}
{% set version = environ['VERSION'] %}
{% set build_number = environ.get('PLUMED_CONDA_BUILD_NUMBER', '0') | int %}

package:
  name: {{ name|lower }}
  version: {{ version }}

source:
  path: ../..

build:
  number: {{ build_number }}
  skip: True  # [win]
  # dyld can resolve a hardlinked executable through the package-cache path.
  no_link:  # [osx]
    - bin/plumed  # [osx]
# Most programs should link libplumedWrapper.a so that libplumedKernel.so will be loaded
# with dlopen. There is no need for pinning thus.
# Programs linking libplumed.so should pin to min_pin='x.x', max_pin='x'.
# Programs linking libplumedKernel.so should pin to min_pin='x.x.x'. max_pin='x.x.x'.

requirements:
  build:
    - {{ compiler('c') }}
    - {{ compiler('cxx') }}
    - {{ stdlib('c') }}  # [linux]
    - llvm-openmp  # [osx]
    - make
    - python
@MODULE_BUILD_REQUIREMENTS@  host:
@MODULE_HOST_REQUIREMENTS@    - llvm-openmp  # [osx]
  run:
@MODULE_RUN_REQUIREMENTS@    - gawk
    - llvm-openmp  # [osx]

test:
  commands:
    - plumed info --root
    - plumed info --long-version
    - plumed --has-thread-mpi
    - "! plumed config has real_mpi"
    - test ! -f "$PREFIX/lib/libplumed-mpi-provider$SHLIB_EXT"
    - plumed-patch -h
    - plumed config has external_blas external_lapack fftw zlib libhdf5 libchemfiles
    - $PREFIX/lib/plumed/plumed-runtime -h
    - test -f $PREFIX/lib/libplumed$SHLIB_EXT
    - test -f $PREFIX/lib/libplumedWrapper.a
    - test -f $PREFIX/lib/libplumedKernel$SHLIB_EXT
    - test -f "$PREFIX/share/bash-completion/completions/plumed"
    - test -f "$PREFIX/lib/plumed/vim/syntax/plumed.vim"
    - test -f "$PREFIX/lib/plumed/vim/autoload/plumed.vim"
    - test -f "$PREFIX/lib/plumed/conda-source.json"
    - conda inspect linkages -p $PREFIX $PKG_NAME
    - conda inspect objects -p $PREFIX $PKG_NAME  # [osx]

about:
  home: http://www.plumed.org/
  license: LGPL-3.0
  license_family: GPL
  license_file: COPYING.LESSER
  summary: 'Free energy calculations in molecular systems'
  description: |
    PLUMED is an open source library for free energy calculations in
    molecular systems which works together with some of the most
    popular molecular dynamics engines.
  doc_url: https://www.plumed.org/doc
  dev_url: https://github.com/plumed/plumed2

extra:
  recipe-maintainers:
    - GiovanniBussi
