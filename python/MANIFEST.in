include PLUMED_VERSION
include include/Plumed.h
include plumed.c
include plumed.pyx
include cplumed.pxd
include LICENSE
include build_backend.py
include build_dependencies.py
#this should be refined
include test/*
recursive-include plumed *
# In-tree extension builds must not leak binaries into source distributions.
exclude plumed/*.so plumed/*.pyd
recursive-include plumed_source *
# a link to ../ (see build_backend.py)
prune plumed_source/src/include
global-exclude __pycache__/* *.py[cod]
