plumed_modules=funnel
mpiprocs=1
type=driver
arg="--plumed plumed.dat --mf_trr small.trr --pdb start.pdb --dump-forces forces --dump-forces-fmt=%10.4f"

plumed_regtest_after() {
  # Preserve the full-precision output for diagnosis; normalize only the test
  # comparison copies, including the temporary reference made by the runner.
  cp BIAS BIAS.raw || return 1
  ./normalize-funnel-bias.sh BIAS || return 1
  ./normalize-funnel-bias.sh BIAS.reference
}
