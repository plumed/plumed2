hh_phi: READ IGNORE_TIME IGNORE_COMPONENT VALUES=phi FILE=HILLS
hh_psi_x: READ IGNORE_TIME IGNORE_COMPONENT VALUES=psi.x FILE=HILLS
hh_sigma_phi: READ IGNORE_TIME IGNORE_COMPONENT VALUES=sigma_phi FILE=HILLS
hh_sigma_psi_x: READ IGNORE_TIME IGNORE_COMPONENT VALUES=sigma_psi.x FILE=HILLS
hh_height: READ IGNORE_TIME IGNORE_COMPONENT VALUES=height FILE=HILLS

hh_inst: KDE ARG=hh_phi,hh_psi_x BANDWIDTH=hh_sigma_phi,hh_sigma_psi_x HEIGHTS=hh_height GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=20,20 KERNEL={GAUSSIAN D_MAX=3.53553}
hh_bias: ACCUMULATE ARG=hh_inst STRIDE=1
hh: CUSTOM ARG=hh_bias FUNC=-x PERIODIC=NO

DUMPGRID ARG=hh FILE=fes.dat FMT=%8.4f
