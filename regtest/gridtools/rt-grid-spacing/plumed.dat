g1: REFERENCE_GRID GRID_MIN=0 GRID_MAX=10 GRID_SPACING=0.5 FUNC=x*x VAR=x PERIODIC=NO
g2: REFERENCE_GRID GRID_MIN=0 GRID_MAX=10 GRID_SPACING=0.3 FUNC=x*x VAR=x PERIODIC=NO
DUMPGRID ARG=g1 FILE=grid1 FMT=%8.4f
DUMPGRID ARG=g2 FILE=grid2 FMT=%8.4f
x: DISTANCE ATOMS=1,2
hA1: HISTOGRAM ARG=x GRID_MIN=0.0 GRID_MAX=3.0 GRID_BIN=100 BANDWIDTH=0.1
ii: INTERPOLATE_GRID ARG=hA1 GRID_SPACING=0.05 INTERPOLATION_TYPE=floor
DUMPGRID ARG=ii FILE=interp FMT=%8.4f
