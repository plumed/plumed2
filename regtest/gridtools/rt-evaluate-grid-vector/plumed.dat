ff: REFERENCE_GRID FILE=kde.grid VALUE=h
aa: ANGLE ATOMS1=1,2,3 ATOMS2=4,5,6 ATOMS3=7,8,9
tt: TORSION ATOMS1=1,2,3,4 ATOMS2=5,6,7,8 ATOMS3=9,10,11,12
val: EVALUATE_FUNCTION_FROM_GRID GRID=ff
a1: ANGLE ATOMS=1,2,3
t1: TORSION ATOMS=1,2,3,4
v1: EVALUATE_FUNCTION_FROM_GRID GRID=ff ARG=a1,t1
a2: ANGLE ATOMS=4,5,6
t2: TORSION ATOMS=5,6,7,8
v2: EVALUATE_FUNCTION_FROM_GRID GRID=ff ARG=a2,t2
a3: ANGLE ATOMS=7,8,9
t3: TORSION ATOMS=9,10,11,12
v3: EVALUATE_FUNCTION_FROM_GRID GRID=ff ARG=a3,t3
s: SUM ARG=val PERIODIC=NO
PRINT ARG=val,v1,v2,v3 FILE=colvar FMT=%8.4f
BIASVALUE ARG=s
