# 24 atoms: 1-20 close to each other, 21-24 far from the others (empty rows and columns)
c: CONTACT_MATRIX GROUP=1-24 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6}
a: CONTACT_MATRIX GROUPA=1-6,21 GROUPB=7-24 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6}
b: CONTACT_MATRIX GROUPA=7-24 GROUPB=1-10,22 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6}
d: DISTANCE_MATRIX GROUPA=1-6,21 GROUPB=7-24
d2: DISTANCE_MATRIX GROUPA=7-24 GROUPB=1-5
# sparse x sparse (square), sparse x sparse, sparse x dense, dense x sparse
p1: MATRIX_PRODUCT ARG=c,c
p2: MATRIX_PRODUCT ARG=a,b
p3: MATRIX_PRODUCT ARG=a,d2
p4: MATRIX_PRODUCT ARG=d,b
# the same with AVOID_THREAD_GATHER
q1: MATRIX_PRODUCT ARG=c,c AVOID_THREAD_GATHER
q2: MATRIX_PRODUCT ARG=a,b AVOID_THREAD_GATHER
q3: MATRIX_PRODUCT ARG=a,d2 AVOID_THREAD_GATHER
q4: MATRIX_PRODUCT ARG=d,b AVOID_THREAD_GATHER
s1: SUM ARG=p1 PERIODIC=NO
s2: SUM ARG=p2 PERIODIC=NO
s3: SUM ARG=p3 PERIODIC=NO
s4: SUM ARG=p4 PERIODIC=NO
t1: SUM ARG=q1 PERIODIC=NO
t2: SUM ARG=q2 PERIODIC=NO
t3: SUM ARG=q3 PERIODIC=NO
t4: SUM ARG=q4 PERIODIC=NO
# different weights, so that wrong forces of two products do not cancel
b1: RESTRAINT ARG=s1,s2,s3,s4 AT=0,0,0,0 KAPPA=0.1,0.2,0.3,0.4
b2: RESTRAINT ARG=t1,t2,t3,t4 AT=0,0,0,0 KAPPA=0.5,0.6,0.7,0.8
PRINT ARG=s1,s2,s3,s4,t1,t2,t3,t4 FILE=colvar FMT=%8.4f
