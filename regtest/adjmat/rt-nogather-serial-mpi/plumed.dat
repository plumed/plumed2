# AVOID_THREAD_GATHER gathers the forces in two passes that are not combined across MPI
# processes: with more than one process it is allowed together with SERIAL, so that every
# process computes the whole action (AdjacencyMatrixBase and MatrixTimesMatrix here).
c1: CONTACT_MATRIX GROUPA=1-3 GROUPB=1-108 SWITCH={RATIONAL R_0=1 NN=6 MM=12 D_MAX=2} AVOID_THREAD_GATHER SERIAL
ones: ONES SIZE=108
cc: MATRIX_VECTOR_PRODUCT ARG=c1,ones
mtc: MORE_THAN ARG=cc SWITCH={RATIONAL D_0=2 R_0=2}
s: SUM ARG=mtc PERIODIC=NO
BIASVALUE ARG=s

c2: CONTACT_MATRIX GROUP=1-20 SWITCH={RATIONAL R_0=1.5 NN=6 MM=12}
c22: MATRIX_PRODUCT ARG=c2,c2 AVOID_THREAD_GATHER SERIAL
diag: DIAGONALIZE ARG=c22 VECTORS=1
BIASVALUE ARG=diag.vals-1

PRINT ARG=s,diag.vals-1 FILE=colvar FMT=%10.5f
