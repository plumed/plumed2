# GROUP and GROUPA=GROUPB give the same matrix, with one SWITCH or with SWITCHA and SWITCHB
g: BRIDGE_MATRIX GROUP=95-104 BRIDGING_ATOMS=1-94 SWITCH={RATIONAL R_0=0.6}
ab: BRIDGE_MATRIX GROUPA=95-104 GROUPB=95-104 BRIDGING_ATOMS=1-94 SWITCH={RATIONAL R_0=0.6}
g2: BRIDGE_MATRIX GROUP=95-104 BRIDGING_ATOMS=1-94 SWITCHA={RATIONAL R_0=0.6} SWITCHB={RATIONAL R_0=0.8}
ab2: BRIDGE_MATRIX GROUPA=95-104 GROUPB=95-104 BRIDGING_ATOMS=1-94 SWITCHA={RATIONAL R_0=0.6} SWITCHB={RATIONAL R_0=0.8}
ones: ONES SIZE=10
gs: MATRIX_VECTOR_PRODUCT ARG=g,ones
abs: MATRIX_VECTOR_PRODUCT ARG=ab,ones
g2s: MATRIX_VECTOR_PRODUCT ARG=g2,ones
ab2s: MATRIX_VECTOR_PRODUCT ARG=ab2,ones
s: SUM ARG=gs PERIODIC=NO
sab: SUM ARG=abs PERIODIC=NO
s2: SUM ARG=g2s PERIODIC=NO
sab2: SUM ARG=ab2s PERIODIC=NO
# s equal to sab and s2 equal to sab2
PRINT ARG=s,sab,s2,sab2 FILE=colvar FMT=%8.4f
BIASVALUE ARG=s,s2
