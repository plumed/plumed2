UNITS LENGTH=A TIME=fs ENERGY=eV
mp: CONTACT_MATRIX GROUPA=1,2,3,4,9,10,11,12 GROUPB=5,6,7,8,13,14,15,16,21,22,23,24,29,30,31,32 SWITCH={CUSTOM FUNC=1/(1+exp((x-2.3)/0.2)) R_0=1 D_MAX=3.0 NOSTRETCH}
op: ONES SIZE=16
p: MATRIX_VECTOR_PRODUCT ARG=mp,op
mq: CONTACT_MATRIX GROUP=1,2,3,4,9,10,11,12 SWITCH={CUSTOM FUNC=1/(1+exp((x-2.4)/0.2)) R_0=1 D_MAX=3.0 NOSTRETCH}
oq: ONES SIZE=8
q: MATRIX_VECTOR_PRODUCT ARG=mq,oq
xi: CUSTOM ARG=p,q VAR=p,q FUNC=p+q PERIODIC=NO
s: SUM ARG=xi PERIODIC=NO
bv: BIASVALUE ARG=s
PRINT FILE=colvar ARG=s FMT=%8.4f 
