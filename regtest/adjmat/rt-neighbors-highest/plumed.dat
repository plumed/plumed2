dmat: DISTANCE_MATRIX GROUPA=1-5 GROUPB=6-30
idmat: CUSTOM ARG=dmat FUNC=1/x PERIODIC=NO
# NHIGHEST on 1/d must select the same neighbors as NLOWEST on d
l1: NEIGHBORS ARG=dmat NLOWEST=1
h1: NEIGHBORS ARG=idmat NHIGHEST=1
l3: NEIGHBORS ARG=dmat NLOWEST=3
h3: NEIGHBORS ARG=idmat NHIGHEST=3
# the selected neighbors of each row are identified by the sum of 2^j over the selected columns j
w: CONSTANT VALUES=1,2,4,8,16,32,64,128,256,512,1024,2048,4096,8192,16384,32768,65536,131072,262144,524288,1048576,2097152,4194304,8388608,16777216
vl1: MATRIX_VECTOR_PRODUCT ARG=l1,w
vh1: MATRIX_VECTOR_PRODUCT ARG=h1,w
vl3: MATRIX_VECTOR_PRODUCT ARG=l3,w
vh3: MATRIX_VECTOR_PRODUCT ARG=h3,w
d: CUSTOM ARG=vl1,vh1,vl3,vh3 VAR=a1,b1,a3,b3 FUNC=abs(a1-b1)+abs(a3-b3) PERIODIC=NO
diff: SUM ARG=d PERIODIC=NO
s1: SUM ARG=vh1 PERIODIC=NO
s3: SUM ARG=vh3 PERIODIC=NO
PRINT ARG=s1,s3,diff FILE=colvar FMT=%12.1f
