c: COORDINATION GROUPA=1-300 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6}
m: CONTACT_MATRIX GROUP=1-300 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6}
s: SUM ARG=m PERIODIC=NO
e: COORDINATION GROUPA=1-100 GROUPB=101-300 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6}
n: CONTACT_MATRIX GROUPA=1-100 GROUPB=101-300 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6}
t: SUM ARG=n PERIODIC=NO
ds: CUSTOM ARG=c,s FUNC=step(1e-8-abs(y-2*x)) PERIODIC=NO
dt: CUSTOM ARG=e,t FUNC=step(1e-8-abs(y-x)) PERIODIC=NO
PRINT ARG=s,t FILE=colvar FMT=%10.4f
PRINT ARG=ds,dt FILE=same FMT=%3.1f
RESTRAINT ARG=s,t AT=0,0 KAPPA=0.01,0.02
