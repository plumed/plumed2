type=driver
plumed_modules=adjmat
# The link cells of CONTACT_MATRIX take the periodic image of an atom from its cell
# when the box is at least three cutoffs wide: the result must be the same as COORDINATION.
# Frames: rhombic dodecahedron, orthorhombic, skewed, and a box with fewer than
# three cells per direction (minimum image distances are used there).
# One atom out of three is in another periodic image
arg="--plumed plumed.dat --ixyz trajectory.xyz --dump-forces forces --dump-forces-fmt=%8.3f"
