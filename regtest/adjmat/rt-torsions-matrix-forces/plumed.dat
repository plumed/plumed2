d: DISTANCES ATOMS1=1,2 ATOMS2=3,4 ATOMS3=5,6 ATOMS4=7,8 ATOMS5=21,22 LOCATION1=1 LOCATION2=3 LOCATION3=5 LOCATION4=7 LOCATION5=21 COMPONENTS
v: VSTACK ARG=d.x,d.y,d.z
vt: TRANSPOSE ARG=v
# all the pairs, with the diagonal
tm1: TORSIONS_MATRIX ARG=v,vt POSITIONS1=d POSITIONS2=d
w1: CUSTOM ARG=tm1 FUNC=cos(x) PERIODIC=NO
s1: SUM ARG=w1 PERIODIC=NO
# the same with AVOID_THREAD_GATHER
tm2: TORSIONS_MATRIX ARG=v,vt POSITIONS1=d POSITIONS2=d AVOID_THREAD_GATHER
w2: CUSTOM ARG=tm2 FUNC=cos(x) PERIODIC=NO
s2: SUM ARG=w2 PERIODIC=NO
# only the pairs in contact, with AVOID_THREAD_GATHER
c: CONTACT_MATRIX GROUP=d SWITCH={RATIONAL R_0=0.3 D_MAX=0.6}
tm3: TORSIONS_MATRIX ARG=v,vt POSITIONS1=d POSITIONS2=d MASK=c AVOID_THREAD_GATHER
w3: CUSTOM ARG=tm3,c FUNC=cos(x)*y PERIODIC=NO
s3: SUM ARG=w3 PERIODIC=NO
RESTRAINT ARG=s1,s2,s3 AT=0,0,0 KAPPA=0.1,0.2,0.3
PRINT ARG=s1,s2,s3 FILE=colvar FMT=%8.4f
