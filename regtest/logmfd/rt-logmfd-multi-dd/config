plumed_modules=logmfd
mpiprocs=4
type=driver
# Two replicas with two ranks each, under a fake domain decomposition (#1480).
# Replica 1 reads traj.1.xyz, so the replicas see different CVs.
arg="--plumed plumed.dat --ixyz traj.xyz --multi 2 --debug-dd yes --dump-forces forces --dump-forces-fmt %10.5f"

# The expected output is the same run with one rank per replica, made here rather than stored.
# Before #1480 the second rank of each replica stopped with "cannot understand ... WORK", and,
# past that, it skipped the averages over the replicas and evolved different fictitious variables.
function plumed_regtest_before() {
  ${mpi% -np *} -np 2 $valgrind $plumed driver --plumed plumed.dat --ixyz traj.xyz --multi 2 \
    --dump-forces forces --dump-forces-fmt %10.5f > out_nodd 2> err_nodd || return 1
  mv logmfd.out nodd_logmfd.out || return 1
  for r in 0 1; do
    mv colvar.$r nodd_colvar.$r && mv forces.$r nodd_forces.$r || return 1
  done
}

# Under --debug-dd the force files are per rank: forces.0 and forces.1 are replica 0, forces.2 and
# forces.3 replica 1. replica.out is not compared: both replicas write it in this directory.
function plumed_regtest_after() {
  same() { cmp -s "$1" "$2" && echo same || echo DIFFERENT; }
  nonzero() { awk '$1=="X"{for(i=2;i<=4;i++) if($i+0!=0) n++} END{print (n>0)?"yes":"no"}' "$1"; }
  {
    for k in 0 1 2 3; do
      echo "replica $((k/2)) rank $((k%2)) forces: $(same forces.$k nodd_forces.$((k/2)))"
    done
    for r in 0 1; do
      echo "replica $r colvar: $(same colvar.$r nodd_colvar.$r)"
    done
    echo "logmfd.out: $(same logmfd.out nodd_logmfd.out)"
    # Guard against a vacuous pass.
    echo "forces are non-zero: $(nonzero nodd_forces.0)"
    echo "replicas get different forces: $(cmp -s nodd_forces.0 nodd_forces.1 && echo no || echo yes)"
    echo "fictitious variables move: $(awk '$1!="#!"{if(n==0)f=$4; l=$4; n++} END{print (f!=l)?"yes":"no"}' nodd_colvar.0)"
    echo "replicas share the fictitious variables: $(awk '$1!="#!"{print $4,$5}' nodd_colvar.0 | cmp -s - <(awk '$1!="#!"{print $4,$5}' nodd_colvar.1) && echo yes || echo no)"
  } > dd_vs_nodd
}
