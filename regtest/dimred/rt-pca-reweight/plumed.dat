# PCA of frames collected without CLEAR and with weights that are different at each frame:
# the logsumexp of the weights is calculated also when no frame has been collected yet
d1: DISTANCE ATOMS=1,2
d2: DISTANCE ATOMS=1,3
d3: DISTANCE ATOMS=1,4
d4: DISTANCE ATOMS=2,3
rr: RESTRAINT ARG=d1 AT=0.1 KAPPA=10
rbias: REWEIGHT_BIAS TEMP=300

ff: COLLECT_FRAMES ARG=d1,d2,d3,d4 LOGWEIGHTS=rbias STRIDE=5
pca: PCA ARG=ff NLOW_DIM=2 FILE=pca-comp.pdb
# FILE is optional
pcb: PCA ARG=ff NLOW_DIM=2
# dumped at the first step, when only one frame has been collected, and at the end
DUMPVECTOR ARG=pca_weights FILE=colvar_first FMT=%8.4f STRIDE=1000
DUMPVECTOR ARG=pca_weights,pcb_weights FILE=colvar FMT=%8.4f STRIDE=0
