# no GPU: AUTO uses the CPU (the GPUs are hidden in config)
# c*: the CPU backend (independent evaluation), g*: the GPU backend
c0: VORONOI_COORDINATION CENTERS=1,2,3,4 ASSIGNED=5,6,7,8,9,10 REFERENCE=1.5,1.2,1.1,2.2 KAPPA=5 POWER=1 NO_SHARE
