# Atom-list shortcuts must resolve selections before enumerating atoms.
MOLINFO STRUCTURE=ref.pdb
g: GROUP ATOMS=1-4
g2: GROUP ATOMS=5-8
s: GROUP ATOMS=1,2
e: GROUP ATOMS=5,6
wp: POSITION ATOMS=1-4 NOPBC
w: CUSTOM ARG=wp.x FUNC=exp(x) PERIODIC=NO

# NEMATIC_ORDER explicit
a0: NEMATIC_ORDER MOLECULE_STARTS=1-4 MOLECULE_ENDS=5-8

# FERRONEMATIC_ORDER explicit
a1: FERRONEMATIC_ORDER MOLECULE_STARTS=1-4 MOLECULE_ENDS=5-8

# NEMATIC_ORDER named
a2: NEMATIC_ORDER MOLECULE_STARTS=g MOLECULE_ENDS=g2

d2_0: CUSTOM ARG=a0,a2 FUNC=x-y PERIODIC=NO

# FERRONEMATIC_ORDER named
a3: FERRONEMATIC_ORDER MOLECULE_STARTS=g MOLECULE_ENDS=g2

d3_0: CUSTOM ARG=a1,a3 FUNC=x-y PERIODIC=NO

# NEMATIC_ORDER molinfo
a4: NEMATIC_ORDER MOLECULE_STARTS=@back-1 MOLECULE_ENDS=@back-2

d4_0: CUSTOM ARG=a0,a4 FUNC=x-y PERIODIC=NO

# FERRONEMATIC_ORDER molinfo
a5: FERRONEMATIC_ORDER MOLECULE_STARTS=@back-1 MOLECULE_ENDS=@back-2

d5_0: CUSTOM ARG=a1,a5 FUNC=x-y PERIODIC=NO

# NEMATIC_ORDER ndx
a6: NEMATIC_ORDER MOLECULE_STARTS={@ndx:{index.ndx first}} MOLECULE_ENDS={@ndx:{index.ndx second}}

d6_0: CUSTOM ARG=a0,a6 FUNC=x-y PERIODIC=NO

# FERRONEMATIC_ORDER ndx
a7: FERRONEMATIC_ORDER MOLECULE_STARTS={@ndx:{index.ndx first}} MOLECULE_ENDS={@ndx:{index.ndx second}}

d7_0: CUSTOM ARG=a1,a7 FUNC=x-y PERIODIC=NO

BIASVALUE ARG=d2_0,d3_0,d4_0,d5_0,d6_0,d7_0

PRINT ARG=a0,a1,a2,a3,a4,a5,a6,a7,d2_0,d3_0,d4_0,d5_0,d6_0,d7_0 FILE=colvar FMT=%12.8f
