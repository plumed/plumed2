type=driver
mpiprocs=2
plumed_modules=maze
extra_files="../traj/trajectory.gro"
arg="--plumed plumed.dat --timestep 1 --igro traj.gro --multi 2 --debug-grex 2"
function plumed_regtest_before() {
  cp trajectory.gro traj.0.gro
  cp trajectory.gro traj.1.gro
  mkdir noexchange
  (cd noexchange; cp ../plumed.dat ../traj.0.gro ../traj.1.gro .; $mpi $plumed driver --plumed plumed.dat --timestep 1 --igro traj.gro --multi 2 > out 2> err)
}
function plumed_regtest_after() {
  {
    for r in 0 1; do
      if cmp -s colvar.$r noexchange/colvar.$r; then echo "colvar.$r IDENTICAL"; else echo "colvar.$r DIFFERENT"; fi
    done
  } > comparison
}
