# several atoms in VECTOREND
i1: INPLANEDISTANCES VECTORSTART=1 VECTOREND=2,3 GROUP=4-10 SUM
j12: INPLANEDISTANCES VECTORSTART=1 VECTOREND=2 GROUP=4-10 SUM
j13: INPLANEDISTANCES VECTORSTART=1 VECTOREND=3 GROUP=4-10 SUM
check1: COMBINE ARG=j12_sum,j13_sum PERIODIC=NO

# several atoms in VECTORSTART
i2: INPLANEDISTANCES VECTORSTART=1,4 VECTOREND=2 GROUP=5-10 SUM
k1: INPLANEDISTANCES VECTORSTART=1 VECTOREND=2 GROUP=5-10 SUM
k4: INPLANEDISTANCES VECTORSTART=4 VECTOREND=2 GROUP=5-10 SUM
check2: COMBINE ARG=k1_sum,k4_sum PERIODIC=NO

PRINT ARG=i1_sum,check1,i2_sum,check2 FILE=colvar FMT=%9.5f
BIASVALUE ARG=i1_sum
BIASVALUE ARG=i2_sum
