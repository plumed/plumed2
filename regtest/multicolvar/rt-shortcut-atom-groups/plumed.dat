# Atom-list shortcuts must resolve selections before enumerating atoms.
MOLINFO STRUCTURE=ref.pdb
g: GROUP ATOMS=1-4
g2: GROUP ATOMS=5-8
s: GROUP ATOMS=1,2
e: GROUP ATOMS=5,6
wp: POSITION ATOMS=1-4 NOPBC
w: CUSTOM ARG=wp.x FUNC=exp(x) PERIODIC=NO

# DISTANCES explicit
a0: DISTANCES GROUPA=9 GROUPB=1-4 MEAN

# XDISTANCES explicit
a1: XDISTANCES GROUPA=9 GROUPB=1-4 MEAN

# YDISTANCES explicit
a2: YDISTANCES GROUPA=9 GROUPB=1-4 MEAN

# ZDISTANCES explicit
a3: ZDISTANCES GROUPA=9 GROUPB=1-4 MEAN

# DISTANCES_GROUP explicit
a4: DISTANCES GROUP=1-4 MEAN

# DISTANCES_ORIGIN explicit
a5: DISTANCES ORIGIN=9 ATOMS=1-4 MEAN

# ANGLES explicit
a6: ANGLES GROUP=1-4 MEAN

# ANGLES_AB explicit
a7: ANGLES GROUPA=9 GROUPB=1-4 MEAN

# ANGLES_ABC explicit
a8: ANGLES GROUPA=9 GROUPB=1-4 GROUPC=10 MEAN

# ANGLES_SWITCH explicit
a9: ANGLES GROUPA=9 GROUPB=1-4 SWITCH={RATIONAL R_0=1.0} MEAN

# COORD_ANGLES explicit
a10: COORD_ANGLES CATOMS=9 GROUP=1-4 SWITCH={RATIONAL R_0=1.0} MEAN

# INPLANEDISTANCES explicit
a11: INPLANEDISTANCES VECTORSTART=9 VECTOREND=10 GROUP=1-4 MEAN

# GYRATION_fast explicit
a12: GYRATION ATOMS=1-4

# GYRATION_weighted_shortcut explicit
a13: GYRATION ATOMS=1-4 WEIGHTS=w

# GYRATION_TENSOR explicit
a14: GYRATION_TENSOR ATOMS=1-4 WEIGHTS=w

# CENTER_fast explicit
a15_c: CENTER ATOMS=1-4
a15: POSITION ATOM=a15_c NOPBC

# CENTER_weighted_shortcut explicit
a16_c: CENTER ATOMS=1-4 WEIGHTS=w
a16: POSITION ATOM=a16_c NOPBC

# DISTANCES named
a17: DISTANCES GROUPA=9 GROUPB=g MEAN

d17_0: CUSTOM ARG=a0.mean,a17.mean FUNC=x-y PERIODIC=NO

# XDISTANCES named
a18: XDISTANCES GROUPA=9 GROUPB=g MEAN

d18_0: CUSTOM ARG=a1.mean,a18.mean FUNC=x-y PERIODIC=NO

# YDISTANCES named
a19: YDISTANCES GROUPA=9 GROUPB=g MEAN

d19_0: CUSTOM ARG=a2.mean,a19.mean FUNC=x-y PERIODIC=NO

# ZDISTANCES named
a20: ZDISTANCES GROUPA=9 GROUPB=g MEAN

d20_0: CUSTOM ARG=a3.mean,a20.mean FUNC=x-y PERIODIC=NO

# DISTANCES_GROUP named
a21: DISTANCES GROUP=g MEAN

d21_0: CUSTOM ARG=a4.mean,a21.mean FUNC=x-y PERIODIC=NO

# DISTANCES_ORIGIN named
a22: DISTANCES ORIGIN=9 ATOMS=g MEAN

d22_0: CUSTOM ARG=a5.mean,a22.mean FUNC=x-y PERIODIC=NO

# ANGLES named
a23: ANGLES GROUP=g MEAN

d23_0: CUSTOM ARG=a6.mean,a23.mean FUNC=x-y PERIODIC=NO

# ANGLES_AB named
a24: ANGLES GROUPA=9 GROUPB=g MEAN

d24_0: CUSTOM ARG=a7.mean,a24.mean FUNC=x-y PERIODIC=NO

# ANGLES_ABC named
a25: ANGLES GROUPA=9 GROUPB=g GROUPC=10 MEAN

d25_0: CUSTOM ARG=a8.mean,a25.mean FUNC=x-y PERIODIC=NO

# ANGLES_SWITCH named
a26: ANGLES GROUPA=9 GROUPB=g SWITCH={RATIONAL R_0=1.0} MEAN

d26_0: CUSTOM ARG=a9.mean,a26.mean FUNC=x-y PERIODIC=NO

# COORD_ANGLES named
a27: COORD_ANGLES CATOMS=9 GROUP=g SWITCH={RATIONAL R_0=1.0} MEAN

d27_0: CUSTOM ARG=a10.mean,a27.mean FUNC=x-y PERIODIC=NO

# INPLANEDISTANCES named
a28: INPLANEDISTANCES VECTORSTART=9 VECTOREND=10 GROUP=g MEAN

d28_0: CUSTOM ARG=a11.mean,a28.mean FUNC=x-y PERIODIC=NO

# GYRATION_fast named
a29: GYRATION ATOMS=g

d29_0: CUSTOM ARG=a12,a29 FUNC=x-y PERIODIC=NO

# GYRATION_weighted_shortcut named
a30: GYRATION ATOMS=g WEIGHTS=w

d30_0: CUSTOM ARG=a13,a30 FUNC=x-y PERIODIC=NO

# GYRATION_TENSOR named
a31: GYRATION_TENSOR ATOMS=g WEIGHTS=w

d31_0: CUSTOM ARG=a14,a31 FUNC=x-y PERIODIC=NO

d31_0_sum: SUM ARG=d31_0 PERIODIC=NO

# CENTER_fast named
a32_c: CENTER ATOMS=g
a32: POSITION ATOM=a32_c NOPBC

d32_0: CUSTOM ARG=a15.x,a32.x FUNC=x-y PERIODIC=NO

d32_1: CUSTOM ARG=a15.y,a32.y FUNC=x-y PERIODIC=NO

d32_2: CUSTOM ARG=a15.z,a32.z FUNC=x-y PERIODIC=NO

# CENTER_weighted_shortcut named
a33_c: CENTER ATOMS=g WEIGHTS=w
a33: POSITION ATOM=a33_c NOPBC

d33_0: CUSTOM ARG=a16.x,a33.x FUNC=x-y PERIODIC=NO

d33_1: CUSTOM ARG=a16.y,a33.y FUNC=x-y PERIODIC=NO

d33_2: CUSTOM ARG=a16.z,a33.z FUNC=x-y PERIODIC=NO

# DISTANCES molinfo
a34: DISTANCES GROUPA=9 GROUPB=@back-1 MEAN

d34_0: CUSTOM ARG=a0.mean,a34.mean FUNC=x-y PERIODIC=NO

# XDISTANCES molinfo
a35: XDISTANCES GROUPA=9 GROUPB=@back-1 MEAN

d35_0: CUSTOM ARG=a1.mean,a35.mean FUNC=x-y PERIODIC=NO

# YDISTANCES molinfo
a36: YDISTANCES GROUPA=9 GROUPB=@back-1 MEAN

d36_0: CUSTOM ARG=a2.mean,a36.mean FUNC=x-y PERIODIC=NO

# ZDISTANCES molinfo
a37: ZDISTANCES GROUPA=9 GROUPB=@back-1 MEAN

d37_0: CUSTOM ARG=a3.mean,a37.mean FUNC=x-y PERIODIC=NO

# DISTANCES_GROUP molinfo
a38: DISTANCES GROUP=@back-1 MEAN

d38_0: CUSTOM ARG=a4.mean,a38.mean FUNC=x-y PERIODIC=NO

# DISTANCES_ORIGIN molinfo
a39: DISTANCES ORIGIN=9 ATOMS=@back-1 MEAN

d39_0: CUSTOM ARG=a5.mean,a39.mean FUNC=x-y PERIODIC=NO

# ANGLES molinfo
a40: ANGLES GROUP=@back-1 MEAN

d40_0: CUSTOM ARG=a6.mean,a40.mean FUNC=x-y PERIODIC=NO

# ANGLES_AB molinfo
a41: ANGLES GROUPA=9 GROUPB=@back-1 MEAN

d41_0: CUSTOM ARG=a7.mean,a41.mean FUNC=x-y PERIODIC=NO

# ANGLES_ABC molinfo
a42: ANGLES GROUPA=9 GROUPB=@back-1 GROUPC=10 MEAN

d42_0: CUSTOM ARG=a8.mean,a42.mean FUNC=x-y PERIODIC=NO

# ANGLES_SWITCH molinfo
a43: ANGLES GROUPA=9 GROUPB=@back-1 SWITCH={RATIONAL R_0=1.0} MEAN

d43_0: CUSTOM ARG=a9.mean,a43.mean FUNC=x-y PERIODIC=NO

# COORD_ANGLES molinfo
a44: COORD_ANGLES CATOMS=9 GROUP=@back-1 SWITCH={RATIONAL R_0=1.0} MEAN

d44_0: CUSTOM ARG=a10.mean,a44.mean FUNC=x-y PERIODIC=NO

# INPLANEDISTANCES molinfo
a45: INPLANEDISTANCES VECTORSTART=9 VECTOREND=10 GROUP=@back-1 MEAN

d45_0: CUSTOM ARG=a11.mean,a45.mean FUNC=x-y PERIODIC=NO

# GYRATION_fast molinfo
a46: GYRATION ATOMS=@back-1

d46_0: CUSTOM ARG=a12,a46 FUNC=x-y PERIODIC=NO

# GYRATION_weighted_shortcut molinfo
a47: GYRATION ATOMS=@back-1 WEIGHTS=w

d47_0: CUSTOM ARG=a13,a47 FUNC=x-y PERIODIC=NO

# GYRATION_TENSOR molinfo
a48: GYRATION_TENSOR ATOMS=@back-1 WEIGHTS=w

d48_0: CUSTOM ARG=a14,a48 FUNC=x-y PERIODIC=NO

d48_0_sum: SUM ARG=d48_0 PERIODIC=NO

# CENTER_fast molinfo
a49_c: CENTER ATOMS=@back-1
a49: POSITION ATOM=a49_c NOPBC

d49_0: CUSTOM ARG=a15.x,a49.x FUNC=x-y PERIODIC=NO

d49_1: CUSTOM ARG=a15.y,a49.y FUNC=x-y PERIODIC=NO

d49_2: CUSTOM ARG=a15.z,a49.z FUNC=x-y PERIODIC=NO

# CENTER_weighted_shortcut molinfo
a50_c: CENTER ATOMS=@back-1 WEIGHTS=w
a50: POSITION ATOM=a50_c NOPBC

d50_0: CUSTOM ARG=a16.x,a50.x FUNC=x-y PERIODIC=NO

d50_1: CUSTOM ARG=a16.y,a50.y FUNC=x-y PERIODIC=NO

d50_2: CUSTOM ARG=a16.z,a50.z FUNC=x-y PERIODIC=NO

# DISTANCES ndx
a51: DISTANCES GROUPA=9 GROUPB={@ndx:{index.ndx first}} MEAN

d51_0: CUSTOM ARG=a0.mean,a51.mean FUNC=x-y PERIODIC=NO

# XDISTANCES ndx
a52: XDISTANCES GROUPA=9 GROUPB={@ndx:{index.ndx first}} MEAN

d52_0: CUSTOM ARG=a1.mean,a52.mean FUNC=x-y PERIODIC=NO

# YDISTANCES ndx
a53: YDISTANCES GROUPA=9 GROUPB={@ndx:{index.ndx first}} MEAN

d53_0: CUSTOM ARG=a2.mean,a53.mean FUNC=x-y PERIODIC=NO

# ZDISTANCES ndx
a54: ZDISTANCES GROUPA=9 GROUPB={@ndx:{index.ndx first}} MEAN

