a62: INPLANEDISTANCES VECTORSTART=9 VECTOREND=10 GROUP={@ndx:{index.ndx first}} MEAN

d62_0: CUSTOM ARG=a11.mean,a62.mean FUNC=x-y PERIODIC=NO

# GYRATION_fast ndx
a63: GYRATION ATOMS={@ndx:{index.ndx first}}

d63_0: CUSTOM ARG=a12,a63 FUNC=x-y PERIODIC=NO

# GYRATION_weighted_shortcut ndx
a64: GYRATION ATOMS={@ndx:{index.ndx first}} WEIGHTS=w

d64_0: CUSTOM ARG=a13,a64 FUNC=x-y PERIODIC=NO

# GYRATION_TENSOR ndx
a65: GYRATION_TENSOR ATOMS={@ndx:{index.ndx first}} WEIGHTS=w

d65_0: CUSTOM ARG=a14,a65 FUNC=x-y PERIODIC=NO

d65_0_sum: SUM ARG=d65_0 PERIODIC=NO

# CENTER_fast ndx
a66_c: CENTER ATOMS={@ndx:{index.ndx first}}
a66: POSITION ATOM=a66_c NOPBC

d66_0: CUSTOM ARG=a15.x,a66.x FUNC=x-y PERIODIC=NO

d66_1: CUSTOM ARG=a15.y,a66.y FUNC=x-y PERIODIC=NO

d66_2: CUSTOM ARG=a15.z,a66.z FUNC=x-y PERIODIC=NO

# CENTER_weighted_shortcut ndx
a67_c: CENTER ATOMS={@ndx:{index.ndx first}} WEIGHTS=w
a67: POSITION ATOM=a67_c NOPBC

d67_0: CUSTOM ARG=a16.x,a67.x FUNC=x-y PERIODIC=NO

d67_1: CUSTOM ARG=a16.y,a67.y FUNC=x-y PERIODIC=NO

d67_2: CUSTOM ARG=a16.z,a67.z FUNC=x-y PERIODIC=NO

BIASVALUE ARG=d17_0,d18_0,d19_0,d20_0,d21_0,d22_0,d23_0,d24_0,d25_0,d26_0,d27_0,d28_0,d29_0,d30_0,d31_0_sum,d32_0,d32_1,d32_2,d33_0,d33_1,d33_2,d34_0,d35_0,d36_0,d37_0,d38_0,d39_0,d40_0,d41_0,d42_0,d43_0,d44_0,d45_0,d46_0,d47_0,d48_0_sum,d49_0,d49_1,d49_2,d50_0,d50_1,d50_2,d51_0,d52_0,d53_0,d54_0,d55_0,d56_0,d57_0,d58_0,d59_0,d60_0,d61_0,d62_0,d63_0,d64_0,d65_0_sum,d66_0,d66_1,d66_2,d67_0,d67_1,d67_2

