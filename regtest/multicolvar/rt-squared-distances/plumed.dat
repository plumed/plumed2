d1: DISTANCE ATOMS1=1,2 ATOMS2=5,4 ATOMS3=6,7 ATOMS4=9,10 
d1l: LESS_THAN ARG=d1 SWITCH={RATIONAL R_0=1.5}
ss: SUM ARG=d1l PERIODIC=NO

d1s: DISTANCE ATOMS1=1,2 ATOMS2=5,4 ATOMS3=6,7 ATOMS4=9,10 SQUARED
d1sl: LESS_THAN ARG=d1s SWITCH={RATIONAL R_0=1.5} SQUARED
ssl: SUM ARG=d1sl PERIODIC=NO

PRINT ARG=ss,ssl FILE=colvar FMT=%8.4f 
BIASVALUE ARG=ssl
