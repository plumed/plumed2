# KENREF with two replicas, each split over two ranks (see config).
#
# The ensemble restraint is computed once, on the first rank of replica 0, from the coordinates of
# both replicas. Every other rank must receive its replica's derivatives. config compares this run
# with the same run at one rank per replica, so a rank that falls back to a single-replica restraint,
# or that receives no derivatives, changes the forces it holds.
#
# Data: the 1-1 pairs of the two-member SIGMA set of KEnRef (res/sigma/md_double) that lie in the
# fragment of rt-kenref-sigma.

kenref: KENREF ...
  MODEL=SIGMA
  K=1.0
  N=0.25
  PROTON_MHZ=700.0
  EXP_DATA_FOLDER=./
  REF=./gb3_frag.pdb
  ATOMNAME_MAPPING=./gb3_frag.pdb
  GUIDE_ATOMS=1,5,18,20,22,35,37,39,56,58,60,78,80,82,97
  MAX_FORCE=999
  FIT_TO_REFERENCE
  SATURATE_FORCES
...

PRINT ARG=kenref.bias,kenref.energy,kenref.rmsd FILE=colvar FMT=%8.4f
