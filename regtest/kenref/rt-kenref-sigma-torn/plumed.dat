# KENREF on a frame split across the periodic boundary (see config).
#
# traj.xyz is whole.xyz with residue 3 moved by minus the second box vector and residue 5 by plus the
# first, so the fragment is torn across the cell although every atom sits at a valid periodic image.
# KENREF fits all GUIDE_ATOMS at once and uses pair distances with no cutoff, so it must put each atom
# back next to its neighbours, using the reference gb3_frag.pdb, before computing anything.
#
# Note there is no ARG: KENREF biases coordinates, not collective variables.

kenref: KENREF ...
  MODEL=SIGMA
  K=1.0
  N=0.25
  PROTON_MHZ=700.0
  EXP_DATA_FOLDER=./
  REF=./gb3_frag.pdb
  ATOMNAME_MAPPING=./gb3_frag.pdb
  GUIDE_ATOMS=1,5,18,20,22,35,37,39,56,58,60,78,80,82,97
  MAX_FORCE=999
  FIT_TO_REFERENCE
  SATURATE_FORCES
...

PRINT ARG=kenref.bias,kenref.energy,kenref.rmsd FILE=colvar FMT=%14.8e
