# The kenref module is default-off and needs an external library, so skip when it is not built in.
plumed_modules=kenref
type=driver
# The frames are .xyz rather than .pdb because --mf_pdb stores coordinates in single precision, which
# would make the whole and the repaired frame differ by more than rounding. The box is that of gb3_frag.pdb.
box="--box 6.1224,0,0,0,6.1224,0,3.0612,3.0612,4.3292"
arg="--plumed plumed.dat --ixyz traj.xyz $box --dump-forces forces --dump-forces-fmt %14.8e"

# The expected output is the same run on the whole frame, made here rather than stored, so the test holds
# no KEnRef numbers and does not need updating when an energy model changes.
function plumed_regtest_before() {
  $valgrind $plumed driver --plumed plumed.dat --ixyz whole.xyz $box \
    --dump-forces forces --dump-forces-fmt %14.8e > out_whole 2> err_whole || return 1
  mv colvar whole_colvar && mv forces whole_forces || return 1
}

# The repaired coordinates equal the whole ones only up to rounding, so compare with a tolerance.
function plumed_regtest_after() {
  close() {
    test -s "$1" && test -s "$2" || { echo MISSING ; return ; }
    awk 'NR==FNR{if($1!~/^#/) for(i=1;i<=NF;i++) a[FNR,i]=$i; next}
         $1!~/^#/{for(i=1;i<=NF;i++){d=$i-a[FNR,i]; if(d<0)d=-d; if(d>1e-6) bad++}}
         END{print bad?"DIFFERENT":"same"}' "$1" "$2"
  }
  nonzero() { awk '$1=="X"{for(i=2;i<=4;i++) if($i+0!=0) n++} END{print (n>0)?"yes":"no"}' "$1"; }
  {
    echo "colvar: $(close whole_colvar colvar)"
    echo "forces: $(close whole_forces forces)"
    # Guard against a vacuous pass: the frames must differ, and the restraint must act.
    echo "frames differ: $(cmp -s whole.xyz traj.xyz && echo no || echo yes)"
    echo "forces are non-zero: $(nonzero whole_forces)"
  } > torn_vs_whole
}
