plumed_needs=libmetatomic_core
plumed_modules=metatomic
type=driver

arg="--plumed plumed.dat --ixyz structure.xyz --length-units A --dump-forces forces --dump-forces-fmt %10.6f"

function plumed_regtest_before(){
  # the model in distance.py is loaded through metatomic's Python plugin
  ln -sf "$(python -c 'import metatomic.utils; print(metatomic.utils.python_plugin_path)')" metatomic-python-plugin.so &&
    echo Found metatomic Python plugin
}
