plumed_needs="metatomic:libmetatomic"
plumed_modules=metatomic
type=driver

arg="--plumed plumed.dat --ixyz structure.xyz --length-units A --dump-forces forces --dump-forces-fmt %10.6f"

function plumed_regtest_after(){
  # runs METATOMIC with the model keywords $2 and the keywords $3, and adds to
  # the file $1 the exit code and the first match of $4 in the output
  run(){
    printf "d: METATOMIC %s %s SPECIES1=1 SPECIES2=2 SPECIES_TO_TYPES=8,1\nPRINT ARG=d FILE=%s.colvar\n" "$2" "$3" "$1" > $1.dat
    $plumed_nompi driver --plumed $1.dat --ixyz structure.xyz --length-units A > $1.out 2>&1
    echo "$3: exit code $?" >> $1
    grep -o -m1 "$4" $1.out >> $1
  }

  # A value containing spaces is wrapped in braces. distance.py takes its name
  # from the `name` option, and PLUMED logs it with the model metadata.
  # distance.py has no `device` option: DEVICE=cpu stays in PLUMED and runs,
  # while any other device reaches the model, which rejects it, as it rejects
  # the `extensions_directory` option that EXTENSIONS_DIRECTORY gives.
  local found="This is the [a-z -]* model\|OPTIONS should contain key=value pairs, got '[^']*'\|unknown options: [a-z_]*\|give either [A-Z_]* or OPTIONS={[a-z_]*=...}, not both"
  rm -f options
  for keywords in "OPTIONS={name={a long distance}}" "OPTIONS={name=a long distance}" "DEVICE=cpu" "DEVICE=cuda" \
                  "EXTENSIONS_DIRECTORY=extensions" "EXTENSIONS_DIRECTORY=extensions OPTIONS={extensions_directory=extensions}" ; do
    run options "PLUGIN=python MODEL=distance.py" "$keywords" "$found"
  done

  # the hint about the plugin of metatomic-torch only follows a TorchScript
  # file that no plugin loads, not the errors of a plugin
  rm -f hint
  local hint="TorchScript (.pt) models need the plugin from metatomic-torch"
  run hint "" "MODEL=distance.pt" "$hint"
  run hint "PLUGIN=python MODEL=distance.py" "DEVICE=cuda" "$hint"
}
