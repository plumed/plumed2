plumed_needs="metatomic:libmetatomic"
plumed_modules=metatomic
type=driver

arg="--plumed plumed.dat --ixyz structure.xyz --length-units A --dump-forces forces --dump-forces-fmt %10.6f"

function plumed_regtest_after(){
  # A value containing spaces is wrapped in braces. distance.py takes its name
  # from the `name` option, and PLUMED logs it with the model metadata.
  local cv="d: METATOMIC PLUGIN=python MODEL=distance.py SPECIES1=1 SPECIES2=2 SPECIES_TO_TYPES=8,1"
  rm -f options
  for keywords in "OPTIONS={name={a long distance}}" "OPTIONS={name=a long distance}" ; do
    printf "%s %s\nPRINT ARG=d FILE=options.colvar\n" "$cv" "$keywords" > options.dat
    $plumed_nompi driver --plumed options.dat --ixyz structure.xyz --length-units A > options.out 2>&1
    echo "$keywords: exit code $?" >> options
    grep -o -m1 "This is the [a-z -]* model\|OPTIONS should contain key=value pairs, got '[^']*'\|unknown options: [a-z_]*" options.out >> options
  done
}
