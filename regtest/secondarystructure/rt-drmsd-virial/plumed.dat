MOLINFO STRUCTURE=amyloid.pdb
a: ALPHARMSD RESIDUES=all TYPE=drmsd R_0=0.1
b: ANTIBETARMSD RESIDUES=all TYPE=DRMSD STRANDS_CUTOFF=1.0 R_0=0.1
p: PARABETARMSD RESIDUES=all TYPE=Drmsd STRANDS_CUTOFF=1.0 R_0=0.1
# the third atom of each segment is closer than BONDLENGTH to both the other atoms in STRUCTURE1:
# it is not in any pair
c: SECONDARY_STRUCTURE_DRMSD ...
  ATOMS=1-12 BONDLENGTH=0.15
  STRUCTURE1=0,0,0,2,0,0,1,0,0
  STRUCTURE2=0,0,0,2.5,0,0,1.2,1.8,0
  SEGMENT1=0,1,2 SEGMENT2=3,4,5 SEGMENT3=6,7,8 SEGMENT4=9,10,11
...
c1: SUM ARG=c.struct-1 PERIODIC=NO
c2: SUM ARG=c.struct-2 PERIODIC=NO
RESTRAINT ARG=a,b,p,c1,c2 AT=0,0,0,0,0 KAPPA=1,2,3,4,5
PRINT ARG=a,b,p,c1,c2 FILE=colvar FMT=%8.4f
