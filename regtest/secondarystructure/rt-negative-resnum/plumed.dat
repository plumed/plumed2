# Same as rt32, with residues numbered from -6 (ACE) to 7 (NME) in helix_neg.pdb:
# residue r of rt32 is residue r-7 here, and the results must be identical to those of rt32
MOLINFO STRUCTURE=helix_neg.pdb
ALPHARMSD RESIDUES=ALL TYPE=DRMSD LESS_THAN={RATIONAL R_0=0.08 NN=8 MM=12 NOSTRETCH} LABEL=a
ANTIBETARMSD RESIDUES=all TYPE=DRMSD STRANDS_CUTOFF=1.0 LESS_THAN={RATIONAL R_0=0.08 NN=8 MM=12 NOSTRETCH} LABEL=b
PARABETARMSD RESIDUES=all TYPE=DRMSD STRANDS_CUTOFF=1.0 LESS_THAN={RATIONAL R_0=0.08 NN=8 MM=12 NOSTRETCH} LABEL=p
PRINT ARG=a.*,b.*,p.* STRIDE=1 FILE=colvar FMT=%8.4f
# 2-7 in rt32
ALPHARMSD RESIDUES=-5-0 TYPE=DRMSD R_0=0.08 NN=8 MM=12 LABEL=a2
# 3-5,8-10 in rt32
ANTIBETARMSD RESIDUES=-4--2,1-3 STYLE=inter TYPE=OPTIMAL LESS_THAN={RATIONAL R_0=0.08 NN=8 MM=12 NOSTRETCH} LABEL=b2
RESTRAINT ARG=b.lessthan,p.lessthan,a.lessthan,a2,b2.lessthan AT=0,1,2,3,4 KAPPA=1,2,3,4,5 SLOPE=5,4,3,2,1

a11: ALPHARMSD RESIDUES=ALL TYPE=DRMSD
a23: PARABETARMSD RESIDUES=all TYPE=DRMSD NN=8 MM=12 R_0=0.08 
a24: PARABETARMSD RESIDUES=all TYPE=DRMSD LESS_THAN={RATIONAL R_0=0.08 NN=8 MM=12}
PRINT ARG=a11,a23,a24.* FILE=colvar10 FMT=%8.4f 
