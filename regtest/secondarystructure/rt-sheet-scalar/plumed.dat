MOLINFO STRUCTURE=amyloid.pdb
b1: ANTIBETARMSD RESIDUES=all STRANDS_CUTOFF=1 R_0=0.1
b2: ANTIBETARMSD RESIDUES=all TYPE=OPTIMAL STRANDS_CUTOFF=0.8 LESS_THAN={RATIONAL R_0=0.1 NN=6 MM=10}
b3: ANTIBETARMSD RESIDUES=all STYLE=inter NOPBC STRANDS_CUTOFF=1.2 R_0=0.12
b4: ANTIBETARMSD RESIDUES=all STYLE=intra TYPE=OPTIMAL-FAST R_0=0.1
p1: PARABETARMSD RESIDUES=all STRANDS_CUTOFF=1 R_0=0.1
p2: PARABETARMSD RESIDUES=all TYPE=OPTIMAL STRANDS_CUTOFF=1 LESS_THAN={RATIONAL R_0=0.1 NN=8 MM=12}
p3: PARABETARMSD RESIDUES=all STYLE=inter NOPBC R_0=0.1
RESTRAINT ARG=b1,b2.lessthan,b3,b4,p1,p2.lessthan,p3 AT=0,0,0,0,0,0,0 KAPPA=1,2,3,4,5,6,7
PRINT ARG=b1,b2.lessthan,b3,b4,p1,p2.lessthan,p3 FILE=colvar FMT=%10.6f
