type=driver
# ANTIBETARMSD and PARABETARMSD compute the number of segments with a single action (ANTIBETARMSD_SCALAR,
# PARABETARMSD_SCALAR) instead of the chain of vectors: with and without STRANDS_CUTOFF and LESS_THAN, STYLE inter
# and intra, NOPBC, DRMSD, OPTIMAL and OPTIMAL-FAST. The references were computed with the chain (master before this change),
# then updated for the default STRANDS_CUTOFF (1 nm) and D_MAX of the switching function (v2.11). b4 and p3 use all the pairs
# (STRANDS_CUTOFF=0) and are printed next to the sums of the vectors of the expanded input
extra_files="../rt33/amyloid.pdb ../rt33/amyloid.xyz"
arg="--plumed plumed.dat --trajectory-stride 10 --timestep 0.005 --ixyz amyloid.xyz --dump-forces forces --dump-forces-fmt=%10.6f"
# keep the first two lines of each frame (number of atoms and virial) and the forces on one atom every 10
function plumed_regtest_after(){
  awk 'NR==1{natoms=$1} {i=(NR-1)%(natoms+2); if(i<2 || (i-2)%10==0) print}' forces > forces.tmp && mv forces.tmp forces
}
