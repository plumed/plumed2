MOLINFO MOLTYPE=protein STRUCTURE=helix.pdb
l2: SASA_LCPO ATOMS=7-126 TYPE=TRANSFER APPROACH=2 NL_STRIDE=1
l3: SASA_LCPO ATOMS=7-126 TYPE=TRANSFER APPROACH=3 NL_STRIDE=1
h2: SASA_HASEL ATOMS=7-126 TYPE=TRANSFER APPROACH=2 NL_STRIDE=1
h3: SASA_HASEL ATOMS=7-126 TYPE=TRANSFER APPROACH=3 NL_STRIDE=1
h3n: SASA_HASEL ATOMS=7-126 TYPE=TRANSFER APPROACH=3 NL_STRIDE=1 NUMERICAL_DERIVATIVES
PRINT ARG=l2,l3,h2,h3 FILE=colvar FMT=%10.4f
DUMPDERIVATIVES ARG=h3,h3n FILE=dh FMT=%10.4f
