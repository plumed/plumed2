mpiprocs=2
type=driver
plumed_modules="sasa"
extra_files="../rt-sasa-LCPO/helix.pdb"
arg="--plumed plumed.dat --ixyz traj.xyz --multi 2 --debug-grex 2 --dump-forces forces --dump-forces-fmt=%.17g"
function plumed_regtest_before() {
  for r in 0 1; do
    awk -v r=$r 'substr($0,1,4)=="ATOM"{n++;x[n]=substr($0,31,8);y[n]=substr($0,39,8);z[n]=substr($0,47,8)}END{for(f=0;f<12;f++){print n;print "200 200 200";for(i=1;i<=n;i++)print "X",x[i]*(1+r),y[i]*(1+r),z[i]*(1+r)}}' helix.pdb > traj.$r.xyz
  done
  mkdir noexchange
  (cd noexchange; cp ../plumed.dat ../helix.pdb ../traj.0.xyz ../traj.1.xyz .; $mpi $plumed driver --plumed plumed.dat --ixyz traj.xyz --multi 2 --dump-forces forces --dump-forces-fmt=%.17g > out 2> err)
}
function plumed_regtest_after() {
  for file in COLVAR forces; do
    for r in 0 1; do
      if cmp -s "$file.$r" "noexchange/$file.$r"; then echo "$file.$r IDENTICAL"; else echo "$file.$r DIFFERENT"; fi
    done
  done > comparison
}
