c: COORDINATION GROUPA=1-300 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6} NLIST      NL_STRIDE=1 NL_CUTOFF=0.65
d: COORDINATION GROUPA=1-300 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6} NLISTCELLS NL_STRIDE=1 NL_CUTOFF=0.65
e: COORDINATION GROUPA=1-100 GROUPB=101-300 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6} NLIST      NL_STRIDE=1 NL_CUTOFF=0.65
f: COORDINATION GROUPA=1-100 GROUPB=101-300 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6} NLISTCELLS NL_STRIDE=1 NL_CUTOFF=0.65
s: CUSTOM ARG=c,d FUNC=step(1e-8-abs(y-x)) PERIODIC=NO
t: CUSTOM ARG=e,f FUNC=step(1e-8-abs(y-x)) PERIODIC=NO
PRINT ARG=c,d,e,f FILE=colvar FMT=%10.4f
PRINT ARG=s,t FILE=same FMT=%3.1f
RESTRAINT ARG=d,f AT=0,0 KAPPA=0.01,0.02
