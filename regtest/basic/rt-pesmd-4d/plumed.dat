d1: DISTANCE ATOMS=1,2 COMPONENTS
d2: DISTANCE ATOMS=1,3 COMPONENTS
ff: CUSTOM ARG=d1.x,d1.y,d1.z,d2.x VAR=a,b,c,d FUNC=a*a+2*b*b+c*c+0.5*d*d PERIODIC=NO
bb: BIASVALUE ARG=ff
PRINT ARG=d1.x,d2.x,ff FILE=colvar STRIDE=20 FMT=%8.4f
hh: HISTOGRAM ARG=d1.x GRID_MIN=-2 GRID_MAX=2 GRID_BIN=20 BANDWIDTH=0.3
DUMPGRID ARG=hh FILE=histo FMT=%8.4f
