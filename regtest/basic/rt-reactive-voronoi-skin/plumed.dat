UNITS LENGTH=A

exact: VORONOI_COORDINATION CENTERS=1,2 ASSIGNED=3 KAPPA=30 REFERENCE=0.5 POWER=1 COEFFICIENTS=1,2
buffered: VORONOI_COORDINATION CENTERS=1,2 ASSIGNED=3 KAPPA=30 REFERENCE=0.5 POWER=1 COEFFICIENTS=1,2 NLIST NL_CUTOFF=1.0 NL_SKIN=0.4 NL_STRIDE=100
