# FREQUENCY_ADAPTIVE combined with ADAPTIVE=GEOM, with FA_MAX_PACE not a multiple of PACE
phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17

fa: METAD ARG=phi,psi ADAPTIVE=GEOM SIGMA=0.1 HEIGHT=1.0 BIASFACTOR=10 TEMP=300 PACE=4 ACCELERATION FREQUENCY_ADAPTIVE FA_UPDATE_FREQUENCY=20 FA_MAX_PACE=10 FA_MIN_ACCELERATION=1.0 FILE=HFA FMT=%14.6f

PRINT ARG=phi,psi,fa.bias,fa.acc,fa.pace FILE=colvar FMT=%10.5f
DUMPFORCES ARG=phi,psi STRIDE=2 FILE=forces FMT=%10.5f
