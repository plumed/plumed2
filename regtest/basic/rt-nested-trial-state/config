mpiprocs=2
type=driver
plumed_modules=bias
arg="--plumed plumed.dat --ixyz traj.xyz --multi 2 --debug-grex 2"
function plumed_regtest_before() {
  for r in 0 1; do
    awk -v r=$r 'BEGIN{for(f=0;f<12;f++){print 2;print "10 10 10";print "X 0 0 0";printf "X %.12f 0 0\n",2-r+0.001*f}}' > traj.$r.xyz
  done
  mkdir noexchange
  (cd noexchange; cp ../plumed.dat ../guest.dat ../traj.0.xyz ../traj.1.xyz .; $mpi $plumed driver --plumed plumed.dat --ixyz traj.xyz --multi 2 > out 2> err)
}
function plumed_regtest_after() {
  {
    for file in COLVAR guest-values; do
      for r in 0 1; do
        if cmp -s "$file.$r" "noexchange/$file.$r"; then echo "$file.$r IDENTICAL"; else echo "$file.$r DIFFERENT"; fi
      done
    done
  } > comparison
}
