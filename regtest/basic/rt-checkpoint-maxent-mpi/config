mpiprocs=4
type=driver
plumed_modules=bias
# Reference run: four replicas (--multi 4) with one process each, the checkpointing signal every 10 steps
arg="--plumed plumed.dat --ixyz traj.xyz --multi 4 --checkpoint-stride 10 --log driver.log"

function plumed_regtest_before() {
  # 60 frames of 4 atoms (analytic positions)
  awk 'BEGIN{for(f=0;f<60;f++){print 4; print "10 10 10"; for(i=0;i<4;i++){printf "X %f %f %f\n", i+0.5*sin(0.1*f+i), 0.3*cos(0.07*f*(i+1)), 0.2*i*f/60.0}}}' > traj.xyz
  # the first 25 frames: the interrupted run
  head -n 150 traj.xyz > part.xyz
  # A) four replicas, checkpoints at steps 0, 10 and 20, restart from step 20
  mkdir restart ; cd restart ; cp ../plumed.dat .
  $mpi $plumed driver --plumed plumed.dat --ixyz ../part.xyz --multi 4 --checkpoint-stride 10 --log driver.log > out1 2> err1
  $mpi $plumed driver --plumed plumed.dat --ixyz ../traj.xyz --multi 4 --checkpoint-stride 10 --restart-from-checkpoint plumed.cpt --log driver.log > out2 2> err2
  cd ..
  # B) two replicas with two processes each, checkpoints every 7 steps (STRIDE), restart from step 21
  sed -e 's/^CHECKPOINT.*/CHECKPOINT FILE=plumed.cpt STRIDE=7/' \
      -e 's/{{1,2} {1,3} {2,3} {1,4}}/{{1,2} {1,3}}/' -e 's/{{2,3} {2,4} {3,4} {1,3}}/{{2,3} {2,4}}/' \
      -e 's/APPLY_WEIGHTS=1,1,0,1/APPLY_WEIGHTS=0,1/' plumed.dat > plumed2.dat
  for d in reference2 restart2 ; do mkdir $d ; cp plumed2.dat $d/plumed.dat ; done
  cd reference2
  $mpi $plumed driver --plumed plumed.dat --ixyz ../traj.xyz --multi 2 --log driver.log > out 2> err
  cd ../restart2
  $mpi $plumed driver --plumed plumed.dat --ixyz ../part.xyz --multi 2 --log driver.log > out1 2> err1
  $mpi $plumed driver --plumed plumed.dat --ixyz ../traj.xyz --multi 2 --restart-from-checkpoint plumed.cpt --log driver.log > out2 2> err2
  cd ..
}

function plumed_regtest_after() {
  # the restarted runs must reproduce the reference bitwise (no wall-clock data in these files)
  {
    for r in 0 1 2 3 ; do
      for f in COLVAR.$r m1.LAGMULT.$r m2.LAGMULT.$r ; do
        if cmp -s $f restart/$f ; then echo "restart/$f IDENTICAL" ; else echo "restart/$f DIFFERENT" ; fi
      done
    done
    for r in 0 1 ; do
      for f in COLVAR.$r m1.LAGMULT.$r m2.LAGMULT.$r ; do
        if cmp -s reference2/$f restart2/$f ; then echo "restart2/$f IDENTICAL" ; else echo "restart2/$f DIFFERENT" ; fi
      done
    done
    for d in restart restart2 ; do
      # Replicas have independent logs; merged stdout can interleave prefixes and messages.
      if grep -q "not stored in the checkpoint" $d/driver.*.log $d/err2 ; then echo "$d: unported state warning" ; fi
      # BSD and GNU uniq use different padding for counts; keep the reference format.
      grep -h "Checkpoint state restored" $d/driver.*.log | sed 's/by PLUMED.*//' | sort | uniq -c |
        awk '{count=$1; sub(/^[[:space:]]*[0-9]+[[:space:]]+/, ""); printf "%7d %s\n", count, $0}'
    done
  } > restart_check
}
