type=driver
# 6000 atoms and the inputs of CONTACTMAP are written by plumed_regtest_before, to avoid large files.
# There are enough contacts for CONTACTMAP to use the two OpenMP threads.
arg="--plumed plumed.dat --ixyz traj.xyz --dump-forces forces --dump-forces-fmt=%12.6f"
export PLUMED_NUM_THREADS=2

function plumed_regtest_before(){
  awk 'BEGIN{
    n=6000; l=8.0
    for(f=0;f<2;f++){
      print n; print l, l, l
      for(i=0;i<n;i++){
        x=(i%20)*0.4+0.05*sin(0.7*i+f); y=(int(i/20)%20)*0.4+0.05*cos(1.3*i+f); z=int(i/400)*0.5+0.05*sin(2.1*i+f)
        printf "X %.6f %.6f %.6f\n", x, y, z
      }
    }
  }' > traj.xyz
# contact i is between atom i and a neighbour along x, y or z (some of them across the periodic boundary)
  awk 'function pairs(n,   i,a,b,d){
         for(i=1;i<=n;i++){ a=(i*37)%6000+1; d=(i%3==0 ? 1 : (i%3==1 ? 20 : 400)); b=(a-1+d)%6000+1; printf "  ATOMS%d=%d,%d\n", i, a, b }
       }
       BEGIN{
         print "q: CONTACTMAP ..."; pairs(1000)
         print "  SWITCH={Q R_0=0.01 BETA=50.0 LAMBDA=1.2 REF=0.4}\n  NORMALIZE_WEIGHTS\n  SUM\n..."
         print "cm: CONTACTMAP ..."; pairs(1000)
         print "  SWITCH={RATIONAL R_0=0.45 NN=8 MM=12}\n  REFERENCE=0.4\n  CMDIST\n..."
         print "c: CONTACTMAP ..."; pairs(400)
         print "  SWITCH={RATIONAL R_0=0.45}\n..."
       }' > cmaps.dat
}

# The forces with two threads must be the same as with one thread: the
# comparison is written to forces-threads, the forces themselves are not stored.
function plumed_regtest_after(){
  PLUMED_NUM_THREADS=1 $plumed driver --plumed plumed.dat --ixyz traj.xyz --dump-forces forces1 --dump-forces-fmt=%12.6f > out1 2> err1
  paste -d'|' forces forces1 | awk -F'|' '
    {n=split($1,a," "); m=split($2,b," "); if(n!=m) bad=1
     for(i=1;i<=n;i++) if(a[i] ~ /^[-+]?[0-9.]+$/) {d=a[i]-b[i]; if(d<0) d=-d; if(d>max) max=d} else if(a[i]!=b[i]) bad=1
     if(n==4 && (a[2]!=0 || a[3]!=0 || a[4]!=0)) nonzero++}
    END{print "forces with 2 threads equal to 1 thread:", (NR>0 && bad==0 && max<=1e-6 ? "yes" : "no")
        print "atoms with forces:", nonzero}' > forces-threads
  rm -f forces forces1 traj.xyz cmaps.dat
}
