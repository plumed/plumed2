type=driver
plumed_modules="clusters adjmat gridtools"
arg="--plumed plumed.dat --ixyz traj.xyz"

# the outputs computed with the old keywords must be identical to the ones computed with the new keywords
function plumed_regtest_after(){
  {
    for f in fes ; do
      if cmp -s <(grep -v "^#!" ${f}_new.dat) <(grep -v "^#!" ${f}_old.dat) ; then
        echo "$f: old and new syntax give the same grid"
      else
        echo "$f: old and new syntax DIFFER"
      fi
    done
    awk '!/^#!/{print ($2==$3 && $4==$5 && $6==$7) ? "colvar: same" : "colvar: DIFFER"}' colvar | sort -u
  } > same
}
