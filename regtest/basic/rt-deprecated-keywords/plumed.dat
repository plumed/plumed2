# Keywords of older versions of PLUMED (DATA, GRID, MATRIX, ATOMS, SIGMA) are read as the keywords
# that replace them (ARG, GROUP, BANDWIDTH). Each quantity is computed with the old and with the
# new syntax: the two outputs must be identical.
d1: DISTANCE ATOMS=1,2

hn: HISTOGRAM ARG=d1 GRID_MIN=0 GRID_MAX=3 GRID_BIN=30 BANDWIDTH=0.1
fn: CONVERT_TO_FES ARG=hn TEMP=300
DUMPGRID ARG=fn FILE=fes_new.dat FMT=%8.4f

ho: HISTOGRAM DATA=d1 GRID_MIN=0 GRID_MAX=3 GRID_BIN=30 BANDWIDTH=0.1
fo: CONVERT_TO_FES GRID=ho TEMP=300
DUMPGRID GRID=fo FILE=fes_old.dat FMT=%8.4f

cm: CONTACT_MATRIX GROUP=1-60 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6}
dfsn: DFSCLUSTERING ARG=cm
dfso: DFSCLUSTERING MATRIX=cm
c1n: CLUSTER_NATOMS CLUSTERS=dfsn CLUSTER=1
c1o: CLUSTER_NATOMS CLUSTERS=dfso CLUSTER=1

dmn: DISTANCE_MATRIX GROUP=1-20 LINKCELL_CUTOFF=0.8
dmo: DISTANCE_MATRIX GROUP=1-20 CUTOFF=0.8
sdn: SUM ARG=dmn PERIODIC=NO
sdo: SUM ARG=dmo PERIODIC=NO

# PAIRENTROPY is a shortcut to RDF, and it also accepts the deprecated ATOMS of RDF
pen: PAIRENTROPY GROUP=1-60 MAXR=1.2 GRID_BIN=20 BANDWIDTH=0.05
peo: PAIRENTROPY ATOMS=1-60 MAXR=1.2 GRID_BIN=20 SIGMA=0.05

PRINT ARG=c1n,c1o,pen,peo,sdn,sdo FILE=colvar FMT=%8.4f
