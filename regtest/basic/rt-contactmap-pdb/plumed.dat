# 1 if q and qref are the same
same: CUSTOM ARG=q,qref FUNC=step(1e-9-abs(x-y)) PERIODIC=NO

# Reference contact map from the reference structure (zero on the first frame, that is the reference),
# with different switching functions, including a Q with its own REF that is kept
cm: CONTACTMAP ...
  ATOMS1=1,67 SWITCH1={RATIONAL R_0=0.6} WEIGHT1=0.5
  ATOMS2=1,68 SWITCH2={RATIONAL R_0=0.5 NN=8 MM=12} WEIGHT2=0.6
  ATOMS3=1,69 SWITCH3={Q R_0=0.01 BETA=50.0 LAMBDA=1.5} WEIGHT3=0.7
  ATOMS4=5,61 SWITCH4={Q R_0=0.01 BETA=50.0 LAMBDA=1.8 REF=0.35} WEIGHT4=0.8
  ATOMS5=5,67 SWITCH5={EXP R_0=0.3} WEIGHT5=0.9
  ATOMS6=5,68 SWITCH6={RATIONAL R_0=0.6} WEIGHT6=1
  ATOMS7=5,69 SWITCH7={RATIONAL R_0=0.5 NN=8 MM=12} WEIGHT7=1.1
  ATOMS8=11,68 SWITCH8={Q R_0=0.01 BETA=50.0 LAMBDA=1.5} WEIGHT8=1.2
  ATOMS9=11,69 SWITCH9={Q R_0=0.01 BETA=50.0 LAMBDA=1.8 REF=0.35} WEIGHT9=1.3
  ATOMS10=15,57 SWITCH10={EXP R_0=0.3} WEIGHT10=1.4
  REFERENCE=native.pdb
  CMDIST
...

# Components: Q without REF take it from the reference structure
c: CONTACTMAP ATOMS1=1,67 ATOMS2=5,68 ATOMS3=16,68 SWITCH={Q R_0=0.01 BETA=50.0 LAMBDA=1.2} REFERENCE=native.pdb

PRINT ARG=q,qref,cm,c.* FILE=colvar FMT=%10.6f
PRINT ARG=same FILE=same FMT=%4.1f
DUMPDERIVATIVES ARG=q FILE=deriv_q FMT=%10.6f
DUMPDERIVATIVES ARG=cm FILE=deriv_cm FMT=%10.6f
