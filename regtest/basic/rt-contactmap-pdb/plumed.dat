# Native contacts: the Q switching functions take REF from the reference structure,
# NORMALIZE_WEIGHTS gives each contact the weight 1/40 and no reference value is subtracted
q: CONTACTMAP ...
  ATOMS1=1,67
  ATOMS2=1,68
  ATOMS3=1,69
  ATOMS4=5,61
  ATOMS5=5,67
  ATOMS6=5,68
  ATOMS7=5,69
  ATOMS8=11,68
  ATOMS9=11,69
  ATOMS10=15,57
  ATOMS11=15,59
  ATOMS12=15,61
  ATOMS13=15,67
  ATOMS14=15,68
  ATOMS15=15,69
  ATOMS16=15,76
  ATOMS17=16,57
  ATOMS18=16,59
  ATOMS19=16,61
  ATOMS20=16,67
  ATOMS21=16,68
  ATOMS22=16,69
  ATOMS23=16,74
  ATOMS24=16,76
  ATOMS25=16,78
  ATOMS26=16,80
  ATOMS27=26,283
  ATOMS28=26,286
  ATOMS29=26,292
  ATOMS30=27,283
  ATOMS31=27,286
  ATOMS32=27,292
  ATOMS33=28,280
  ATOMS34=28,283
  ATOMS35=28,286
  ATOMS36=28,289
  ATOMS37=28,291
  ATOMS38=28,292
  ATOMS39=29,283
  ATOMS40=29,286
  SWITCH={Q R_0=0.01 BETA=50.0 LAMBDA=1.5}
  REFERENCE=native.pdb
  NORMALIZE_WEIGHTS
  SUM
...

# The same with the REF values written explicitly
qref: CONTACTMAP ...
  ATOMS1=1,67 SWITCH1={Q R_0=0.01 BETA=50.0 LAMBDA=1.5 REF=0.4670695880}
