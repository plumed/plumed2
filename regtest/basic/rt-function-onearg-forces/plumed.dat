d: DISTANCE ATOMS1=1,2 ATOMS2=3,4 ATOMS3=5,6 ATOMS4=7,8
s: SORT ARG=d
m: MOMENTS ARG=d POWERS=2,3
cm: CONTACT_MATRIX GROUP=1-64 SWITCH={RATIONAL R_0=1.5 D_MAX=2.5}
mm: MOMENTS ARG=cm POWERS=2
h: HIGHEST ARG=cm
PRINT ARG=s.*,m.*,mm.*,h FILE=colvar FMT=%10.6f
RESTRAINT ARG=s.4,m.moment-3,mm.moment-2,h AT=0,0,0,0 KAPPA=1,100,1000,10
