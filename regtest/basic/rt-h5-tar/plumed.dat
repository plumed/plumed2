# archives of HDF5 tables (.hpa): the same data written in text and in archives (see config)
d1: DISTANCE ATOMS=1,2
t: TORSION ATOMS=1,2,3,4
# hills at fixed height on a trajectory given by the driver
m: METAD ARG=d1 SIGMA=0.1 HEIGHT=0.5 PACE=5 FILE=HILLS.hpa
mt: METAD ARG=d1 SIGMA=0.1 HEIGHT=0.5 PACE=5 FILE=HILLS FMT=%24.17g
PRINT ARG=d1,t,m.bias FILE=COLVAR.hpa
PRINT ARG=d1,t,m.bias FILE=COLVAR FMT=%.17g
# every flush appends a member to the archives: members of 7 rows, so that the restarts cut a member
FLUSH STRIDE=7
