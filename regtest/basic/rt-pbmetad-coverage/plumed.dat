# PBMETAD on two torsions (periodic) and a distance (not periodic), one family per variable.
# g: grids (GA* written at step 500); n: same without grids; s: sparse grids
# ag: ADAPTIVE=GEOM on grids; ad: ADAPTIVE=DIFF without grids
# i: INTERVAL on the distance, with grids; j: same without grids
phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17
d: DISTANCE ATOMS=5,17

g: PBMETAD ARG=phi,psi,d SIGMA=0.3,0.3,0.02 HEIGHT=1.0 BIASFACTOR=10 TEMP=300 PACE=5 FMT=%14.6f FILE=HG1,HG2,HG3 GRID_MIN=-pi,-pi,0.0 GRID_MAX=pi,pi,1.0 GRID_SPACING=0.05,0.05,0.005 GRID_WSTRIDE=500 GRID_WFILES=GA1,GA2,GA3
n: PBMETAD ARG=phi,psi,d SIGMA=0.3,0.3,0.02 HEIGHT=1.0 BIASFACTOR=10 TEMP=300 PACE=5 FMT=%14.6f FILE=HN1,HN2,HN3
s: PBMETAD ARG=phi,psi,d SIGMA=0.3,0.3,0.02 HEIGHT=1.0 BIASFACTOR=10 TEMP=300 PACE=5 FMT=%14.6f FILE=HS1,HS2,HS3 GRID_MIN=-pi,-pi,0.0 GRID_MAX=pi,pi,1.0 GRID_SPACING=0.05,0.05,0.005 GRID_SPARSE
ag: PBMETAD ARG=phi,psi,d ADAPTIVE=GEOM SIGMA=0.05 SIGMA_MIN=0.2,0.2,0.01 SIGMA_MAX=0.6,0.6,0.1 HEIGHT=1.0 BIASFACTOR=10 TEMP=300 PACE=5 FMT=%14.6f FILE=HAG1,HAG2,HAG3 GRID_MIN=-pi,-pi,0.0 GRID_MAX=pi,pi,1.0 GRID_SPACING=0.05,0.05,0.002
ad: PBMETAD ARG=phi,psi,d ADAPTIVE=DIFF SIGMA=20 HEIGHT=1.0 BIASFACTOR=10 TEMP=300 PACE=5 FMT=%14.6f FILE=HAD1,HAD2,HAD3
i: PBMETAD ARG=phi,psi,d SIGMA=0.3,0.3,0.02 HEIGHT=1.0 BIASFACTOR=10 TEMP=300 PACE=5 FMT=%14.6f FILE=HI1,HI2,HI3 INTERVAL_MIN=-pi,-pi,0.3213 INTERVAL_MAX=pi,pi,0.3487 GRID_MIN=-pi,-pi,0.0 GRID_MAX=pi,pi,1.0 GRID_SPACING=0.05,0.05,0.005
j: PBMETAD ARG=phi,psi,d SIGMA=0.3,0.3,0.02 HEIGHT=1.0 BIASFACTOR=10 TEMP=300 PACE=5 FMT=%14.6f FILE=HJ1,HJ2,HJ3 INTERVAL_MIN=-pi,-pi,0.3213 INTERVAL_MAX=pi,pi,0.3487

PRINT ARG=phi,psi,d,g.bias,n.bias,s.bias,ag.bias,ad.bias,i.bias,j.bias FILE=colvar FMT=%10.5f
DUMPFORCES ARG=phi,psi,d STRIDE=5 FILE=forces FMT=%10.4f
