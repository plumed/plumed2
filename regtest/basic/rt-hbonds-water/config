type=driver
# HBONDS on a box of 64 water molecules, in Angstrom in the trajectory and in the input (the default switching function is converted to the length units),
# with two OpenMP threads. The hydrogen bonds counted with a sharp switching function (hb_sharp) are those of
# mdtraj.wernet_nilsson (exclude_water=False, periodic=True): 104.
extra_files="../../adjmat/rt-hbond/water-box.xyz"
arg="--plumed plumed.dat --ixyz water-box.xyz --length-units A --dump-forces forces --dump-forces-fmt %10.5f"
export PLUMED_NUM_THREADS=2
