cm: CONTACT_MATRIX GROUP=1-64 SWITCH={RATIONAL R_0=2.0 D_MAX=2.6}
ones: ONES SIZE=64
cn: MATRIX_VECTOR_PRODUCT ARG=cm,ones
lt: LESS_THAN ARG=cn SWITCH={RATIONAL R_0=0.5}
s: SUM ARG=lt PERIODIC=NO
c4: COORDINATIONNUMBER SPECIES=1-64 SWITCH={RATIONAL R_0=2.0 D_MAX=2.6} LESS_THAN={RATIONAL R_0=0.5}
PRINT ARG=s,c4.* FILE=colvar FMT=%10.6f
RESTRAINT ARG=s,c4_lessthan AT=0,0 KAPPA=1,1
