t1: TORSION ATOMS=1,2,3,4
t2: TORSION ATOMS=5,6,7,8
t3: TORSION ATOMS=9,10,11,12
# circular mean
av: COMBINE ARG=t1,t2,t3 CIRCULAR PERIODIC=-pi,pi
# general combination with parameters, powers and an output domain different from the input one
av2: COMBINE ARG=t1,t2,t3 CIRCULAR COEFFICIENTS=1,2,0.5 PARAMETERS=0.1,-3,2 POWERS=1,2,3 PERIODIC=0,1
# vector version
t: TORSION ATOMS1=1,2,3,4 ATOMS2=5,6,7,8 ATOMS3=9,10,11,12
tt: TORSION ATOMS1=13,14,15,16 ATOMS2=17,18,19,20 ATOMS3=21,22,23,24
avv: COMBINE ARG=t,tt CIRCULAR PERIODIC=-pi,pi
s: SUM ARG=avv PERIODIC=NO
PRINT ARG=av,av2,avv FILE=colvar FMT=%12.8f
RESTRAINT ARG=av,av2,s AT=0.5,0.2,1 KAPPA=10,5,1
