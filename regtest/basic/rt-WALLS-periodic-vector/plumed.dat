# Walls on periodic vector arguments act on the value in the periodic domain,
# without applying PBCs to the difference with AT (issue #658).
# The walls on the vector tv should give the same bias as those on the scalars t1 and t2
t1: TORSION ATOMS=1,2,3,4 NOPBC
t2: TORSION ATOMS=1,2,3,5 NOPBC
tv: TORSION ATOMS1=1,2,3,4 ATOMS2=1,2,3,5 NOPBC

uw: UPPER_WALLS ARG=t1,t2 AT=2.0,2.0 KAPPA=1.0,1.0
lw: LOWER_WALLS ARG=t1,t2 AT=-0.55,-0.55 KAPPA=2.0,2.0 OFFSET=0.05,0.05 EXP=3,3

uwv: UPPER_WALLS ARG=tv AT=2.0 KAPPA=1.0
lwv: LOWER_WALLS ARG=tv AT=-0.55 KAPPA=2.0 OFFSET=0.05 EXP=3

PRINT ARG=t1,t2,uw.bias,lw.bias,uwv_bias,lwv_bias,uw.force2,lw.force2,uwv_force2,lwv_force2 FILE=COLVAR FMT=%8.4f
