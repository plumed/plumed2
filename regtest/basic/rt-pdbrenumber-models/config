type=plumed
# with several models, the numbering restarts from the first number after each ENDMDL/END
arg="pdbrenumber --ipdb in.pdb --opdb out.pdb --firstatomnumber 99998"

# the list of numbers may contain empty lines
function plumed_regtest_after(){
  $plumed_nompi pdbrenumber --ipdb in.pdb --opdb out-list.pdb --atomnumbers numbers.dat > /dev/null
  $plumed_nompi pdbrenumber --ipdb in.pdb --opdb out-default.pdb > /dev/null
}
