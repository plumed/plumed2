mpiprocs=2
type=driver
# Same as rt-checkpoint-driver, with two replicas (--multi 2): one checkpoint per replica
arg="--plumed plumed.dat --ixyz traj.xyz --multi 2 --checkpoint-stride 10"

function plumed_regtest_before() {
  awk 'BEGIN{for(f=0;f<60;f++){print 4; print "10 10 10"; for(i=0;i<4;i++){printf "X %f %f %f\n", i+0.5*sin(0.1*f+i), 0.3*cos(0.07*f*(i+1)), 0.2*i*f/60.0}}}' > traj.xyz
  head -n 150 traj.xyz > part.xyz
  mkdir restart
  cd restart
  cp ../plumed.0.dat ../plumed.1.dat .
  $mpi $plumed driver --plumed plumed.dat --ixyz ../part.xyz --multi 2 --checkpoint-stride 10 > out1 2> err1
  $mpi $plumed driver --plumed plumed.dat --ixyz ../traj.xyz --multi 2 --checkpoint-stride 10 --restart-from-checkpoint plumed.cpt > out2 2> err2
  cd ..
  # replicas with checkpoints at different steps
  mkdir wrong-step
  cd wrong-step
  cp ../restart/plumed.0.dat ../restart/plumed.1.dat ../restart/COLVAR.0 ../restart/COLVAR.1 ../restart/plumed.0.cpt .
  cp ../restart/plumed_prev.1.cpt plumed.1.cpt
  $mpi $plumed driver --plumed plumed.dat --ixyz ../traj.xyz --multi 2 --checkpoint-stride 10 --restart-from-checkpoint plumed.cpt > out1 2> err1
  cd ..
}

function plumed_regtest_after() {
  for f in COLVAR.0 COLVAR.1 ; do
    if cmp $f restart/$f ; then echo "$f IDENTICAL" ; else echo "$f DIFFERENT" ; fi
  done > restart_check
  grep -h "truncated\|Checkpoint state restored\|Restarting from checkpoint" restart/out2 | sed 's/by PLUMED.*//' | sed 's/ from [0-9]* to [0-9]* bytes//' | sort >> restart_check
  grep -h "all the replicas must restart" wrong-step/err1 | head -n 1 | sed 's/^+++ *//' >> restart_check
}
