# backbone from the pdb file
MOLINFO STRUCTURE=helix.pdb
a: ALPHARMSD RESIDUES=2-13
a1: ALPHARMSD RESIDUES=2-7
a2: ALPHARMSD RESIDUES=8-13

# the same backbone given with CHAIN (one chain), then with CHAIN1 and CHAIN2 (two chains)
MOLINFO CHAIN=7,9,11,15,16,17,19,21,25,26,27,29,31,35,36,37,39,41,45,46,47,49,51,55,56,57,59,61,65,66,67,69,71,75,76,77,79,81,85,86,87,89,91,95,96,97,99,101,105,106,107,109,111,115,116,117,119,121,125,126
c: ALPHARMSD RESIDUES=all
MOLINFO CHAIN1=7,9,11,15,16,17,19,21,25,26,27,29,31,35,36,37,39,41,45,46,47,49,51,55,56,57,59,61,65,66 CHAIN2=67,69,71,75,76,77,79,81,85,86,87,89,91,95,96,97,99,101,105,106,107,109,111,115,116,117,119,121,125,126
cc: ALPHARMSD RESIDUES=all
sum: COMBINE ARG=a1,a2 PERIODIC=NO

# a and c must be equal, cc and sum must be equal
PRINT ARG=a,c,cc,sum FILE=colvar FMT=%8.4f
