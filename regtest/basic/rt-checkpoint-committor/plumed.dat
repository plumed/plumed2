# exact restart of COMMITTOR (the basin of the previous step) from the checkpoint: see config
CHECKPOINT FILE=plumed.cpt
d1: DISTANCE ATOMS=1,2
# the system is in the first basin at the steps 17-23 and 32-34, in the second at 24-31 and from 49: it is in one at the checkpoints
cm: COMMITTOR ARG=d1 BASIN_LL1=0.6 BASIN_UL1=0.8 BASIN_LL2=0.5 BASIN_UL2=0.5999 NOSTOP FILE=basin.dat FMT=%.17g
PRINT ARG=d1 FILE=COLVAR STRIDE=1 FMT=%.17g
