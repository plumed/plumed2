MOLINFO STRUCTURE=ref.pdb
hb: HBONDS DONORS=@hbdonors HYDROGENS=@polarhydrogens ACCEPTORS=@hbacceptors
hb_nl: HBONDS DONORS=@hbdonors HYDROGENS=@polarhydrogens ACCEPTORS=@hbacceptors NLIST NL_CUTOFF=0.5 NL_STRIDE=2
hb_cells: HBONDS DONORS=@hbdonors HYDROGENS=@polarhydrogens ACCEPTORS=@hbacceptors NLISTCELLS NL_CUTOFF=0.5 NL_STRIDE=2 SWITCH={RATIONAL R_0=0.33 NN=8 MM=16 D_MAX=0.45}
PRINT ARG=hb,hb_nl,hb_cells FILE=colvar FMT=%10.6f
BIASVALUE ARG=hb,hb_nl,hb_cells
