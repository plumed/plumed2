d1: DISTANCE ATOMS=1,2
d2: DISTANCE ATOMS=3,4
d3: DISTANCE ATOMS=5,6
d4: DISTANCE ATOMS=7,8
p: FUNCPATHMSD ARG=d1,d2,d3,d4 LAMBDA=2000
pn: FUNCPATHMSD ARG=d1,d2,d3,d4 LAMBDA=2000 NEIGH_SIZE=2 NEIGH_STRIDE=0.01
PRINT ARG=p.s,p.z,pn.s,pn.z FILE=colvar FMT=%12.8f
RESTRAINT ARG=p.s,p.z,pn.z AT=0,0,0 KAPPA=1,1,1
