# Action::launch() and Action::launchApply(): LAUNCH_TEST writes in the file "order"
# when they are called, and computes the sum of the x coordinates of its atoms from
# the positions it had in launch(). The same sums are computed with POSITION.
LOAD FILE=LaunchTest.cpp

# a and b are launched together, before d is calculated
a: LAUNCH_TEST ATOMS=1,2
d: DISTANCE ATOMS=1,2
b: LAUNCH_TEST ATOMS=3,4
# m depends on b: in the backward loop b is launched only after m is applied
m: CUSTOM ARG=b FUNC=x*x PERIODIC=NO
# e depends on c: it is launched after c is calculated
c: CENTER ATOMS=5,6
e: LAUNCH_TEST ATOMS=c,7
p1: POSITION ATOM=1 NOPBC
p2: POSITION ATOM=2 NOPBC
p3: POSITION ATOM=3 NOPBC
p4: POSITION ATOM=4 NOPBC
pc: POSITION ATOM=c NOPBC
p7: POSITION ATOM=7 NOPBC
# f comes after an action that moves the atoms. At the first step this is not known yet:
# f is launched with a and b, and the launch is cancelled. Then it is launched after FIT_TO_TEMPLATE
FIT_TO_TEMPLATE REFERENCE=align.pdb TYPE=SIMPLE
f: LAUNCH_TEST ATOMS=8,9
p8: POSITION ATOM=8 NOPBC
p9: POSITION ATOM=9 NOPBC
# with numerical derivatives it is never launched
g: LAUNCH_TEST ATOMS=10,11 NUMERICAL_DERIVATIVES
p10: POSITION ATOM=10 NOPBC
p11: POSITION ATOM=11 NOPBC

# the squared differences: all zero
da: CUSTOM ARG=a,p1.x,p2.x FUNC=(x-y-z)^2 PERIODIC=NO
db: CUSTOM ARG=b,p3.x,p4.x FUNC=(x-y-z)^2 PERIODIC=NO
de: CUSTOM ARG=e,pc.x,p7.x FUNC=(x-y-z)^2 PERIODIC=NO
df: CUSTOM ARG=f,p8.x,p9.x FUNC=(x-y-z)^2 PERIODIC=NO
dg: CUSTOM ARG=g,p10.x,p11.x FUNC=(x-y-z)^2 PERIODIC=NO
PRINT ARG=a,b,e,f,g,da,db,de,df,dg FILE=colvar FMT=%8.4f

RESTRAINT ARG=a,d,m,e,f AT=0,0,0,0,0 SLOPE=1,2,3,4,5
