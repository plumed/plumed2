# options not covered elsewhere: CALC_MAX_BIAS, GRID_NOSPLINE, CALC_WORK on grid, CALC_RCT with RCT_USTRIDE
phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17

mx: METAD ARG=phi,psi SIGMA=0.3,0.3 HEIGHT=1.0 BIASFACTOR=10 TEMP=300 PACE=5 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=80,80 CALC_MAX_BIAS CALC_WORK FILE=HX FMT=%14.6f
ns: METAD ARG=phi,psi SIGMA=0.3,0.3 HEIGHT=1.0 BIASFACTOR=10 TEMP=300 PACE=5 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=80,80 GRID_NOSPLINE FILE=HNS FMT=%14.6f
rc: METAD ARG=phi,psi SIGMA=0.3,0.3 HEIGHT=1.0 BIASFACTOR=10 TEMP=300 PACE=5 GRID_MIN=-pi,-pi GRID_MAX=pi,pi GRID_BIN=80,80 CALC_RCT RCT_USTRIDE=4 FILE=HRC FMT=%14.6f

PRINT ARG=phi,psi,mx.bias,mx.maxbias,mx.work,ns.bias,rc.bias,rc.rbias,rc.rct FILE=colvar FMT=%10.5f
DUMPFORCES ARG=phi,psi STRIDE=2 FILE=forces FMT=%10.5f
