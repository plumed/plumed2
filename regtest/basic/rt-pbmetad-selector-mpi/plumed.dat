# PBMETAD with WALKERS_MPI and SELECTOR: the selector is 0 for walker 0 and 1 for walker 1, and only walker 0
# (SELECTOR_ID=0) adds hills, which are shared with walker 1 (walker 1 does not feel the bias).
phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17
SELECTOR NAME=S VALUE=@replicas:0,1
pb: PBMETAD ARG=phi,psi SIGMA=0.3,0.3 HEIGHT=1 PACE=10 TEMP=300 BIASFACTOR=10 WALKERS_MPI SELECTOR=S SELECTOR_ID=0 FILE=SA,SB FMT=%14.6f
PRINT ARG=phi,psi,pb.bias FILE=colvar FMT=%10.5f
DUMPFORCES ARG=phi,psi FILE=forces FMT=%10.4f
