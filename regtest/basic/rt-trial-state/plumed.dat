d: DISTANCE ATOMS=1,2 NOPBC
a: ABMD ARG=d TO=0 KAPPA=1
n: ABMD ARG=d TO=0 KAPPA=1 NOISE=0.1 SEED=12345
r: MOVINGRESTRAINT ARG=d STEP0=0 AT0=0.2 KAPPA0=10 STEP1=100 AT1=0.8 KAPPA1=30
COMMITTOR ARG=d BASIN_LL1=0.5 BASIN_UL1=1.5 NOSTOP FILE=basin
PRINT ARG=d,a.bias,a.d_min,n.bias,n.d_min,r.bias,r.work FILE=COLVAR FMT=%.17g
