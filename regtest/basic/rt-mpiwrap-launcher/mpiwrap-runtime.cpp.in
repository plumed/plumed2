#include <thread_mpi_tmpi.h>

#include "mpiwrap/mpi.h"
#include "mpiwrap.h"
#include "internal.h"

#include <atomic>
#include <cstdlib>
#include <iostream>
#include <mutex>
#include <stdexcept>
#include <string>
#include <thread>
#include <vector>

namespace PLMD {
namespace thread_mpi {
extern "C" const mpiwrap::plumed_mpi_provider *
plumed_mpiw_thread_mpi_provider(void);

namespace mpiwrap_runtime_test {

std::atomic<int> failures{0};
std::atomic<int> ranks_seen{0};
std::mutex failure_output_mutex;

void record_failure(int rank, int line) {
  failures.fetch_add(1);
  std::lock_guard<std::mutex> lock(failure_output_mutex);
  std::cerr << "rank " << rank << " runtime assertion failed at line " << line << '\n';
}

void rank_work(const void *) {
  const MPI_Comm world = mpiwrap::COMM_WORLD();
  const MPI_Datatype integer = mpiwrap::INT();
  const MPI_Op sum = mpiwrap::SUM();
  const MPI_Datatype float_type = mpiwrap::FLOAT();
  const MPI_Datatype double_type = mpiwrap::DOUBLE();
  const MPI_Datatype char_type = mpiwrap::CHAR();
  const MPI_Datatype unsigned_type = mpiwrap::UNSIGNED();
  const MPI_Datatype unsigned_long_type = mpiwrap::UNSIGNED_LONG();
  const MPI_Datatype unsigned_long_long_type = mpiwrap::UNSIGNED_LONG_LONG();
  const MPI_Datatype long_double_type = mpiwrap::LONG_DOUBLE();
  const MPI_Comm null_comm = mpiwrap::COMM_NULL();
  const MPI_Status *ignore_status = mpiwrap::STATUS_IGNORE();
  const MPI_Op product = mpiwrap::PROD();
  const MPI_Op maximum = mpiwrap::MAX();
  const MPI_Op minimum = mpiwrap::MIN();
  int rank = -1;
  int size = 0;
  if (mpiwrap::Comm_rank(world, &rank) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Comm_size(world, &size) != thread_mpi::TMPI_SUCCESS ||
      size < 1 || rank < 0 || rank >= size) {
    record_failure(rank, __LINE__);
    return;
  }
  const MPI_Comm imported_world = mpiwrap::Comm_from_native(&thread_mpi::TMPI_COMM_WORLD);
  int imported_rank = -1;
  int imported_size = 0;
  if (mpiwrap::Comm_rank(imported_world, &imported_rank) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Comm_size(imported_world, &imported_size) != thread_mpi::TMPI_SUCCESS ||
      imported_rank != rank || imported_size != size) {
    record_failure(rank, __LINE__);
  }
  if (mpiwrap::handle_storage_is_zero(float_type.storage) ||
      mpiwrap::handle_storage_is_zero(double_type.storage) ||
      mpiwrap::handle_storage_is_zero(char_type.storage) ||
      mpiwrap::handle_storage_is_zero(unsigned_type.storage) ||
      mpiwrap::handle_storage_is_zero(unsigned_long_type.storage) ||
      mpiwrap::handle_storage_is_zero(unsigned_long_long_type.storage) ||
      mpiwrap::handle_storage_is_zero(long_double_type.storage) ||
      !mpiwrap::handle_storage_is_zero(null_comm.storage) || ignore_status != nullptr || product == sum ||
      maximum == minimum || mpiwrap::ANY_SOURCE() != -1 ||
      mpiwrap::ANY_TAG() != -1) {
    std::cerr << "rank " << rank << " provider constants failed: null-byte="
              << static_cast<unsigned>(null_comm.storage.bytes[0]) << " status-ignore=" << ignore_status
              << " type-handle-bytes=" << static_cast<unsigned>(float_type.storage.bytes[0]) << ','
              << static_cast<unsigned>(double_type.storage.bytes[0])
              << ',' << static_cast<unsigned>(char_type.storage.bytes[0]) << ','
              << static_cast<unsigned>(unsigned_type.storage.bytes[0]) << ','
              << static_cast<unsigned>(unsigned_long_type.storage.bytes[0]) << ','
              << static_cast<unsigned>(unsigned_long_long_type.storage.bytes[0])
              << ',' << static_cast<unsigned>(long_double_type.storage.bytes[0])
              << " op-handle-bytes=" << static_cast<unsigned>(product.storage.bytes[0])
              << ',' << static_cast<unsigned>(maximum.storage.bytes[0]) << ','
              << static_cast<unsigned>(minimum.storage.bytes[0])
              << " any-source=" << mpiwrap::ANY_SOURCE()
              << " any-tag=" << mpiwrap::ANY_TAG() << '\n';
    record_failure(rank, __LINE__);
  }
  int initialized = 0;
  if (mpiwrap::Initialized(&initialized) != thread_mpi::TMPI_SUCCESS || !initialized) {
    record_failure(rank, __LINE__);
  }

  if (mpiwrap::has_Test()) {
    record_failure(rank, __LINE__);
  } else {
    bool unavailable_threw = false;
    try {
      MPI_Request incomplete_request{};
      int test_flag = -1;
      mpiwrap::Test(&incomplete_request, &test_flag, nullptr);
    } catch (const std::runtime_error &) {
      unavailable_threw = true;
    }
    if (!unavailable_threw) {
      record_failure(rank, __LINE__);
    }
  }

  if (mpiwrap::has_Op_create()) {
    record_failure(rank, __LINE__);
  } else {
    bool unavailable_threw = false;
    try {
      mpiwrap::Op_create(nullptr, 1, nullptr);
    } catch (const std::runtime_error &) {
      unavailable_threw = true;
    }
    if (!unavailable_threw) {
      std::cerr << "rank " << rank << " unavailable Op_create did not throw\n";
      record_failure(rank, __LINE__);
    }
  }

  if (mpiwrap::has_Iprobe()) {
    record_failure(rank, __LINE__);
  } else {
    bool unavailable_threw = false;
    try {
      int flag = 0;
      MPI_Status status{};
      mpiwrap::Iprobe(-1, 74, world, &flag, &status);
    } catch (const std::runtime_error &) {
      unavailable_threw = true;
    }
    if (!unavailable_threw) {
      record_failure(rank, __LINE__);
    }
  }

  int input = rank + 1;
  int output = -123;
  if (!mpiwrap::has_Allreduce() ||
      mpiwrap::Allreduce(&input, &output, 1, integer, sum, world) !=
      thread_mpi::TMPI_SUCCESS || output != size * (size + 1) / 2) {
    record_failure(rank, __LINE__);
  }

  int in_place = rank + 1;
  if (mpiwrap::Allreduce(MPI_IN_PLACE, &in_place, 1, integer, sum, world) !=
      thread_mpi::TMPI_SUCCESS || in_place != size * (size + 1) / 2) {
    record_failure(rank, __LINE__);
  }

  auto check_sum = [&](auto value, MPI_Datatype datatype, const char *label) {
    using Value = decltype(value);
    Value reduced{};
    if (mpiwrap::Allreduce(&value, &reduced, 1, datatype, sum, world) !=
        thread_mpi::TMPI_SUCCESS || reduced != static_cast<Value>(size * (size + 1) / 2)) {
      std::cerr << "rank " << rank << " reduction failed: " << label
                << " result=" << reduced << '\n';
      record_failure(rank, __LINE__);
    }
  };
  check_sum(static_cast<float>(rank + 1), float_type, "float");
  check_sum(static_cast<double>(rank + 1), double_type, "double");
  check_sum(static_cast<unsigned>(rank + 1), unsigned_type, "unsigned");
  check_sum(static_cast<unsigned long>(rank + 1), unsigned_long_type, "unsigned long");
  check_sum(static_cast<unsigned long long>(rank + 1), unsigned_long_long_type, "unsigned long long");
  check_sum(static_cast<long double>(rank + 1), long_double_type, "long double");

  int broadcast_value = rank == 0 ? 91 : -1;
  if (mpiwrap::Bcast(&broadcast_value, 1, integer, 0, world) !=
      thread_mpi::TMPI_SUCCESS || broadcast_value != 91 ||
      mpiwrap::Barrier(world) != thread_mpi::TMPI_SUCCESS) {
    record_failure(rank, __LINE__);
  }

  MPI_Comm duplicate{};
  int duplicate_rank = -1;
  int duplicate_size = 0;
  if (mpiwrap::Comm_dup(world, &duplicate) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Comm_rank(duplicate, &duplicate_rank) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Comm_size(duplicate, &duplicate_size) != thread_mpi::TMPI_SUCCESS ||
      duplicate_rank != rank || duplicate_size != size ||
      mpiwrap::Comm_free(&duplicate) != thread_mpi::TMPI_SUCCESS) {
    record_failure(rank, __LINE__);
  }

  MPI_Comm split{};
  int split_rank = -1;
  int split_size = 0;
  if (mpiwrap::Comm_split(world, rank % 2, rank, &split) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Comm_rank(split, &split_rank) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Comm_size(split, &split_size) != thread_mpi::TMPI_SUCCESS ||
      split_size != (size + 1 - (rank % 2)) / 2 || split_rank < 0 ||
      mpiwrap::Comm_free(&split) != thread_mpi::TMPI_SUCCESS) {
    record_failure(rank, __LINE__);
  }

  int gathered_value = rank + 11;
  std::vector<int> gathered(static_cast<std::size_t>(size), -1);
  if (mpiwrap::Gather(&gathered_value, 1, integer,
                      rank == 0 ? gathered.data() : nullptr, 1, integer, 0,
                      world) != thread_mpi::TMPI_SUCCESS) {
    record_failure(rank, __LINE__);
  } else if (rank == 0) {
    for (int i = 0; i < size; ++i) {
      if (gathered[static_cast<std::size_t>(i)] != i + 11) {
        record_failure(rank, __LINE__);
      }
    }
  }

  std::vector<int> scattered(static_cast<std::size_t>(size));
  for (int i = 0; i < size; ++i) {
    scattered[static_cast<std::size_t>(i)] = i + 101;
  }
  int scatter_result = -1;
  if (mpiwrap::Scatter(rank == 0 ? scattered.data() : nullptr, 1, integer,
                       &scatter_result, 1, integer, 0, world) !=
      thread_mpi::TMPI_SUCCESS || scatter_result != rank + 101) {
    record_failure(rank, __LINE__);
  }

  int allgather_input = rank + 21;
  std::vector<int> allgather_output(static_cast<std::size_t>(size), -1);
  if (mpiwrap::Allgather(&allgather_input, 1, integer, allgather_output.data(),
                         1, integer, world) != thread_mpi::TMPI_SUCCESS) {
    record_failure(rank, __LINE__);
  } else {
    for (int i = 0; i < size; ++i) {
      if (allgather_output[static_cast<std::size_t>(i)] != i + 21) {
        record_failure(rank, __LINE__);
      }
    }
  }

  std::vector<int> recvcounts(static_cast<std::size_t>(size));
  std::vector<int> displacements(static_cast<std::size_t>(size));
  int total_variable = size + size - 1;
  for (int i = 0; i < size; ++i) {
    recvcounts[static_cast<std::size_t>(i)] = i + 1;
    displacements[static_cast<std::size_t>(i)] = i * (i + 1) / 2 + i;
    total_variable += i;
  }
  std::vector<int> variable_input(static_cast<std::size_t>(rank + 1), rank + 31);
  std::vector<int> variable_output(static_cast<std::size_t>(total_variable), -99);
  if (mpiwrap::Allgatherv(variable_input.data(), rank + 1, integer,
                          variable_output.data(), recvcounts.data(),
                          displacements.data(), integer, world) !=
      thread_mpi::TMPI_SUCCESS) {
    record_failure(rank, __LINE__);
  } else {
    for (int i = 0; i < size; ++i) {
      for (int j = 0; j < i + 1; ++j) {
        if (variable_output[static_cast<std::size_t>(displacements[static_cast<std::size_t>(i)] + j)] != i + 31) {
          record_failure(rank, __LINE__);
        }
      }
      const int next_displacement = i + 1 < size ?
                                    displacements[static_cast<std::size_t>(i + 1)] :
                                    total_variable;
      for (int gap = displacements[static_cast<std::size_t>(i)] + i + 1;
           gap < next_displacement; ++gap) {
        if (variable_output[static_cast<std::size_t>(gap)] != -99) {
          record_failure(rank, __LINE__);
        }
      }
    }
  }

  std::vector<int> inplace_output(static_cast<std::size_t>(total_variable), -99);
  for (int i = 0; i < rank + 1; ++i) {
    inplace_output[static_cast<std::size_t>(displacements[static_cast<std::size_t>(rank)] + i)] = rank + 51;
  }
  if (mpiwrap::Allgatherv(MPI_IN_PLACE, -7, integer, inplace_output.data(),
                          recvcounts.data(), displacements.data(), integer,
                          world) != thread_mpi::TMPI_SUCCESS) {
    record_failure(rank, __LINE__);
  } else {
    for (int i = 0; i < size; ++i) {
      for (int j = 0; j < i + 1; ++j) {
        if (inplace_output[static_cast<std::size_t>(displacements[static_cast<std::size_t>(i)] + j)] != i + 51) {
          record_failure(rank, __LINE__);
        }
      }
      const int next_displacement = i + 1 < size ?
                                    displacements[static_cast<std::size_t>(i + 1)] :
                                    total_variable;
      for (int gap = displacements[static_cast<std::size_t>(i)] + i + 1;
           gap < next_displacement; ++gap) {
        if (inplace_output[static_cast<std::size_t>(gap)] != -99) {
          record_failure(rank, __LINE__);
        }
      }
    }
  }

  const int next = (rank + 1) % size;
  const int previous = (rank + size - 1) % size;
  int ring_value = -1;
  MPI_Request receive_request{};
  MPI_Request send_request{};
  MPI_Status receive_status{};
  if (!mpiwrap::has_Irecv() || !mpiwrap::has_Isend() || !mpiwrap::has_Wait() ||
      !mpiwrap::has_Get_count() ||
      mpiwrap::Irecv(&ring_value, 1, integer, previous, 73, world,
                     &receive_request) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Isend(&input, 1, integer, next, 73, world,
                     &send_request) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Wait(&receive_request, &receive_status) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Wait(&send_request, MPI_STATUS_IGNORE) != thread_mpi::TMPI_SUCCESS) {
    record_failure(rank, __LINE__);
  } else {
    int received_count = -1;
    if (ring_value != previous + 1 || receive_status.MPI_SOURCE != previous ||
        receive_status.MPI_TAG != 73 ||
        mpiwrap::Get_count(&receive_status, integer, &received_count) !=
        thread_mpi::TMPI_SUCCESS || received_count != 1) {
      record_failure(rank, __LINE__);
    }
  }

  int sendrecv_value = input;
  int sendrecv_result = -1;
  MPI_Status sendrecv_status{};
  if (mpiwrap::Sendrecv(&sendrecv_value, 1, integer, next, 74,
                        &sendrecv_result, 1, integer, previous, 74, world,
                        &sendrecv_status) != thread_mpi::TMPI_SUCCESS ||
      sendrecv_result != previous + 1 || sendrecv_status.MPI_SOURCE != previous ||
      sendrecv_status.MPI_TAG != 74) {
    record_failure(rank, __LINE__);
  }

  int blocking_input = rank + 61;
  int blocking_output = -1;
  MPI_Request blocking_send{};
  MPI_Status blocking_status{};
  if (mpiwrap::Isend(&blocking_input, 1, integer, next, 75, world,
                     &blocking_send) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Recv(&blocking_output, 1, integer, previous, 75, world,
                    &blocking_status) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Wait(&blocking_send, MPI_STATUS_IGNORE) != thread_mpi::TMPI_SUCCESS ||
      blocking_output != previous + 61 || blocking_status.MPI_SOURCE != previous ||
      blocking_status.MPI_TAG != 75) {
    record_failure(rank, __LINE__);
  }

  // Ready sends are valid here because every rank posts its matching receive
  // before entering the blocking send.
  int ready_input = rank + 121;
  int ready_output = -1;
  MPI_Request ready_receive{};
  MPI_Status ready_status{};
  const bool ready_available = mpiwrap::has_Rsend();
  const int ready_irecv_result = mpiwrap::Irecv(
                                   &ready_output, 1, integer, previous, 81,
                                   world, &ready_receive);
  const int ready_barrier_result = ready_irecv_result == thread_mpi::TMPI_SUCCESS ?
                                   mpiwrap::Barrier(world) : -1;
  const int ready_send_result =
    ready_available && ready_irecv_result == thread_mpi::TMPI_SUCCESS &&
    ready_barrier_result == thread_mpi::TMPI_SUCCESS ?
    mpiwrap::Rsend(&ready_input, 1, integer, next,
                   81, world) : -1;
  const int ready_wait_result = ready_irecv_result == thread_mpi::TMPI_SUCCESS ?
                                mpiwrap::Wait(&ready_receive, &ready_status) : -1;
  if (!ready_available || ready_irecv_result != thread_mpi::TMPI_SUCCESS ||
      ready_barrier_result != thread_mpi::TMPI_SUCCESS ||
      ready_send_result != thread_mpi::TMPI_SUCCESS ||
      ready_wait_result != thread_mpi::TMPI_SUCCESS ||
      ready_output != previous + 121 || ready_status.MPI_SOURCE != previous ||
      ready_status.MPI_TAG != 81 ||
      !mpiwrap::handle_storage_is_zero(ready_receive.storage)) {
    std::cerr << "rank " << rank << " ready-send posted-receive semantics failed: "
              << "available=" << ready_available << " results="
              << ready_irecv_result << ',' << ready_barrier_result << ','
              << ready_send_result << ','
              << ready_wait_result << " value=" << ready_output << " status="
              << ready_status.MPI_SOURCE << ':' << ready_status.MPI_TAG
              << " request=" << static_cast<unsigned>(ready_receive.storage.bytes[0])
              << '\n';
    record_failure(rank, __LINE__);
  }

  // The nonblocking ready send also follows a posted matching receive. Wait
  // on both requests to verify ordinary Isend request/completion behavior.
  int iready_input = rank + 131;
  int iready_output = -1;
  MPI_Request iready_receive{};
  MPI_Request iready_send{};
  MPI_Status iready_status{};
  const bool iready_available = mpiwrap::has_Irsend();
  const int iready_irecv_result = mpiwrap::Irecv(
                                    &iready_output, 1, integer, previous, 82,
                                    world, &iready_receive);
  const int iready_barrier_result =
    iready_irecv_result == thread_mpi::TMPI_SUCCESS ? mpiwrap::Barrier(world) : -1;
  const int iready_send_result =
    iready_available && iready_irecv_result == thread_mpi::TMPI_SUCCESS &&
    iready_barrier_result == thread_mpi::TMPI_SUCCESS ?
    mpiwrap::Irsend(&iready_input, 1, integer, next,
                    82, world, &iready_send) : -1;
  const int iready_receive_wait_result =
    iready_irecv_result == thread_mpi::TMPI_SUCCESS ?
    mpiwrap::Wait(&iready_receive, &iready_status) : -1;
  const int iready_send_wait_result = iready_send_result == thread_mpi::TMPI_SUCCESS ?
                                      mpiwrap::Wait(&iready_send, MPI_STATUS_IGNORE) : -1;
  if (!iready_available || iready_irecv_result != thread_mpi::TMPI_SUCCESS ||
      iready_barrier_result != thread_mpi::TMPI_SUCCESS ||
      iready_send_result != thread_mpi::TMPI_SUCCESS ||
      iready_receive_wait_result != thread_mpi::TMPI_SUCCESS ||
      iready_send_wait_result != thread_mpi::TMPI_SUCCESS ||
      iready_output != previous + 131 || iready_status.MPI_SOURCE != previous ||
      iready_status.MPI_TAG != 82 ||
      !mpiwrap::handle_storage_is_zero(iready_receive.storage) ||
      !mpiwrap::handle_storage_is_zero(iready_send.storage)) {
    std::cerr << "rank " << rank << " nonblocking ready-send request completion failed: "
              << "available=" << iready_available << " results="
              << iready_irecv_result << ',' << iready_barrier_result << ','
              << iready_send_result << ','
              << iready_receive_wait_result << ',' << iready_send_wait_result
              << " value=" << iready_output << " status="
              << iready_status.MPI_SOURCE << ':' << iready_status.MPI_TAG
              << " requests="
              << static_cast<unsigned>(iready_receive.storage.bytes[0]) << ','
              << static_cast<unsigned>(iready_send.storage.bytes[0]) << '\n';
    record_failure(rank, __LINE__);
  }

  int waitall_recv0 = -1;
  int waitall_recv1 = -1;
  int waitall_send0 = rank + 81;
  int waitall_send1 = rank + 91;
  MPI_Request waitall_requests[4] {};
  MPI_Status waitall_statuses[4] {};
  if (mpiwrap::Irecv(&waitall_recv0, 1, integer, previous, 76, world,
                     &waitall_requests[0]) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Irecv(&waitall_recv1, 1, integer, previous, 77, world,
                     &waitall_requests[1]) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Isend(&waitall_send0, 1, integer, next, 76, world,
                     &waitall_requests[2]) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Isend(&waitall_send1, 1, integer, next, 77, world,
                     &waitall_requests[3]) != thread_mpi::TMPI_SUCCESS ||
      mpiwrap::Waitall(4, waitall_requests, waitall_statuses) !=
      thread_mpi::TMPI_SUCCESS || waitall_recv0 != previous + 81 ||
      waitall_recv1 != previous + 91 ||
      !mpiwrap::handle_storage_is_zero(waitall_requests[0].storage) ||
      !mpiwrap::handle_storage_is_zero(waitall_requests[1].storage) ||
      !mpiwrap::handle_storage_is_zero(waitall_requests[2].storage) ||
      !mpiwrap::handle_storage_is_zero(waitall_requests[3].storage) ||
      waitall_statuses[0].MPI_SOURCE != previous ||
      waitall_statuses[0].MPI_TAG != 76 ||
      waitall_statuses[1].MPI_SOURCE != previous ||
      waitall_statuses[1].MPI_TAG != 77) {
    std::cerr << "rank " << rank << " Waitall array semantics failed: received="
              << waitall_recv0 << ',' << waitall_recv1 << " requests="
              << static_cast<unsigned>(waitall_requests[0].storage.bytes[0]) << ','
              << static_cast<unsigned>(waitall_requests[1].storage.bytes[0]) << ','
              << static_cast<unsigned>(waitall_requests[2].storage.bytes[0]) << ','
              << static_cast<unsigned>(waitall_requests[3].storage.bytes[0])
              << " statuses=" << waitall_statuses[0].MPI_SOURCE << ':'
              << waitall_statuses[0].MPI_TAG << ',' << waitall_statuses[1].MPI_SOURCE
              << ':' << waitall_statuses[1].MPI_TAG << '\n';
    record_failure(rank, __LINE__);
  }

  ranks_seen.fetch_add(1);
}

int run(int ranks) {
  std::string error;
  auto &registry = mpiwrap::currentRegistry();
  if (!registry.install(plumed_mpiw_thread_mpi_provider(), error)) {
    std::cerr << "provider install failed: " << error << '\n';
    return 1;
  }
  // The stable tMPI surface lacks MPI_Test; ensure no provider entry leaked
  // into the shared pointer table before starting concurrent rank callbacks.
  if (mpiwrap::pointers::Test != nullptr) {
    std::cerr << "tMPI provider unexpectedly published MPI_Test\n";
    return 1;
  }
  if (!mpiwrap::has_Comm_rank() || !mpiwrap::has_Comm_size() ||
      !mpiwrap::has_Bcast() || !mpiwrap::has_Allreduce() ||
      !mpiwrap::has_Barrier() || !mpiwrap::has_Irecv() ||
      !mpiwrap::has_Isend() || !mpiwrap::has_Wait() ||
      !mpiwrap::has_Get_count() || !mpiwrap::has_Sendrecv() ||
      !mpiwrap::has_Send() || !mpiwrap::has_Rsend() || !mpiwrap::has_Irsend() ||
      !mpiwrap::has_Initialized() || !mpiwrap::has_Comm_dup() ||
      !mpiwrap::has_Comm_free() || !mpiwrap::has_Comm_split() ||
      !mpiwrap::has_Abort() || !mpiwrap::has_Recv() || !mpiwrap::has_Scatter() ||
      !mpiwrap::has_Gather() || !mpiwrap::has_Allgather() ||
      !mpiwrap::has_Allgatherv()) {
    std::cerr << "required tMPI provider entries missing\n";
    return 1;
  }
  if (!mpiwrap::has_Waitall() || mpiwrap::has_Waitsome() ||
      mpiwrap::has_Testsome() || mpiwrap::has_Testall()) {
    std::cerr << "tMPI request-array capabilities are inconsistent\n";
    return 1;
  }
  MPI_Request unavailable_request = mpiwrap::REQUEST_NULL();
  int unavailable_outcount = -1;
  int unavailable_index = -1;
  MPI_Status unavailable_status{};
  const auto expect_request_function_unavailable = [&](const char *name, auto call) {
    try {
      call();
    } catch (const std::runtime_error &error) {
      if (std::string(error.what()).find(name) != std::string::npos) {
        return true;
      }
      std::cerr << name << " unavailable diagnostic omitted function name: "
                << error.what() << '\n';
    }
    return false;
  };
  if (!expect_request_function_unavailable("MPI_Waitsome", [&] {
  mpiwrap::Waitsome(1, &unavailable_request, &unavailable_outcount,
                    &unavailable_index, &unavailable_status);
  }) ||
  !expect_request_function_unavailable("MPI_Testsome", [&] {
    mpiwrap::Testsome(1, &unavailable_request, &unavailable_outcount,
                      &unavailable_index, &unavailable_status);
  })) {
    std::cerr << "tMPI exposed an unsupported request-array function\n";
    return 1;
  }
  if (mpiwrap::has_Bsend() || mpiwrap::has_Ssend() || mpiwrap::has_Issend()) {
    std::cerr << "unsupported buffered or synchronous send mode was exposed\n";
    return 1;
  }
  const auto expect_send_mode_unavailable = [](const char *name, auto call) {
    try {
      call();
    } catch (const std::runtime_error &error) {
      if (std::string(error.what()).find(name) != std::string::npos) {
        return true;
      }
      std::cerr << name << " unavailable diagnostic omitted function name: "
                << error.what() << '\n';
    }
    return false;
  };
  const MPI_Comm world = mpiwrap::COMM_WORLD();
  const MPI_Datatype integer = mpiwrap::INT();
  MPI_Request unsupported_request{};
  if (!expect_send_mode_unavailable("MPI_Bsend", [&]() {
  mpiwrap::Bsend(nullptr, 0, integer, 0, 0, world);
  }) ||
  !expect_send_mode_unavailable("MPI_Ssend", [&]() {
    mpiwrap::Ssend(nullptr, 0, integer, 0, 0, world);
  }) ||
  !expect_send_mode_unavailable("MPI_Issend", [&]() {
    mpiwrap::Issend(nullptr, 0, integer, 0, 0, world,
                    &unsupported_request);
  })) {
    std::cerr << "unsupported send mode did not fail cleanly\n";
    return 1;
  }
  bool testall_threw = false;
  try {
    int flag = 0;
    MPI_Request requests[1] {};
    (void)mpiwrap::Testall(1, requests, &flag, nullptr);
  } catch (const std::runtime_error &) {
    testall_threw = true;
  }
  if (!testall_threw) {
    std::cerr << "unavailable tMPI Testall did not throw\n";
    return 1;
  }
  MPI_Comm imported_world = mpiwrap::Comm_from_native(&thread_mpi::TMPI_COMM_WORLD);
  mpiwrap::plumed_mpi_handle_storage exported_world{};
  if (!mpiwrap::Comm_export_storage(imported_world, &exported_world) ||
      std::memcmp(&exported_world, &imported_world.storage,
                  sizeof(exported_world)) != 0) {
    std::cerr << "public native communicator import/export failed\n";
    return 1;
  }
  alignas(std::max_align_t)
  unsigned char native_world[sizeof(mpiwrap::plumed_mpi_handle_storage)] {};
  MPI_Comm native_roundtrip{};
  if (mpiwrap::Comm_export_native(imported_world, native_world,
                                  sizeof(native_world))) {
    native_roundtrip = mpiwrap::Comm_from_native(native_world);
  }
  if (native_roundtrip != imported_world) {
    std::cerr << "public native communicator byte export/import failed\n";
    return 1;
  }
  if (mpiwrap::has_Init()) {
    std::cerr << "unimplemented tMPI call reported as available\n";
    return 1;
  }
  try {
    (void)mpiwrap::Init(nullptr, nullptr);
    std::cerr << "unimplemented tMPI call did not throw\n";
    return 1;
  } catch (const std::runtime_error &error) {
    const char *description = plumed_mpiw_thread_mpi_provider()->description;
    if (std::string(error.what()).find("MPI_Init") == std::string::npos ||
        (description && std::string(error.what()).find(description) == std::string::npos)) {
      std::cerr << "unavailable diagnostic omitted function/provider identity: "
                << error.what() << '\n';
      return 1;
    }
  }
  if (thread_mpi::tMPI_Init_fn(0, ranks, thread_mpi::TMPI_AFFINITY_NONE,
                               rank_work, nullptr) != thread_mpi::TMPI_SUCCESS) {
    return 1;
  }
  int finalized = 0;
  if (thread_mpi::tMPI_Finalized(&finalized) != thread_mpi::TMPI_SUCCESS ||
      !finalized || ranks_seen.load() != ranks || failures.load() != 0) {
    std::cerr << "MPI wrapper rank checks failed: seen=" << ranks_seen.load()
              << " expected=" << ranks << " failures=" << failures.load()
              << " finalized=" << finalized << '\n';
    return 1;
  }
  return 0;
}

} // namespace mpiwrap_runtime_test
} // namespace thread_mpi
} // namespace PLMD

int main(int argc, char **argv) {
  if (argc != 2) {
    return 2;
  }
  const int ranks = std::atoi(argv[1]);
  if (ranks < 1 || ranks > 4) {
    return 2;
  }
  return PLMD::thread_mpi::mpiwrap_runtime_test::run(ranks);
}
