#include <tmpi.h>

#include <atomic>

namespace PLMD {
namespace thread_mpi {
namespace internal_copy {

std::atomic<int> visited{0};
std::atomic<int> failures{0};

void rank_work(const void *) {
  int rank = -1;
  int size = 0;
  if (thread_mpi::tMPI_Comm_rank(thread_mpi::TMPI_COMM_WORLD, &rank) !=
      thread_mpi::TMPI_SUCCESS ||
      thread_mpi::tMPI_Comm_size(thread_mpi::TMPI_COMM_WORLD, &size) !=
      thread_mpi::TMPI_SUCCESS || size != 2 || rank < 0 || rank >= size) {
    failures.fetch_add(1);
  }
  visited.fetch_add(1);
}

int run() {
  if (thread_mpi::tMPI_Init_fn(0, 2, thread_mpi::TMPI_AFFINITY_NONE,
                               rank_work, nullptr) != thread_mpi::TMPI_SUCCESS) {
    return 1;
  }
  int finalized = 0;
  return failures.load() == 0 && visited.load() == 2 &&
         thread_mpi::tMPI_Finalized(&finalized) == thread_mpi::TMPI_SUCCESS && finalized ? 0 : 1;
}

} // namespace internal_copy
} // namespace thread_mpi
} // namespace PLMD
