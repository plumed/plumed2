# a file rewritten at every write (GRID_WFILE), and an action whose state is not stored in the checkpoint yet (COMMITTOR)
CHECKPOINT FILE=plumed.cpt
d1: DISTANCE ATOMS=1,2
cm: COMMITTOR ARG=d1 BASIN_LL1=100 BASIN_UL1=101 NOSTOP
m: METAD ARG=d1 PACE=5 HEIGHT=1 SIGMA=0.1 GRID_MIN=0 GRID_MAX=5 GRID_WFILE=GRID GRID_WSTRIDE=5 FILE=HILLS
PRINT ARG=d1,m.bias FILE=COLVAR_METAD STRIDE=1
