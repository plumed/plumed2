type=driver
# Reference run: the whole trajectory, with the checkpointing signal every 10 steps
arg="--plumed plumed.dat --ixyz traj.xyz --checkpoint-stride 10"

function plumed_regtest_before() {
  # a trajectory of 60 frames of 4 atoms (analytic positions)
  awk 'BEGIN{for(f=0;f<60;f++){print 4; print "10 10 10"; for(i=0;i<4;i++){printf "X %f %f %f\n", i+0.5*sin(0.1*f+i), 0.3*cos(0.07*f*(i+1)), 0.2*i*f/60.0}}}' > traj.xyz
  # the first 25 frames: the interrupted run
  head -n 150 traj.xyz > part.xyz

  # A) checkpoints requested by the "MD engine" (driver --checkpoint-stride) at
  # steps 0, 10 and 20, then the restart from the last one with the whole
  # trajectory: the driver skips the frames before step 20 and presents step 20 again
  mkdir restart
  cd restart
  cp ../plumed.dat .
  $plumed driver --plumed plumed.dat --ixyz ../part.xyz --checkpoint-stride 10 > out1 2> err1
  $plumed driver --plumed plumed.dat --ixyz ../traj.xyz --checkpoint-stride 10 --restart-from-checkpoint plumed.cpt > out2 2> err2
  cd ..

  # B) checkpoints every 7 steps from the STRIDE keyword (no signal from the engine); the run also
  # writes plumed_final.cpt (step 25), but the restart is from step 21, so AUTO reads plumed.cpt
  mkdir restart-stride
  cd restart-stride
  sed 's/^CHECKPOINT.*/CHECKPOINT FILE=plumed.cpt STRIDE=7/' ../plumed.dat > plumed.dat
  $plumed driver --plumed plumed.dat --ixyz ../part.xyz > out1 2> err1
  $plumed driver --plumed plumed.dat --ixyz ../traj.xyz --restart-from-checkpoint plumed.cpt > out2 2> err2
  cd ..

  # D) a
  # file rewritten at every write (not truncated)
  mkdir metad
  cd metad
  cp ../plumed-metad.dat plumed.dat
  $plumed driver --plumed plumed.dat --ixyz ../part.xyz --checkpoint-stride 10 > out1 2> err1
  $plumed driver --plumed plumed.dat --ixyz ../traj.xyz --checkpoint-stride 10 --restart-from-checkpoint plumed.cpt > out2 2> err2
  # the global RESTART NO contradicts the restart from the checkpoint (error; the files are already trimmed by CHECKPOINT)
  sed 's/^CHECKPOINT.*/&\nRESTART NO/' plumed.dat > plumed-global-no.dat
  $plumed driver --plumed plumed-global-no.dat --ixyz ../traj.xyz --checkpoint-stride 10 --restart-from-checkpoint plumed.cpt > out4 2> err4
  # E) per-action RESTART=NO at a checkpoint restart: METAD starts from scratch at
  # the restart step (its files are trimmed, then backed up), the rest continues
  sed 's/FILE=HILLS/FILE=HILLS RESTART=NO/' plumed.dat > plumed-no.dat
  $plumed driver --plumed plumed-no.dat --ixyz ../traj.xyz --checkpoint-stride 10 --restart-from-checkpoint plumed.cpt > out3 2> err3
  cd ..

  # (the lists of files are sorted with LC_ALL=C: the order of ls depends on the locale)
  # F) no checkpointing signal and no STRIDE: the checkpoint written at the end of the
  # run (runFinalJobs) is the one of the next step, 25; the restart from it presents step 25
  mkdir final
  cd final
  cp ../plumed.dat .
  $plumed driver --plumed plumed.dat --ixyz ../part.xyz > out1 2> err1
  ls *.cpt | LC_ALL=C sort > cpt_files1
  # RESTART_FROM=AUTO reads plumed_final.cpt (it exists and is for the restart step), which is
  # then backed up; the new one is for step 60
  $plumed driver --plumed plumed.dat --ixyz ../traj.xyz --restart-from-checkpoint plumed_final.cpt > out2 2> err2
  ls *.cpt | LC_ALL=C sort > cpt_files2
  cd ..
  # with the signal (A), no final checkpoint is written
  ls restart/*.cpt | LC_ALL=C sort > restart/cpt_files

  # C) errors: the engine presents a step different from the one of the checkpoint
  mkdir wrong-step
  cd wrong-step
  cp ../restart/plumed.cpt ../restart/COLVAR ../restart/COLVAR2 .
  sed 's/^CHECKPOINT.*/CHECKPOINT FILE=plumed.cpt RESTART_FROM=plumed.cpt/' ../plumed.dat > plumed.dat
  $plumed driver --plumed plumed.dat --ixyz ../traj.xyz --restart > out1 2> err1
  # the checkpoint step is not in the trajectory
  $plumed driver --plumed plumed.dat --ixyz ../traj.xyz --restart-from-checkpoint plumed.cpt --initial-step 100 > out2 2> err2
  # a file was modified after the checkpoint (same size, different content)
  sed 's/ 49.000000/ 49.100000/' COLVAR > COLVAR.tmp && mv COLVAR.tmp COLVAR
  $plumed driver --plumed plumed.dat --ixyz ../traj.xyz --restart-from-checkpoint plumed.cpt > out3 2> err3
  cd ..
}

function plumed_regtest_after() {
  # the restarted runs must reproduce the reference bitwise
  for d in restart restart-stride ; do
    for f in COLVAR COLVAR2 ; do
      if cmp $f $d/$f ; then echo "$d/$f IDENTICAL" ; else echo "$d/$f DIFFERENT" ; fi
    done
    # the files of the interrupted run have been trimmed and the state restored
    grep -h "truncated\|Checkpoint state restored\|Restarting from checkpoint" $d/out2 | sed 's/by PLUMED.*//' | sed 's/ from [0-9]* to [0-9]* bytes//'
  done > restart_check
  for f in COLVAR COLVAR2 ; do
    if cmp $f final/$f ; then echo "final/$f IDENTICAL" ; else echo "final/$f DIFFERENT" ; fi
  done >> restart_check
  cat final/cpt_files1 final/cpt_files2 restart/cpt_files >> restart_check
  ls final/bck.* | LC_ALL=C sort >> restart_check
  grep -h "reading the checkpoint" restart-stride/out2 >> restart_check
  grep -h "Checkpoint written\|final checkpoint" final/out1 final/out2 >> restart_check
  grep -h "Checkpoint state restored\|^PLUMED: Restarting from checkpoint\|reading the checkpoint" final/out2 | sed 's/by PLUMED.*//' >> restart_check
  grep -h "truncated\|not truncated\|Checkpoint state restored" metad/out2 | sed 's/ from [0-9]* to [0-9]* bytes//' >> restart_check
  grep -h "truncated\|RESTART=NO\|Checkpoint state restored" metad/out3 | sed 's/ from [0-9]* to [0-9]* bytes//' >> restart_check
  # HILLS was backed up (trimmed at the checkpoint) and the new one starts at the restart step
  ls metad/bck.*.HILLS >> restart_check
  tail -n 1 metad/bck.0.HILLS | awk '{print "last hill of the backup at time",$1}' >> restart_check
  grep -v "^#" metad/HILLS | head -n 1 | awk '{print "first hill of the new file at time",$1}' >> restart_check
  grep -h "cannot be used when restarting from a checkpoint" metad/err4 | head -n 1 | sed 's/^ERROR : in input for command line tool driver : //' >> restart_check
  # the error messages (the lines around them depend on PLUMED_STACK_TRACE)
  for i in 1 2 3 ; do
    grep -h "do not refer to the same step\|not in the trajectory\|differs from the one recorded" wrong-step/err$i | head -n 1 | sed 's/^ERROR : in input for command line tool driver : //' >> restart_check
  done
  # content of the last checkpoint of A (the state of mr is left out: its last digits depend on the platform)
  $plumed checkpoint --dump restart/plumed.cpt | grep -v "written by\|^actions/mr/" > cpt_dump
}
