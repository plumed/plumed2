#define PLUMED_MPIW_ABI_ONLY 1
#include "mpiwrap.h"

#include <cstdlib>
#include <fstream>

namespace {
plumed_mpi_provider descriptor{};
struct UnloadMarker {
  ~UnloadMarker() {
    const char *path=std::getenv("MPIW_TEST_PROVIDER_MARKER");
    if(path) {
      std::ofstream output(path);
      output << "unloaded\n";
    }
  }
} unload_marker;
}

extern "C" const plumed_mpi_provider *plumed_mpiw_provider_factory() {
  return &descriptor;
}
