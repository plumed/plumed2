UNITS LENGTH=A
MOLINFO STRUCTURE=ref.pdb WHOLE

# No WHOLEMOLECULES: each action must reconstruct its own coordinates.
# Atom order 1,2,3,4 is deliberately different from tree order 1,3,4,2.
g: GYRATION ATOMS=1-4
c: CENTER ATOMS=1-4
r: RMSD REFERENCE=ref.pdb

# Also exercise local tree indexes with a reordered subset and another anchor.
gsub: GYRATION ATOMS=4,1,3
csub: CENTER ATOMS=4,1,3

# These retain the split coordinates and must give different results.
gbroken: GYRATION ATOMS=1-4 NOPBC
cbroken: CENTER ATOMS=1-4 NOPBC

PRINT ARG=g,c.x,c.y,c.z,r,gsub,csub.x,gbroken,cbroken.x FILE=COLVAR FMT=%.8f
