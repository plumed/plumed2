c:   COORDINATION GROUPA=1 GROUPB=2 SWITCH={CUSTOM R_0=1.3 D_MAX=2.6 FUNC=1-x}
ca:  COORDINATION GROUPA=1 GROUPB=2 SWITCH={CUSTOM R_0=1.3 D_MAX=2.6 FUNC=1-abs(x)}
c2:  COORDINATION GROUPA=1 GROUPB=2 SWITCH={CUSTOM R_0=1.3 D_MAX=2.6 FUNC=1-x2}
ca2: COORDINATION GROUPA=1 GROUPB=2 SWITCH={CUSTOM R_0=1.3 D_MAX=2.6 FUNC=1-abs(x2)}

PRINT ARG=c,ca,c2,ca2 FILE=COLVAR FMT=%8.4f
DUMPDERIVATIVES ARG=c,ca,c2,ca2 FILE=deriv FMT=%8.4f
