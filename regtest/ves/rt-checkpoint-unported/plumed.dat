CHECKPOINT FILE=plumed.cpt
d1: DISTANCE ATOMS=1,2 NOPBC
bf1: BF_FOURIER ORDER=5 MINIMUM=-pi MAXIMUM=pi
VES_LINEAR_EXPANSION ...
 ARG=d1
 BASIS_FUNCTIONS=bf1
 LABEL=ves1
 TEMP=300.0
 GRID_BINS=100
... VES_LINEAR_EXPANSION
OPT_AVERAGED_SGD ...
  BIAS=ves1
  STRIDE=10
  LABEL=o1
  STEPSIZE=1.0
  COEFFS_FILE=coeffs.data
... OPT_AVERAGED_SGD
PRINT ARG=d1,ves1.bias FILE=COLVAR STRIDE=1
