type=driver
plumed_modules=ves
# The VES biases and optimizers do not store their state in the checkpoint yet (they restart from their own
# coefficient files): the checkpoint lists them in a warning, and their files are still trimmed
arg="--plumed plumed.dat --ixyz traj.xyz --checkpoint-stride 10"

function plumed_regtest_before() {
  awk 'BEGIN{for(f=0;f<30;f++){print 4; print "10 10 10"; for(i=0;i<4;i++){printf "X %f %f %f\n", i+0.5*sin(0.1*f+i), 0.3*cos(0.07*f*(i+1)), 0.2*i*f/60.0}}}' > traj.xyz
}

function plumed_regtest_after() {
  grep -h "WARNING: the following actions" out | sed 's/^PLUMED: //' > restart_check
}
include ../../scripts/test.make
