phi: TORSION ATOMS=5,7,9,15 NOPBC
psi: TORSION ATOMS=7,9,15,17 NOPBC
bf1: BF_FOURIER ORDER=5 MINIMUM=-pi MAXIMUM=pi
ves1: VES_LINEAR_EXPANSION ARG=phi BASIS_FUNCTIONS=bf1 TEMP=300.0 GRID_BINS=100
ves2: VES_LINEAR_EXPANSION ARG=psi BASIS_FUNCTIONS=bf1 TEMP=300.0 GRID_BINS=100
OPT_ADAM ...
  BIAS=ves1,ves2
  STRIDE=1000
  LABEL=o1
  STEPSIZE=0.001
  COEFFS_FILE=coeffs.ves1.data,coeffs.ves2.data
  COEFFS_OUTPUT=1
  COEFFS_FMT=%12.6f
... OPT_ADAM
