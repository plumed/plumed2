phi: TORSION ATOMS=5,7,9,15 NOPBC
bf1: BF_FOURIER ORDER=5 MINIMUM=-pi MAXIMUM=pi
ves1: VES_LINEAR_EXPANSION ARG=phi BASIS_FUNCTIONS=bf1 TEMP=300.0 GRID_BINS=100
OPT_ADAM ...
  BIAS=ves1
  STRIDE=1000
  LABEL=o1
  STEPSIZE=0.001
  COEFFS_FILE=coeffs.single.data
  COEFFS_OUTPUT=1
  COEFFS_FMT=%12.6f
... OPT_ADAM
