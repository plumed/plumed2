# exact restart of DRR (2D with CZAR, 1D without CZAR and with reflecting walls) from the checkpoint: see config
CHECKPOINT FILE=plumed.cpt
d1: DISTANCE ATOMS=1,2
d2: DISTANCE ATOMS=3,4
eabf1: DRR ARG=d1,d2 GRID_MIN=0,0 GRID_MAX=3,3 GRID_BIN=6,6 OUTPUTFREQ=10 FRICTION=2.0,2.0 TAU=0.1,0.1 FULLSAMPLES=2 TEMP=300 TEXTOUTPUT FMT=%.17g
eabf2: DRR ARG=d1 GRID_MIN=0 GRID_MAX=3 GRID_BIN=6 OUTPUTFREQ=10 FRICTION=1.0 TAU=0.1 FULLSAMPLES=2 TEMP=300 NOCZAR REFLECTINGWALL=1 TEXTOUTPUT FMT=%.17g
PRINT ARG=eabf1.*,eabf2.* FILE=COLVAR STRIDE=1 FMT=%.17g
