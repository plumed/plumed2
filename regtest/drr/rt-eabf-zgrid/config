type=driver
plumed_needs="drr:boost_serialization"
plumed_modules=drr
arg="--plumed plumed.dat --trajectory-stride 1 --timestep 0.005 --ixyz ala12_trajectory.xyz --dump-forces forces --dump-forces-fmt=%10.6f"

# The UI gradients are printed with 6 decimals on values of order 1e4-1e5,
# so the last digit can round differently across compilers/CPUs (seen on macOS).
plumed_tolerance=(
  "eabf.UI.grad:1e-5"
  "eabf.UI.hist.grad:1e-5"
)
