type=driver
plumed_needs="drr:boost_serialization"
plumed_modules=drr
arg="--plumed plumed.dat --trajectory-stride 1 --timestep 0.005 --ixyz ala12_trajectory.xyz --dump-forces forces --dump-forces-fmt=%10.6f"

# the UI estimator writes the gradients with 6 decimals (~11 significant digits):
# the last digit depends on rounding (e.g. fused multiply-adds on arm64), so compare 3 decimals
function plumed_regtest_after(){
  for f in eabf.UI.grad eabf.UI.hist.grad ; do
    awk '/^#/ || NF==0 {print; next} {for(i=1;i<=NF;i++) printf "%s%.3f", (i>1?" ":""), $i; printf "\n"}' $f > $f.tmp && mv $f.tmp $f
  done
}
