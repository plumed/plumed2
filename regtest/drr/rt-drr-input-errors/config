plumed_needs=boost_serialization
plumed_modules=drr
type=driver
export PLUMED_STACK_TRACE=no
arg="--plumed plumed.dat --trajectory-stride 1 --timestep 0.005 --ixyz trajectory.xyz"
extra_files="../../trajectories/trajectory.xyz"
driver_args="--timestep 0.005 --ixyz trajectory.xyz"

# inputs found by .ci/audit-inputs.py: they crashed (segmentation fault or floating point exception)
function expect_error(){
# expect_error "description" "plumed input" : the input should fail; the message is recorded
  local what="$1"
  echo "$2" > bad.dat
  $plumed_nompi driver $driver_args --plumed bad.dat > bad.out 2>&1
  local rc=$?
  echo "$what: exit code $rc" >> errors
  grep -m1 -e "^PLUMED: ERROR in input" -e "maze>" bad.out | sed -e "s/^PLUMED: //" -e "s/with label [^ ]* //" >> errors
}

function plumed_regtest_after(){
  rm -f errors
  expect_error "DRR with OUTPUTFREQ=0" "t1: TORSION ATOMS=2,5,6,7
eabf: DRR ARG=t1 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=3 OUTPUTFREQ=0 FULLSAMPLES=2 TEMP=300"
  expect_error "DRR with GRID_BIN=0" "t1: TORSION ATOMS=2,5,6,7
eabf: DRR ARG=t1 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=0 OUTPUTFREQ=10 FULLSAMPLES=2 TEMP=300"
  expect_error "DRR with HISTORYFREQ=0.5" "t1: TORSION ATOMS=2,5,6,7
eabf: DRR ARG=t1 GRID_MIN=-pi GRID_MAX=pi GRID_BIN=3 OUTPUTFREQ=10 HISTORYFREQ=0.5 FULLSAMPLES=2 TEMP=300"
}
