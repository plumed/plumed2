MOLINFO STRUCTURE=template.pdb

# SAXS smeared with the resolution function, as a CV and with DOSCORE:
# the METAINFERENCE bias on the CV and the DOSCORE score must be the same
SAXS ...
LABEL=saxs
ATOMS=1-355
MARTINI
QVALUE1=0.02 SIGMARES1=0.0032
QVALUE2=0.05 SIGMARES2=0.0035
QVALUE3=0.08 SIGMARES3=0.0038
QVALUE4=0.11 SIGMARES4=0.0041
QVALUE5=0.14 SIGMARES5=0.0044
QVALUE6=0.17 SIGMARES6=0.0047
QVALUE7=0.2 SIGMARES7=0.005
QVALUE8=0.23 SIGMARES8=0.0053
QVALUE9=0.26 SIGMARES9=0.0056
QVALUE10=0.29 SIGMARES10=0.0059
QVALUE11=0.32 SIGMARES11=0.0062
QVALUE12=0.35 SIGMARES12=0.0065
QVALUE13=0.38 SIGMARES13=0.0068
QVALUE14=0.41 SIGMARES14=0.0071
QVALUE15=0.44 SIGMARES15=0.0074
... SAXS

METAINFERENCE ...
ARG=(saxs\.q-.*)
PARAMETERS=1.0902,0.790632,0.453808,0.254737,0.154928,0.0921503,0.052633,0.0276557,0.0122775,0.00880634,0.0137301,0.0180036,0.0193374,0.0210131,0.0220506
NOISETYPE=GAUSS
SIGMA0=0.05 DSIGMA=0
SIGMA_MEAN0=0.0001
TEMP=300
LABEL=mi
... METAINFERENCE

SAXS ...
LABEL=saxsmi
ATOMS=1-355
MARTINI
QVALUE1=0.02 EXPINT1=1.0902 SIGMARES1=0.0032
QVALUE2=0.05 EXPINT2=0.790632 SIGMARES2=0.0035
QVALUE3=0.08 EXPINT3=0.453808 SIGMARES3=0.0038
QVALUE4=0.11 EXPINT4=0.254737 SIGMARES4=0.0041
QVALUE5=0.14 EXPINT5=0.154928 SIGMARES5=0.0044
QVALUE6=0.17 EXPINT6=0.0921503 SIGMARES6=0.0047
QVALUE7=0.2 EXPINT7=0.052633 SIGMARES7=0.005
QVALUE8=0.23 EXPINT8=0.0276557 SIGMARES8=0.0053
QVALUE9=0.26 EXPINT9=0.0122775 SIGMARES9=0.0056
QVALUE10=0.29 EXPINT10=0.00880634 SIGMARES10=0.0059
QVALUE11=0.32 EXPINT11=0.0137301 SIGMARES11=0.0062
QVALUE12=0.35 EXPINT12=0.0180036 SIGMARES12=0.0065
QVALUE13=0.38 EXPINT13=0.0193374 SIGMARES13=0.0068
QVALUE14=0.41 EXPINT14=0.0210131 SIGMARES14=0.0071
QVALUE15=0.44 EXPINT15=0.0220506 SIGMARES15=0.0074
DOSCORE
NOISETYPE=GAUSS
SIGMA0=0.05 DSIGMA=0
SIGMA_MEAN0=0.0001
TEMP=300
... SAXS

BIASVALUE ARG=saxsmi.score

PRINT ARG=(saxs\.q-.*) FILE=colvar FMT=%10.6f
PRINT ARG=mi.bias,saxsmi.score FILE=score FMT=%12.6f
DUMPDERIVATIVES ARG=saxsmi.score FILE=deriv FMT=%10.4f STRIDE=10
