MOLINFO STRUCTURE=ion_CAL_single.pdb

sx: SAXS ATOMS=1 ONEBEAD TEMPLATE=ion_CAL_single.pdb NOPBC SERIAL QVALUE1=0.05 QVALUE2=0.15 QVALUE3=0.25
sn: SANS ATOMS=1 ONEBEAD TEMPLATE=ion_CAL_single.pdb NOPBC SERIAL DEUTER_CONC=0.0 QVALUE1=0.05 QVALUE2=0.15 QVALUE3=0.25

PRINT ARG=sx.q-0,sx.q-1,sx.q-2,sn.q-0,sn.q-1,sn.q-2 FILE=ions.dat STRIDE=1 FMT=%16.10e
