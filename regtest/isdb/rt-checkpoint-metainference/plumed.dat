# exact restart of METAINFERENCE (GENERIC, MGAUSS with reweighting and optimised sigma mean) and of an ISDB CV with DOSCORE from the checkpoint: see config
CHECKPOINT FILE=plumed.cpt
d1: DISTANCE ATOMS=1,2
d2: DISTANCE ATOMS=3,4
d3: DISTANCE ATOMS=1,3
d4: DISTANCE ATOMS=2,4
m1: METAINFERENCE ARG=d1,d2,d3,d4 PARAMETERS=1.0,1.5,1.2,2.0 NOISETYPE=GENERIC LIKELIHOOD=LOGN DFTILDE=0.1 SIGMA0=0.5 SIGMA_MIN=0.01 SIGMA_MAX=5 DSIGMA=0.1 OPTSIGMAMEAN=SEM AVERAGING=4 SCALEDATA SCALE0=1.0 SCALE_MIN=0.5 SCALE_MAX=1.5 DSCALE=0.05 MC_STEPS=3 TEMP=300 SEED=2026 WRITE_STRIDE=5 STATUS_FILE=STATUS1
m2: METAINFERENCE ARG=d1,d2 PARAMETERS=1.0,1.5 NOISETYPE=MGAUSS SIGMA0=0.3 SIGMA_MEAN0=0.1 SIGMA_MIN=0.01 SIGMA_MAX=3 DSIGMA=0.05 MC_STEPS=2 TEMP=300 SEED=7 WRITE_STRIDE=0
NOE ...
 GROUPA1=1 GROUPB1=2 NOEDIST1=1.0
 GROUPA2=3 GROUPB2=4 NOEDIST2=1.5
 DOSCORE NOISETYPE=MGAUSS SIGMA0=0.3 SIGMA_MEAN0=0.1 SIGMA_MIN=0.01 SIGMA_MAX=3 DSIGMA=0.05 TEMP=300 SEED=11 WRITE_STRIDE=0
 LABEL=n1
... NOE
PRINT ARG=m1.*,m2.*,n1.* FILE=COLVAR STRIDE=1 FMT=%.17g
