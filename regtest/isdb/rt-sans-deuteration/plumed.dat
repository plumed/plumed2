MOLINFO STRUCTURE=protein.pdb

# ONEBEAD SANS: the solvent exposed residues are deuterated at random
# (DEUTER_CONC), with a new draw at every step (SOLVATION_STRIDE=1)
SANS ...
LABEL=sans
NOPBC
ATOMS=1-3439
ONEBEAD
TEMPLATE=protein.pdb
DEUTER_CONC=0.5
SOLVATION_CORRECTION=0.05
SOLVATION_STRIDE=1
SASA_CUTOFF=0.5
QVALUE1=0.01
QVALUE2=0.04
QVALUE3=0.07
QVALUE4=0.1
QVALUE5=0.13
QVALUE6=0.16
QVALUE7=0.19
QVALUE8=0.22
... SANS

PRINT ARG=(sans\.q-.*) FILE=sans FMT=%12.8f
