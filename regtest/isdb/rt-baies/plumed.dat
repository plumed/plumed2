bg2: BAIES ATOMS=1,5,7,16,18,20,23,25,27,29,33,35,37,39,43,45,47,49,67,69,71,73,77,79,81,83,87,89,91,93,98,102,104 DATA_FILE=gauss.dat PRIOR=CAUCHY   TEMP=300
bl0: BAIES ATOMS=1,5,7,16,18,20,23,25,27,29,33,35,37,39,43,45,47,49,67,69,71,73,77,79,81,83,87,89,91,93,98,102,104 DATA_FILE=logn.dat  PRIOR=NONE     TEMP=300
bl1: BAIES ATOMS=1,5,7,16,18,20,23,25,27,29,33,35,37,39,43,45,47,49,67,69,71,73,77,79,81,83,87,89,91,93,98,102,104 DATA_FILE=logn.dat  PRIOR=JEFFREYS TEMP=300
bl2: BAIES ATOMS=1,5,7,16,18,20,23,25,27,29,33,35,37,39,43,45,47,49,67,69,71,73,77,79,81,83,87,89,91,93,98,102,104 DATA_FILE=logn.dat  PRIOR=CAUCHY   TEMP=300 SIGMA_MIN=0.05

PRINT ARG=bg0.ene,bg1.ene,bg2.ene,bl0.ene,bl1.ene,bl2.ene FILE=colvar FMT=%10.4f
DUMPDERIVATIVES ARG=bg0.ene,bg1.ene,bg2.ene,bl0.ene,bl1.ene,bl2.ene FILE=deriv FMT=%10.4f STRIDE=5

ENDPLUMED
