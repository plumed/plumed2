MOLINFO MOLTYPE=protein STRUCTURE=peptide.pdb
WHOLEMOLECULES ENTITY0=1-111

# all the combinations of noise model (from the data file) and prior
bg0: BAIES ATOMS=1,5,7,16,18,20,23,25,27,29,33,35,37,39,43,45,47,49,67,69,71,73,77,79,81,83,87,89,91,93,98,102,104 DATA_FILE=gauss.dat PRIOR=NONE     TEMP=300
