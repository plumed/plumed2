# exact restart of METAINFERENCE with four replicas and replica-exchange steps (driver --debug-grex): see config
CHECKPOINT FILE=plumed.cpt
d1: DISTANCE ATOMS=@replicas:{{1,2} {1,3} {2,3} {1,4}}
d2: DISTANCE ATOMS=@replicas:{{3,4} {2,4} {1,4} {2,3}}
d3: DISTANCE ATOMS=@replicas:{{1,4} {2,3} {3,4} {1,2}}
rst: RESTRAINT ARG=d3 AT=@replicas:{1.0 1.2 1.4 1.6} KAPPA=5.0
m1: METAINFERENCE ARG=d1,d2 PARAMETERS=1.0,1.5 NOISETYPE=GENERIC LIKELIHOOD=LOGN DFTILDE=0.1 SIGMA0=0.5 SIGMA_MIN=0.01 SIGMA_MAX=5 DSIGMA=0.1 OPTSIGMAMEAN=SEM AVERAGING=4 SCALEDATA SCALE0=1.0 SCALE_MIN=0.5 SCALE_MAX=1.5 DSCALE=0.05 MC_STEPS=3 TEMP=300 SEED=2026 WRITE_STRIDE=5 STATUS_FILE=STATUS1
m2: METAINFERENCE ARG=d1,d2,rst.bias REWEIGHT PARAMETERS=1.0,1.5 NOISETYPE=MGAUSS SIGMA0=0.3 SIGMA_MIN=0.01 SIGMA_MAX=3 DSIGMA=0.05 OPTSIGMAMEAN=SEM AVERAGING=3 MC_STEPS=2 TEMP=300 SEED=7 WRITE_STRIDE=0
m3: METAINFERENCE ARG=d1,d2 PARAMETERS=1.0,1.5 NOISETYPE=OUTLIERS SIGMA0=0.4 SIGMA_MIN=0.05 SIGMA_MAX=3 DSIGMA=0.05 OPTSIGMAMEAN=NONE SIGMA_MEAN0=0.1 MC_STEPS=2 MC_CHUNKSIZE=1 TEMP=300 SEED=11 WRITE_STRIDE=0
PRINT ARG=m1.*,m2.*,m3.* FILE=COLVAR STRIDE=1 FMT=%.17g
