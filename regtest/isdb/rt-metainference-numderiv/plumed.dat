# The same NOE with DOSCORE and sigma sampling, with analytical (a) and numerical (n) derivatives: see config
NOE ...
LABEL=a
GROUPA1=1 GROUPB1=3 NOEDIST1=1.2
GROUPA2=2 GROUPB2=4 NOEDIST2=0.8
DOSCORE NOISETYPE=MGAUSS SIGMA0=0.5 SIGMA_MIN=0.01 SIGMA_MAX=5 DSIGMA=0.2 SIGMA_MEAN0=0.1
MC_STEPS=5 TEMP=300 SEED=123 NOPBC
... NOE

NOE ...
LABEL=n
GROUPA1=1 GROUPB1=3 NOEDIST1=1.2
GROUPA2=2 GROUPB2=4 NOEDIST2=0.8
DOSCORE NOISETYPE=MGAUSS SIGMA0=0.5 SIGMA_MIN=0.01 SIGMA_MAX=5 DSIGMA=0.2 SIGMA_MEAN0=0.1
MC_STEPS=5 TEMP=300 SEED=123 NOPBC
NUMERICAL_DERIVATIVES
... NOE

PRINT ARG=a.score,a.sigma-0,a.sigma-1,a.acceptSigma,n.score,n.sigma-0,n.sigma-1,n.acceptSigma FILE=COLVAR FMT=%.6f
DUMPDERIVATIVES ARG=a.score,n.score FILE=deriv FMT=%.6f
