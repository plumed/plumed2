# GENERIC metainference restarted from the status files (both the CV and the bias)
# the first run has RESTART but no status file: it must start from scratch
RESTART

NOE ...
GROUPA1=30 GROUPB1=108 NOEDIST1=135.6
GROUPA2=78 GROUPB2=88 NOEDIST2=92
GROUPA3=63 GROUPB3=72 NOEDIST3=103.3
GROUPA4=18 GROUPB4=34 NOEDIST4=51.4
DOSCORE
NOISETYPE=GENERIC DFTILDE=0
SIGMA0=10 SIGMA_MIN=0.1 SIGMA_MAX=100 DSIGMA=3
OPTSIGMAMEAN=SEM AVERAGING=3
TEMP=300 SEED=2026 WRITE_STRIDE=1
LABEL=cv
... NOE

NOE ...
GROUPA1=30 GROUPB1=108
GROUPA2=78 GROUPB2=88
GROUPA3=63 GROUPB3=72
GROUPA4=18 GROUPB4=34
LABEL=nc
... NOE

METAINFERENCE ...
ARG=nc.noe-0,nc.noe-1,nc.noe-2,nc.noe-3
PARAMETERS=135.6,92,103.3,51.4
NOISETYPE=GENERIC LIKELIHOOD=LOGN DFTILDE=0
SIGMA0=50 SIGMA_MIN=0.01 SIGMA_MAX=500 DSIGMA=20
OPTSIGMAMEAN=SEM AVERAGING=3
TEMP=300 SEED=2026 WRITE_STRIDE=1
LABEL=mi
... METAINFERENCE

BIASVALUE ARG=cv.score
PRINT ARG=cv.score,cv.ftilde-0,cv.ftilde-3,cv.sigma-0,cv.sigmaMean-0,mi.bias,mi.ftilde-0,mi.ftilde-3,mi.sigma-0,mi.sigmaMean-0 FILE=COLVARB FMT=%10.4f
