# sigmas moved in chunks (MC_CHUNKSIZE): the energy is updated with the energies of the moved data only
NOE ...
GROUPA1=30 GROUPB1=108
GROUPA2=78 GROUPB2=88
GROUPA3=63 GROUPB3=72
GROUPA4=18 GROUPB4=34
GROUPA5=42 GROUPB5=118
GROUPA6=80 GROUPB6=94
LABEL=nc
... NOE

METAINFERENCE ...
ARG=nc.noe-0,nc.noe-1,nc.noe-2,nc.noe-3,nc.noe-4,nc.noe-5
PARAMETERS=135.6,92.0,103.3,51.4,103.1,113.5
NOISETYPE=MGAUSS
SIGMA0=50 SIGMA_MIN=0.1 SIGMA_MAX=500 DSIGMA=20
SIGMA_MEAN0=50 SCALEDATA SCALE0=1 SCALE_MIN=0.5 SCALE_MAX=2 DSCALE=0.05
MC_STEPS=4 MC_CHUNKSIZE=2
TEMP=300 SEED=5 WRITE_STRIDE=100000
LABEL=mgauss
... METAINFERENCE

METAINFERENCE ...
ARG=nc.noe-0,nc.noe-1,nc.noe-2,nc.noe-3,nc.noe-4,nc.noe-5
PARAMETERS=135.6,92.0,103.3,51.4,103.1,113.5
NOISETYPE=MOUTLIERS
SIGMA0=50 SIGMA_MIN=0.1 SIGMA_MAX=500 DSIGMA=20
SIGMA_MEAN0=50 SCALEDATA SCALE0=1 SCALE_MIN=0.5 SCALE_MAX=2 DSCALE=0.05
MC_STEPS=4 MC_CHUNKSIZE=2
TEMP=300 SEED=5 WRITE_STRIDE=100000
LABEL=moutliers
... METAINFERENCE

METAINFERENCE ...
ARG=nc.noe-0,nc.noe-1,nc.noe-2,nc.noe-3,nc.noe-4,nc.noe-5
PARAMETERS=135.6,92.0,103.3,51.4,103.1,113.5
NOISETYPE=GENERIC
SIGMA0=50 SIGMA_MIN=0.1 SIGMA_MAX=500 DSIGMA=20
SIGMA_MEAN0=50 SCALEDATA SCALE0=1 SCALE_MIN=0.5 SCALE_MAX=2 DSCALE=0.05
MC_STEPS=4 MC_CHUNKSIZE=2
TEMP=300 SEED=5 WRITE_STRIDE=100000
LABEL=generic
... METAINFERENCE

PRINT ARG=mgauss.bias,mgauss.sigma-0,mgauss.sigma-5,mgauss.scale,moutliers.bias,moutliers.sigma-0,moutliers.sigma-5,generic.bias,generic.sigma-0,generic.sigma-5,generic.ftilde-0 FILE=COLVAR FMT=%14.6e
