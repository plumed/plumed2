# OPTSIGMAMEAN with a single replica: sigma mean is not defined and keeps its initial value
NOE ...
GROUPA1=30 GROUPB1=108 NOEDIST1=135.6
GROUPA2=78 GROUPB2=88 NOEDIST2=92
GROUPA3=63 GROUPB3=72 NOEDIST3=103.3
DOSCORE
NOISETYPE=MGAUSS
SIGMA0=10 SIGMA_MIN=0.1 SIGMA_MAX=100 DSIGMA=0
SIGMA_MEAN0=2 OPTSIGMAMEAN=SEM AVERAGING=3
TEMP=300 WRITE_STRIDE=100000
LABEL=cv
... NOE

NOE ...
GROUPA1=30 GROUPB1=108
GROUPA2=78 GROUPB2=88
GROUPA3=63 GROUPB3=72
LABEL=nc
... NOE

METAINFERENCE ...
ARG=nc.noe-0,nc.noe-1,nc.noe-2
PARAMETERS=135.6,92,103.3
NOISETYPE=GAUSS
SIGMA0=10 SIGMA_MIN=0.1 SIGMA_MAX=100 DSIGMA=0
SIGMA_MEAN0=2 OPTSIGMAMEAN=SEM AVERAGING=3
TEMP=300 WRITE_STRIDE=100000
LABEL=mi
... METAINFERENCE

BIASVALUE ARG=cv.score
PRINT ARG=cv.score,cv.sigmaMean-0,cv.sigmaMean-2,mi.bias,mi.sigmaMean FILE=COLVAR FMT=%10.4f
