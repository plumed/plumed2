SAXS ...
  LABEL=saxs
  ATOMS=1,2
  NOPBC
  PARAMETERS1=1.0
  PARAMETERS2=2.0

  QVALUE1=0.03  EXPINT1=8.30  EXPERR1=0.20
  QVALUE2=0.12  EXPINT2=8.80  EXPERR2=0.25
  QVALUE3=0.25  EXPINT3=5.20  EXPERR3=0.15

  CHI2
... SAXS

SANS ...
  LABEL=sans
  ATOMS=1,2
  NOPBC
  PARAMETERS1=1.0
  PARAMETERS2=-0.7

  QVALUE1=0.03  EXPINT1=0.15  EXPERR1=0.02
  QVALUE2=0.12  EXPINT2=0.35  EXPERR2=0.03
  QVALUE3=0.25  EXPINT3=1.10  EXPERR3=0.05

  CHI2
... SANS

DUMPDERIVATIVES ARG=saxs.chi2,saxs.chi2red,sans.chi2,sans.chi2red FILE=derivatives FMT=%17.10e
PRINT ARG=saxs.chi2,saxs.chi2red,saxs.chi2scale,sans.chi2,sans.chi2red,sans.chi2scale FILE=chi2.dat STRIDE=1 FMT=%17.10e
