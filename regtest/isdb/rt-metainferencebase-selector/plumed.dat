# SELECTOR with a CV with DOSCORE and with METAINFERENCE: the status files must be the same
sel: SELECTOR NAME=sel VALUE=@replicas:{0,1}

NOE ...
GROUPA1=30 GROUPB1=108 NOEDIST1=135.6
GROUPA2=78 GROUPB2=88 NOEDIST2=92
GROUPA3=63 GROUPB3=72 NOEDIST3=103.3
DOSCORE
NOISETYPE=MGAUSS
SIGMA0=10 SIGMA_MIN=0.1 SIGMA_MAX=100 DSIGMA=3
OPTSIGMAMEAN=SEM AVERAGING=3
SELECTOR=sel NSELECT=2
TEMP=300 SEED=7 WRITE_STRIDE=4 FMT=%14.4f
LABEL=cv
... NOE

NOE ...
GROUPA1=30 GROUPB1=108
GROUPA2=78 GROUPB2=88
GROUPA3=63 GROUPB3=72
LABEL=nc
... NOE

METAINFERENCE ...
ARG=nc.noe-0,nc.noe-1,nc.noe-2
PARAMETERS=135.6,92,103.3
NOISETYPE=MGAUSS
SIGMA0=10 SIGMA_MIN=0.1 SIGMA_MAX=100 DSIGMA=3
OPTSIGMAMEAN=SEM AVERAGING=3
SELECTOR=sel NSELECT=2
TEMP=300 SEED=7 WRITE_STRIDE=4 FMT=%14.4f
LABEL=mi
... METAINFERENCE

BIASVALUE ARG=cv.score
PRINT ARG=cv.score,cv.sigma-0,cv.sigmaMean-0,mi.bias,mi.sigma-0,mi.sigmaMean-0 FILE=COLVAR FMT=%10.4f
