# Monte Carlo moves larger than the allowed intervals: sigma, scale and offset must stay within their bounds
NOE ...
GROUPA1=30 GROUPB1=108
GROUPA2=78 GROUPB2=88
GROUPA3=63 GROUPB3=72
LABEL=nc
... NOE

METAINFERENCE ...
ARG=nc.noe-0,nc.noe-1,nc.noe-2
PARAMETERS=135.6,92,103.3
NOISETYPE=MGAUSS
SIGMA0=15 SIGMA_MIN=10 SIGMA_MAX=20 DSIGMA=100
SCALEDATA SCALE0=1 SCALE_MIN=0.9 SCALE_MAX=1.1 DSCALE=2
ADDOFFSET OFFSET0=0 OFFSET_MIN=-1 OFFSET_MAX=1 DOFFSET=30
SIGMA_MEAN0=2 MC_STEPS=10
TEMP=300 SEED=11 WRITE_STRIDE=100000
LABEL=mi
... METAINFERENCE

PRINT ARG=mi.bias,mi.sigma-0,mi.sigma-1,mi.sigma-2,mi.scale,mi.offset FILE=COLVAR FMT=%14.6e
