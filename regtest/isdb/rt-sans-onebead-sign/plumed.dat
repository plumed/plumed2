MOLINFO STRUCTURE=template.pdb

SANS ...
  LABEL=sans
  ATOMS=1-6
  NOPBC
  ONEBEAD
  TEMPLATE=template.pdb
  SOLVDENS=0.334
  SOLVATION_CORRECTION=0
  SOLVATION_STRIDE=1
  SASA_CUTOFF=1000000000
  DEUTER_CONC=0.3000
  QVALUE1=0.03
  QVALUE2=0.06
  QVALUE3=0.09
  QVALUE4=0.12
  QVALUE5=0.15
  QVALUE6=0.18
  QVALUE7=0.21
  QVALUE8=0.24
  QVALUE9=0.27
  QVALUE10=0.30
... SANS

bias: RESTRAINT ARG=sans.q-4 AT=0.2 KAPPA=10.0

PRINT ARG=sans.q-4,bias.bias FILE=values STRIDE=1 FMT=%14.8e
