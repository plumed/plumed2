MOLINFO STRUCTURE=structure.pdb
WHOLEMOLECULES ENTITY0=1-22 ADDREFERENCE
protein-h: GROUP NDX_FILE=index.ndx NDX_GROUP=Protein-H

# REGRESSION, OUTLIERS, ERR_FILE, WRITE_OV, two groups of GMM components (Beta=0,1)
EMMI ...
    LABEL=gmm NOPBC TEMP=310 NL_STRIDE=5 NL_CUTOFF=0.01
    ATOMS=protein-h GMM_FILE=map.dat ERR_FILE=err.dat
    WRITE_STRIDE=10 SEED=3
    SIGMA0=0.5 SIGMA_MIN=0.2 DSIGMA=0.1 MC_STRIDE=1 RESOLUTION=1.0 NOISETYPE=OUTLIERS
    REGRESSION=4 REG_SCALE_MIN=100 REG_SCALE_MAX=400 REG_DSCALE=5
    WRITE_OV_STRIDE=1000 WRITE_OV=ov.dat
...

# ovexp.dat contains 1.1 times the self overlaps of the data GMM
EMMI ...
    LABEL=gmmov NOPBC TEMP=310 NL_STRIDE=5 NL_CUTOFF=0.01
    ATOMS=protein-h GMM_FILE=map.dat OV_FILE=ovexp.dat
    WRITE_STRIDE=10 SEED=4
    SIGMA0=0.5 SIGMA_MIN=0.2 DSIGMA=0.0 RESOLUTION=1.0 NOISETYPE=GAUSS PRIOR=2.0
...

BIASVALUE ARG=gmm.scoreb
DUMPDERIVATIVES ARG=gmm.scoreb,gmmov.scoreb STRIDE=5 FMT=%10.4f FILE=deriva
PRINT ARG=gmm.*,gmmov.* FILE=GMM STRIDE=1 FMT=%10.4f
ENDPLUMED
