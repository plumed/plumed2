# exact restart of EMMI: MC of sigma (OUTLIERS and GAUSS noise), regression of the scale and the files of the model overlap
CHECKPOINT FILE=plumed.cpt
MOLINFO STRUCTURE=structure.pdb
protein-h: GROUP NDX_FILE=index.ndx NDX_GROUP=Protein-H

EMMI ...
    LABEL=gmm NOPBC TEMP=310 NL_STRIDE=1 NL_CUTOFF=0.01
    ATOMS=protein-h GMM_FILE=map.dat ERR_FILE=err.dat
    WRITE_STRIDE=10 SEED=3 STATUS_FILE=MCSTATUS1
    SIGMA0=0.5 SIGMA_MIN=0.2 DSIGMA=0.1 MC_STRIDE=1 RESOLUTION=1.0 NOISETYPE=OUTLIERS
    REGRESSION=4 REG_SCALE_MIN=100 REG_SCALE_MAX=400 REG_DSCALE=5
    WRITE_OV_STRIDE=10 WRITE_OV=ov1.dat
...

EMMI ...
    LABEL=gmmov NOPBC TEMP=310 NL_STRIDE=1 NL_CUTOFF=0.01
    ATOMS=protein-h GMM_FILE=map.dat OV_FILE=ovexp.dat
    WRITE_STRIDE=5 SEED=4 STATUS_FILE=MCSTATUS2
    SIGMA0=0.5 SIGMA_MIN=0.2 DSIGMA=0.1 RESOLUTION=1.0 NOISETYPE=GAUSS PRIOR=2.0
...

BIASVALUE ARG=gmm.scoreb
BIASVALUE ARG=gmmov.scoreb
PRINT ARG=gmm.*,gmmov.* FILE=COLVAR STRIDE=1 FMT=%.17g
