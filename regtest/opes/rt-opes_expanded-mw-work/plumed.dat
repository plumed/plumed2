# vim:ft=plumed
# CALC_WORK with two walkers on different trajectories (alanine.0.xtc and alanine.1.xtc, the
# second shifted by one frame): the work of each walker must use its own CVs.
# Swapping the two trajectories swaps Colvar.0.data and Colvar.1.data.
phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17
ene: CUSTOM PERIODIC=NO ARG=phi FUNC=50*x+100 #random stuff instead of energy

mc: ECV_MULTITHERMAL ARG=ene TEMP=300 TEMP_MIN=200 TEMP_MAX=600 TEMP_STEPS=4
umb: ECV_UMBRELLAS_LINE ARG=psi TEMP=300 CV_MIN=-pi CV_MAX=pi SIGMA=0.8
opes: OPES_EXPANDED ...
  ARG=mc.ene,umb.psi
  PACE=2
  OBSERVATION_STEPS=10
  PRINT_STRIDE=10
  CALC_WORK
  FILE=DeltaFs.data
  FMT={% f}
  WALKERS_MPI
...

PRINT FMT=%g STRIDE=10 FILE=Colvar.data ARG=*

ENDPLUMED
