# exact restart of OPES_METAD with two replicas and two processes per replica: see config
CHECKPOINT FILE=plumed.cpt
d1: DISTANCE ATOMS=@replicas:{{1,2} {1,3}}
d2: DISTANCE ATOMS=@replicas:{{3,4} {2,4}}
# multiple walkers sharing the kernels through MPI (one KERNELS file, written by the first replica)
ow: OPES_METAD ARG=d1,d2 PACE=4 BARRIER=5 SIGMA=0.1,0.1 TEMP=300 WALKERS_MPI FILE=KERNELS_W
# one per replica, adaptive sigma
oa: OPES_METAD ARG=d1 PACE=2 BARRIER=3 SIGMA=ADAPTIVE ADAPTIVE_SIGMA_STRIDE=6 TEMP=300 FILE=KERNELS_A
PRINT ARG=*.* FILE=COLVAR STRIDE=1 FMT=%.17g
