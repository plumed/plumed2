# exact restart of OPES_METAD and OPES_METAD_EXPLORE from the checkpoint: see config
CHECKPOINT FILE=plumed.cpt
d1: DISTANCE ATOMS=1,2
d2: DISTANCE ATOMS=3,4
d3: DISTANCE ATOMS=1,3
# fixed sigma, work, a deposition at the restart step
o1: OPES_METAD ARG=d1,d2 PACE=4 BARRIER=5 SIGMA=0.1,0.1 TEMP=300 CALC_WORK FILE=KERNELS1 STATE_WFILE=STATE1 STATE_WSTRIDE=8
# adaptive sigma, neighbor list
o2: OPES_METAD ARG=d3 PACE=2 BARRIER=3 SIGMA=ADAPTIVE ADAPTIVE_SIGMA_STRIDE=6 TEMP=300 NLIST FILE=KERNELS2
o3: OPES_METAD_EXPLORE ARG=d1 PACE=3 BARRIER=4 SIGMA=0.05 TEMP=300 FILE=KERNELS3
PRINT ARG=*.* FILE=COLVAR STRIDE=1 FMT=%.17g
