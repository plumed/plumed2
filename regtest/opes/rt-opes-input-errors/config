type=driver
plumed_modules=opes
arg="--plumed plumed.dat --ixyz traj.xyz"
export PLUMED_STACK_TRACE=no
# each bad_NAME.dat is a wrong OPES input that crashed or gave a nonsense result:
# it must stop with a message that contains the text below
function plumed_regtest_before(){
  {
    echo 5 ; echo 10 10 10
    echo X 0 0 0 ; echo X 1 0 0 ; echo X 0 1 0 ; echo X 0 0 1 ; echo X 1 1 1
  } > traj.xyz
  d="d: DISTANCE ATOMS=1,2\nv: DISTANCE ATOMS=1,3\n"
  ecv="e: ECV_MULTITHERMAL ARG=d TEMP=300 TEMP_MAX=600\n"
  printf "${d}e: ECV_UMBRELLAS_LINE ARG=d TEMP=300 CV_MIN=0 CV_MAX=1 SIGMA=0\n" > bad_umbrellas_line_sigma_zero.dat
  printf "${d}e: ECV_UMBRELLAS_LINE ARG=d TEMP=300 CV_MIN=0 CV_MAX=1 SIGMA=-0.1\n" > bad_umbrellas_line_sigma_negative.dat
  printf "${d}e: ECV_UMBRELLAS_LINE ARG=d TEMP=300 CV_MIN=0 CV_MAX=1 SIGMA=0.1 SPACING=0\n" > bad_umbrellas_line_spacing_zero.dat
  printf "${d}e: ECV_UMBRELLAS_LINE ARG=d TEMP=300 CV_MIN=0 CV_MAX=1 SIGMA=0.1 SPACING=-1\n" > bad_umbrellas_line_spacing_negative.dat
  printf "#! FIELDS time d sigma_d\n0 0.5 0.1\n0 1.0 0\n" > umbrellas_sigma.data
  printf "${d}e: ECV_UMBRELLAS_FILE ARG=d TEMP=300 FILE=umbrellas_sigma.data\n" > bad_umbrellas_file_sigma.dat
  printf "#! FIELDS time d sigma_d\n" > umbrellas_empty.data
  printf "${d}e: ECV_UMBRELLAS_FILE ARG=d TEMP=300 FILE=umbrellas_empty.data\n" > bad_umbrellas_file_empty.dat
  printf "${d}e: ECV_MULTITHERMAL ARG=d TEMP=0 TEMP_MAX=600\n" > bad_multithermal_temp.dat
  printf "${d}e: ECV_MULTITHERMAL ARG=d TEMP=300 TEMP_MIN=0 TEMP_MAX=600\n" > bad_multithermal_temp_min.dat
  printf "${d}e: ECV_MULTITHERMAL ARG=d TEMP=300 TEMP_MIN=-300 TEMP_MAX=600 NO_GEOM_SPACING\n" > bad_multithermal_temp_min_linear.dat
  printf "${d}e: ECV_MULTITHERMAL ARG=d TEMP=300 TEMP_SET_ALL=0,300,600\n" > bad_multithermal_temp_set_all.dat
  printf "${d}e: ECV_MULTITHERMAL_MULTIBARIC ARG=d,v TEMP=300 PRESSURE=1 SET_ALL_TEMP_PRESSURE=0_1,300_1\n" > bad_multibaric_set_all_temp.dat
  printf "${d}e: ECV_LINEAR ARG=d TEMP=300 LAMBDA_MIN=0 LAMBDA_MAX=1 LAMBDA_STEPS=3 GEOM_SPACING\n" > bad_linear_geom.dat
  printf "${d}${ecv}o: OPES_EXPANDED ARG=e.* PACE=10 PRINT_STRIDE=0\n" > bad_expanded_print_stride.dat
  printf "#! FIELDS time counter rct d DeltaF\n" > state_empty.data
  printf "RESTART\n${d}${ecv}o: OPES_EXPANDED ARG=e.* PACE=10 STATE_RFILE=state_empty.data\n" > bad_expanded_restart_empty.dat
  echo "d: DISTANCE ATOMS=1,2" > plumed.dat
  echo "PRINT ARG=d FILE=colvar" >> plumed.dat
}
function plumed_regtest_after(){
  rm -f errors
  while read -r name text ; do
    $plumed driver --plumed bad_$name.dat --ixyz traj.xyz > bad_$name.out 2> bad_$name.err
    if test $? -ne 0 && grep -q -F "$text" bad_$name.out bad_$name.err ; then
      echo "$name: rejected" >> errors
    else
      echo "$name: NOT REJECTED PROPERLY" >> errors
    fi
  done <<'EOT'
umbrellas_line_sigma_zero SIGMA must be greater than zero
umbrellas_line_sigma_negative SIGMA must be greater than zero
umbrellas_line_spacing_zero SPACING must be greater than zero
umbrellas_line_spacing_negative SPACING must be greater than zero
umbrellas_file_sigma the sigmas read from file must be greater than zero
umbrellas_file_empty no umbrellas found in FILE
multithermal_temp TEMP must be greater than zero
multithermal_temp_min TEMP_MIN must be greater than zero
multithermal_temp_min_linear TEMP_MIN must be greater than zero
multithermal_temp_set_all temperatures must be greater than zero
multibaric_set_all_temp cannot understand: 0_1
linear_geom cannot use GEOM_SPACING when LAMBDA_MIN is not greater than zero
expanded_print_stride PRINT_STRIDE must be greater than zero
expanded_restart_empty no DeltaF values found
EOT
}
