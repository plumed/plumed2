# vim:ft=plumed

# Two walkers, where only the first one has an EXCLUDED_REGION: when it is
# inside it, the second walker still deposits, and the two must stay in sync

phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17
chi: CUSTOM PERIODIC=NO ARG=phi FUNC=@replicas:{step(x+2)-step(x),0}

opes: OPES_METAD ...
  ARG=phi,psi
  PACE=5
  TEMP=300.0
  SIGMA=0.2,0.2
  BARRIER=20
  FILE=Kernels.data
  FMT=%f
  EXCLUDED_REGION=chi
  CALC_WORK
  WALKERS_MPI
...

PRINT FMT=%g STRIDE=5 FILE=Colvar.data ARG=phi,psi,chi,opes.bias,opes.rct,opes.zed,opes.neff,opes.nker,opes.work

ENDPLUMED
