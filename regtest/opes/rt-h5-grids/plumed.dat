# grids and state files as HDF5 tables (rewritten at every write): the same as their text twins (see config)
d1: DISTANCE ATOMS=1,2
d2: DISTANCE ATOMS=2,3
m: METAD ARG=d1,d2 SIGMA=0.1,0.1 HEIGHT=0.5 PACE=5 FILE=HILLS.h5 GRID_MIN=0,0 GRID_MAX=3,3 GRID_BIN=30,30 GRID_WFILE=grid.h5 GRID_WSTRIDE=20
mt: METAD ARG=d1,d2 SIGMA=0.1,0.1 HEIGHT=0.5 PACE=5 FILE=HILLS GRID_MIN=0,0 GRID_MAX=3,3 GRID_BIN=30,30 GRID_WFILE=grid GRID_WSTRIDE=20 FMT=%24.17g
o: OPES_METAD ARG=d1 PACE=5 BARRIER=5 TEMP=300 SIGMA=0.1 FILE=KERNELS.h5 STATE_WFILE=STATE.h5 STATE_WSTRIDE=20
ot: OPES_METAD ARG=d1 PACE=5 BARRIER=5 TEMP=300 SIGMA=0.1 FILE=KERNELS STATE_WFILE=STATE STATE_WSTRIDE=20 FMT=%24.17g
hh: HISTOGRAM ARG=d1 GRID_MIN=0 GRID_MAX=3 GRID_BIN=20 BANDWIDTH=0.1
DUMPGRID ARG=hh FILE=hist.h5 STRIDE=30
DUMPGRID ARG=hh FILE=hist FMT=%24.17g STRIDE=30
PRINT ARG=m.bias,mt.bias,o.bias,ot.bias FILE=COLVAR.h5
