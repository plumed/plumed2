CHECKPOINT FILE=plumed.cpt
d1: DISTANCE ATOMS=1,2
ene: CUSTOM PERIODIC=NO ARG=d1 FUNC=50*x+100
mc: ECV_LINEAR ARG=ene TEMP=300 LAMBDA_MIN=-0.2 LAMBDA_MAX=0 DIMENSIONLESS
opes: OPES_EXPANDED ARG=mc.ene PACE=2 OBSERVATION_STEPS=10 PRINT_STRIDE=10 STATE_WFILE=State.data FMT=%f
PRINT ARG=d1 FILE=COLVAR STRIDE=1
