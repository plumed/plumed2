a1: CONTACT_MATRIX GROUP=1-6 SWITCH={EXP D_0=0.2 R_0=0.1}
ones: ONES SIZE=6
cc1: MATRIX_VECTOR_PRODUCT ARG=a1,ones

aa: CONTACT_MATRIX GROUP=1-6 SWITCH={EXP D_0=0.2 R_0=0.1 D_MAX=0.66}
DFSCLUSTERING ARG=aa LABEL=dfs

# MORE_THAN1 must give the same as MORE_THAN
x: CLUSTER_PROPERTIES ARG=cc1 CLUSTERS=dfs CLUSTER=1 LESS_THAN1={RATIONAL R_0=1.5} MORE_THAN1={RATIONAL R_0=1.5} MORE_THAN2={RATIONAL R_0=0.5}
y: CLUSTER_PROPERTIES ARG=cc1 CLUSTERS=dfs CLUSTER=1 MORE_THAN={RATIONAL R_0=1.5}
z: CLUSTER_PROPERTIES ARG=cc1 CLUSTERS=dfs CLUSTER=1 MORE_THAN={RATIONAL R_0=0.5}
PRINT ARG=x_lessthan-1,x_morethan-1,y_morethan,x_morethan-2,z_morethan FILE=colvar FMT=%8.4f
