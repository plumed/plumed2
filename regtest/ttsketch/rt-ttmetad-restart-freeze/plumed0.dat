phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17

t1: TTMETAD ...
  ARG=phi,psi
  SIGMA=0.3,0.3
  HEIGHT=1.2
  PACE=500
  FILE=HILLS1
  TT_FILE=t1.h5
  FMT=%12.6f
  SKETCH_RANK=3
  SKETCH_INITRANK=6
  SKETCH_PACE=2500
  INTERVAL_MIN=-pi,-pi
  INTERVAL_MAX=pi,pi
  SKETCH_NBASIS=7
  NONINTRUSIVE
  DETERMINISTIC
...

t2: TTMETAD ...
  ARG=phi,psi
  SIGMA=0.3,0.3
  HEIGHT=1.2
  PACE=500
  FILE=HILLS2
  TT_FILE=t2.h5
  FMT=%12.6f
  SKETCH_RANK=3
  SKETCH_INITRANK=6
  SKETCH_PACE=1500
  SKETCH_UNTIL=4
  INTERVAL_MIN=-pi,-pi
  INTERVAL_MAX=pi,pi
  SKETCH_NBASIS=7
  DETERMINISTIC
...

PRINT STRIDE=500 FILE=COLVAR0 ARG=phi,psi,t1.bias,t2.bias FMT=%8.4f
