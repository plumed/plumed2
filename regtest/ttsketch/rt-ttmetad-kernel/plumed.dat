phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17
d1: DISTANCE ATOMS=2,19

tt: TTMETAD ...
  ARG=phi,psi,d1
  SIGMA=0.3,0.3,0.05
  HEIGHT=1.2
  PACE=1000
  FILE=HILLS
  FMT=%12.6f
  KERNEL_BASIS
  KERNEL_DX=0.8,0.8,0.15
  SKETCH_RANK=3
  SKETCH_INITRANK=6
  SKETCH_PACE=500
  INTERVAL_MIN=-pi,-pi,0.2
  INTERVAL_MAX=pi,pi,1.2
  SKETCH_NBASIS=8
  SKETCH_ALPHA=1.0
  DETERMINISTIC
...

PRINT STRIDE=500 FILE=COLVAR ARG=phi,psi,d1,tt.bias FMT=%8.4f
