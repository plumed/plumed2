phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17
d1: DISTANCE ATOMS=2,19

t1: TTMETAD ...
  ARG=phi,psi,d1
  SIGMA=0.3,0.3,0.05
  HEIGHT=1.2
  PACE=500
  FILE=HILLS1
  FMT=%12.6f
  SKETCH_RANK=49
  SKETCH_INITRANK=60
  SKETCH_PACE=2500
  INTERVAL_MIN=-pi,-pi,0.2
  INTERVAL_MAX=pi,pi,1.2
  SKETCH_NBASIS=7
  SKETCH_WIDTH=0.2,0.2,0.05
  DETERMINISTIC
...

t2: TTMETAD ...
  ARG=phi,psi,d1
  SIGMA=0.3,0.3,0.05
  HEIGHT=1.2
  PACE=500
  FILE=HILLS2
  TT_FILE=tt2.h5
  FMT=%12.6f
  SKETCH_RANK=49
  SKETCH_INITRANK=60
  SKETCH_PACE=2500
  INTERVAL_MIN=-pi,-pi,0.2
  INTERVAL_MAX=pi,pi,1.2
  SKETCH_NBASIS=7
  SKETCH_WIDTH=0.2,0.2,0.05
  NONINTRUSIVE
  DETERMINISTIC
...

PRINT STRIDE=500 FILE=COLVAR ARG=phi,psi,d1,t1.bias,t2.bias FMT=%8.4f
