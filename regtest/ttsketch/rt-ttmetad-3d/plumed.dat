phi: TORSION ATOMS=5,7,9,15
psi: TORSION ATOMS=7,9,15,17
d1: DISTANCE ATOMS=2,19

tt: TTMETAD ...
  ARG=phi,psi,d1
  SIGMA=0.3,0.3,0.05
  HEIGHT=1.2
  PACE=500
  BIASFACTOR=8
  TEMP=300
  FILE=HILLS
  FMT=%12.6f
  SKETCH_CUTOFF=0.01
  SKETCH_INITRANK=6
  SKETCH_PACE=2500
  INTERVAL_MIN=-pi,-pi,0.2
  INTERVAL_MAX=pi,pi,0.65
  SKETCH_NBASIS=7
  SKETCH_ALPHA=0.5
  DETERMINISTIC
...

PRINT STRIDE=500 FILE=COLVAR ARG=phi,psi,d1,tt.bias FMT=%8.4f
