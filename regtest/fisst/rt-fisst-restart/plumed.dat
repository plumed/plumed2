UNITS LENGTH=A TIME=fs ENERGY=kcal/mol
d1: DISTANCE ATOMS=1,2
f: FISST ARG=d1 PERIOD=1 MIN_FORCE=0 MAX_FORCE=1.44 NINTERPOLATE=31 INITIAL_WEIGHT_DIST=GAUSS INITIAL_WEIGHT_RATE=0.5 RESTART_FMT=%.17g IN_RESTART=first_restart.out
PRINT ARG=d1,f.bias,f.force2,f.d1_fbar FILE=colvar FMT=%8.4f
PRINT ARG=d1,f.bias,f.force2,f.d1_fbar FILE=colvar_digits FMT=%.8f
