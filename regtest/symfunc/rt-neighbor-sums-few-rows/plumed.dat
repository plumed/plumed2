# few rows (SPECIESA of 1-3 atoms) against 2000 columns: no cells, the columns in blocks shared by the threads;
# an atom in both groups (Q3). The references were computed with the contact matrix written out (chain.dat, not run by the test)
q3: Q3 SPECIESA=1,2,3 SPECIESB=3-2000 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6} MEAN
cn: COORDINATIONNUMBER SPECIESA=10 SPECIESB=1-2000 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6}
cns: SUM ARG=cn PERIODIC=NO
q6: Q6 SPECIESA=20,40 SPECIESB=1-2000 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6} MEAN
RESTRAINT ARG=q3.mean,cns,q6.mean AT=0.1,4,0.2 KAPPA=10,1,10
PRINT ARG=q3.mean,cns,q6.mean FILE=colvar FMT=%10.6f
