# 50 atoms in a box of 1.25 nm: the cells cannot be used with D_MAX=0.6; no D_MAX: all the pairs
q4: Q4 SPECIES=1-50 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6} MEAN
q1: Q1 SPECIESA=1-20 SPECIESB=10-50 SWITCH={RATIONAL R_0=0.3} MEAN
cn: COORDINATIONNUMBER SPECIES=1-50 R_0=0.3 MEAN
RESTRAINT ARG=q4.mean,q1.mean,cn.mean AT=0.2,0.3,4 KAPPA=10,10,1
PRINT ARG=q4.mean,q1.mean,cn.mean FILE=colvar FMT=%10.6f
