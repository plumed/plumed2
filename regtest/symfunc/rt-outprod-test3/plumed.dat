cmap: CONTACT_MATRIX GROUP=1-64 SWITCH={RATIONAL R_0=1.0 D_0=2.0 D_MAX=3.0}
ones: ONES SIZE=64
c: MATRIX_VECTOR_PRODUCT ARG=cmap,ones
mfc: MORE_THAN ARG=c SWITCH={RATIONAL D_0=1 R_0=3}
prod: OUTER_PRODUCT ARG=mfc,mfc MASK=cmap AVOID_THREAD_GATHER
prodf: CUSTOM ARG=prod,cmap FUNC=x*y PERIODIC=NO
s: SUM ARG=prodf PERIODIC=NO
BIASVALUE ARG=s

cmap3: CONTACT_MATRIX GROUPA=1-10 GROUPB=11-64 SWITCH={RATIONAL R_0=1.0 D_0=2.0 D_MAX=3.0}

cmap1: CONTACT_MATRIX GROUPA=1-10 GROUPB=1-64 SWITCH={RATIONAL R_0=1.0 D_0=2.0 D_MAX=3.0}
c1: MATRIX_VECTOR_PRODUCT ARG=cmap1,ones
mfc1: MORE_THAN ARG=c1 SWITCH={RATIONAL D_0=1 R_0=3}

cmap2: CONTACT_MATRIX GROUPA=11-64 GROUPB=1-64 SWITCH={RATIONAL R_0=1.0 D_0=2.0 D_MAX=3.0}
c2: MATRIX_VECTOR_PRODUCT ARG=cmap2,ones
mfc2: MORE_THAN ARG=c2 SWITCH={RATIONAL D_0=1 R_0=3}

prod2: OUTER_PRODUCT ARG=mfc1,mfc2 MASK=cmap3 AVOID_THREAD_GATHER
prodf2: CUSTOM ARG=prod2,cmap3 FUNC=y*x*sin(x) MASK=cmap3 PERIODIC=NO
s2: SUM ARG=prodf2 PERIODIC=NO
PRINT ARG=s,s2 FILE=colvar FMT=%8.4f
BIASVALUE ARG=s2

