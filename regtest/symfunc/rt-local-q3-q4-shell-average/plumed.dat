q3: Q3 SPECIES=1-64 SWITCH={RATIONAL D_0=3.0 R_0=1.5}
q4: Q4 SPECIES=1-64 SWITCH={RATIONAL D_0=3.0 R_0=1.5}
lq3: LOCAL_Q3 SPECIES=q3 SWITCH={RATIONAL D_0=3.0 R_0=1.5} MEAN
lq4: LOCAL_Q4 SPECIES=q4 SWITCH={RATIONAL D_0=3.0 R_0=1.5} MEAN

# the average of a function of the bond vectors (in cs_n) is the sum divided by the coordination number
cs: COORDINATION_SHELL_AVERAGE SPECIES=1-64 SWITCH={RATIONAL D_0=3.0 R_0=1.5} FUNCTION=(x^4+y^4+z^4)/(r^4)
csf: COORDINATION_SHELL_FUNCTION SPECIES=1-64 SWITCH={RATIONAL D_0=3.0 R_0=1.5} FUNCTION=(x^4+y^4+z^4)/(r^4)
cn: COORDINATIONNUMBER SPECIES=1-64 SWITCH={RATIONAL D_0=3.0 R_0=1.5}
csr: CUSTOM ARG=csf,cn FUNC=x/y PERIODIC=NO
csd: CUSTOM ARG=cs_n,csr FUNC=abs(x-y) PERIODIC=NO
diff: SUM ARG=csd PERIODIC=NO
csm: MEAN ARG=cs_n PERIODIC=NO

PRINT ARG=lq3.mean,lq4.mean,csm,diff FILE=colvar FMT=%8.4f
BIASVALUE ARG=lq3.mean,lq4.mean,csm
