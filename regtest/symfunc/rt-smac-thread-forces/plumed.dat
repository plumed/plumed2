m3: DISTANCES COMPONENTS ATOMS1=1,2 LOCATION1=1 ATOMS2=3,4 LOCATION2=3 ATOMS3=5,6 LOCATION3=5 ATOMS4=7,8 LOCATION4=7 ATOMS5=9,10 LOCATION5=9 ATOMS6=11,12 LOCATION6=11 ATOMS7=13,14 LOCATION7=13 ATOMS8=15,16 LOCATION8=15
s2: SMAC SPECIES=m3 KERNEL1={GAUSSIAN CENTER=0 SIGMA=0.480} KERNEL2={GAUSSIAN CENTER=pi SIGMA=0.480} SWITCH={RATIONAL R_0=0.6} MORE_THAN={RATIONAL R_0=0.7} SWITCH_COORD={EXP R_0=4}
BIASVALUE ARG=s2.*
PRINT ARG=s2.* FILE=COLVAR FMT=%.14g
