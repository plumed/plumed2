cmap: CONTACT_MATRIX GROUP=1-64 SWITCH={RATIONAL R_0=2.0 D_0=2.0}
ones: ONES SIZE=64
c: MATRIX_VECTOR_PRODUCT ARG=cmap,ones
mfc: MORE_THAN ARG=c SWITCH={RATIONAL D_0=7 R_0=3}
prod: OUTER_PRODUCT ARG=mfc,mfc AVOID_THREAD_GATHER
prodf: CUSTOM ARG=prod FUNC=x*sin(x) PERIODIC=NO
s: SUM ARG=prodf PERIODIC=NO
PRINT ARG=s FILE=colvar FMT=%8.4f
BIASVALUE ARG=s
