# Q3 (odd l) with GROUP, Q6 and COORDINATIONNUMBER with GROUPA and GROUPB that overlap
q3: Q3 SPECIES=1-300 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6} MEAN
q6: Q6 SPECIESA=1-100 SPECIESB=51-300 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6} MEAN
cn: COORDINATIONNUMBER SPECIESA=1-150 SPECIESB=100-300 SWITCH={RATIONAL R_0=0.3 D_MAX=0.6} MEAN
cns: SUM ARG=cn PERIODIC=NO
RESTRAINT ARG=q3.mean,q6.mean,cn.mean,cns AT=0.1,0.2,4,600 KAPPA=10,10,1,0.001
PRINT ARG=q3.mean,q6.mean,cn.mean FILE=colvar FMT=%10.6f
