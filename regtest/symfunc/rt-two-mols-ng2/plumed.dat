mols1: DISTANCES ...
  ATOMS1=1,2 LOCATION1=1
  ATOMS2=5,6 LOCATION2=5
  COMPONENTS 
...

mols2: DISTANCES ...
  ATOMS1=9,10 LOCATION1=9
  ATOMS2=13,14 LOCATION2=13
  ATOMS3=17,18 LOCATION3=17
  COMPONENTS
...

vecs1: VSTACK ARG=mols1.x,mols1.y,mols1.z
vecs2: VSTACK ARG=mols2.x,mols2.y,mols2.z 
vecs2T: TRANSPOSE ARG=vecs2

dd: TORSIONS_MATRIX ARG=vecs1,vecs2T POSITIONS1=mols1 POSITIONS2=mols2 AVOID_THREAD_GATHER

ones: ONES SIZE=3
cc: MATRIX_VECTOR_PRODUCT ARG=dd,ones 
ff: SUM ARG=cc PERIODIC=NO

BIASVALUE ARG=ff 
PRINT ARG=ff FILE=colvar FMT=%8.4f 
