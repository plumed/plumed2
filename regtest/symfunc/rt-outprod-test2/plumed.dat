ones: ONES SIZE=64

cmap1: CONTACT_MATRIX GROUPA=1-10 GROUPB=1-64 SWITCH={RATIONAL R_0=2.0 D_0=2.0}
c1: MATRIX_VECTOR_PRODUCT ARG=cmap1,ones
mfc1: MORE_THAN ARG=c1 SWITCH={RATIONAL D_0=7 R_0=3}

cmap2: CONTACT_MATRIX GROUPA=11-64 GROUPB=1-64 SWITCH={RATIONAL R_0=2.0 D_0=2.0}
c2: MATRIX_VECTOR_PRODUCT ARG=cmap2,ones
mfc2: MORE_THAN ARG=c2 SWITCH={RATIONAL D_0=7 R_0=3}

prod: OUTER_PRODUCT ARG=mfc1,mfc2 AVOID_THREAD_GATHER
prodf: CUSTOM ARG=prod FUNC=x*sin(x) PERIODIC=NO
s: SUM ARG=prodf PERIODIC=NO
PRINT ARG=s FILE=colvar FMT=%8.4f
BIASVALUE ARG=s
