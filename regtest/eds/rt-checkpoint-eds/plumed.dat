# exact restart of EDS (variance, covariance with virial, Levenberg-Marquardt, ramp) from the checkpoint: see config
CHECKPOINT FILE=plumed.cpt
d1: DISTANCE ATOMS=1,2
d2: DISTANCE ATOMS=2,3
d3: DISTANCE ATOMS=3,4
eds1: EDS ARG=d1,d2 CENTER=1.0,1.0 PERIOD=4 OUT_RESTART=eds1_restart TEMP=300.0 SEED=574 MULTI_PROP=0.7 RESTART_FMT=%.17g
eds2: EDS ARG=d1,d2,d3 CENTER=1.0,1.0,1.0 BIAS_SCALE=0.5,0.25,0.75 PERIOD=4 OUT_RESTART=eds2_restart TEMP=300.0 COVAR SEED=575 MULTI_PROP=0.9 RESTART_FMT=%.17g VIRIAL=1.0
eds3: EDS ARG=d1,d2,d3 CENTER=1.0,1.0,1.0 PERIOD=4 OUT_RESTART=eds3_restart TEMP=300.0 LM LM_MIXING=0.5 MULTI_PROP=1 RESTART_FMT=%.17g
eds4: EDS ARG=d3 CENTER=1.0 FIXED=-3.0 INIT=0.5 RAMP PERIOD=30 OUT_RESTART=eds4_restart TEMP=300.0 RESTART_FMT=%.17g
PRINT ARG=eds1.*,eds2.*,eds3.*,eds4.* FILE=COLVAR STRIDE=1 FMT=%.17g
