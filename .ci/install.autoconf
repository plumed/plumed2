#! /usr/bin/env bash

set -e
set -x

cd "$(mktemp -dt plumed.XXXXXX)"

dir=autoconf-$1

# Use an independent mirror before the redirector, which can send us back to
# ftp.gnu.org. Bound each attempt and overwrite any partial download on retry.
wget --timeout=30 --tries=2 -O "$dir.tar.gz" "https://ftp.gnu.org/gnu/autoconf/$dir.tar.gz" ||
wget --timeout=30 --tries=2 -O "$dir.tar.gz" "https://mirrors.kernel.org/gnu/autoconf/$dir.tar.gz" ||
wget --timeout=30 --tries=2 -O "$dir.tar.gz" "https://ftpmirror.gnu.org/autoconf/$dir.tar.gz"

tar xzf $dir.tar.gz

cd $dir

./configure --prefix "$HOME/opt"
make
make install

