integrator = md-vv
nsteps = 6
dt = 0.0001
nstlist = 5
cutoff-scheme = Verlet
rlist = 1.05
verlet-buffer-tolerance = -1
coulombtype = Cut-off
rcoulomb = 1.0
vdwtype = Cut-off
vdw-modifier = None
rvdw = 1.0
pbc = xyz
tcoupl = v-rescale
tc-grps = System
tau-t = 0.1
ref-t = 300
pcoupl = no
constraints = none
gen-vel = yes
gen-temp = 300
gen-seed = 12345
ld-seed = 23456
nstenergy = 1
nstlog = 1
nstcalcenergy = 1
nstcomm = 1
nstxout = 1
nstvout = 1
nstfout = 1

free-energy = expanded
init-lambda-state = 0
fep-lambdas = 0 0.3 0.7 1
calc-lambda-neighbors = -1
nstdhdl = 10
sc-alpha = 0
sc-power = 1
sc-sigma = 0.3

nstexpanded = 5
lmc-stats = no
lmc-move = gibbs
