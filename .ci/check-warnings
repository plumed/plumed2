#! /usr/bin/env python3
"""Usage: .ci/check-warnings build.log

Fails if the compiler printed a warning for PLUMED's own code. The third-party libraries that PLUMED
embeds (the same ones .codecov.yml ignores) are not checked: their warnings are fixed upstream.
"""

import os
import re
import sys

THIRDPARTY = ("asmjit", "blas", "lapack", "lepton", "xdrfile", "thread_mpi")
# files generated from other projects inside PLUMED modules
THIRDPARTY_FILES = ("vesin.cpp", "vesin.h")

if len(sys.argv) != 2 or not os.path.isfile(sys.argv[1]):
    sys.exit(__doc__)

src = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "src")
modules = [d for d in os.listdir(src) if os.path.isdir(os.path.join(src, d)) and d not in ("include", "lib")]
names = {d: set(os.listdir(os.path.join(src, d))) for d in modules}
thirdparty_only = set().union(*(names[d] for d in THIRDPARTY if d in names))
thirdparty_only -= set().union(*(names[d] for d in modules if d not in THIRDPARTY))

directory = ""
warnings = set()
with open(sys.argv[1], errors="replace") as f:
    for line in f:
        m = re.search(r"Entering directory .(.*).$", line.strip())
        if m:
            directory = os.path.basename(m.group(1))
            continue
        m = re.match(r"(\S+?):\d+:(\d+:)? warning:", line)
        if not m:
            continue
        path = m.group(1)
        while path.startswith("./"):
            path = path[2:]
        if os.path.basename(path) in THIRDPARTY_FILES:
            thirdparty = True
        elif "/" in path:
            parts = path.split("/")
            thirdparty = any(p in THIRDPARTY for p in parts[:-1])
        elif path in thirdparty_only:
            thirdparty = True
        else:
            # a file name without directory: make runs in the directory of the module that is compiled
            # (exact when make is run with --output-sync)
            thirdparty = directory in THIRDPARTY and path in names.get(directory, ())
        if not thirdparty:
            warnings.add(line.rstrip())

if warnings:
    print("Warnings in PLUMED code:")
    print("\n".join(sorted(warnings)))
    print(f"{len(warnings)} warnings")
    sys.exit(1)
print("No warnings in PLUMED code")
