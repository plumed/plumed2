#! /usr/bin/env bash

set -euo pipefail
set -x

# Install metatomic-core and metatomic-torch, which contains the plugin running
# TorchScript models, in the active Python environment.
#
# metatomic-core is not released on PyPI yet, so both are built from a pinned
# commit, which needs Python >= 3.11, Rust >= 1.88 and CMake. torch and
# metatensor-torch must already be installed, since metatomic-torch is compiled
# against them.
#
# The metatomic-torch plugin is not released yet, so this is the head of the
# pull request adding it to metatomic.
METATOMIC_COMMIT=9b01833e390aba3884a2f0ef4c2ace328dc356d4
PYTHON_BIN="${PYTHON_BIN:-$(command -v python)}"

# PLUMED's CI exports the flags linking the kernel against LibTorch. CMake hands
# them to every compiler check it runs here, and metatomic-core, which does not
# use torch at all, fails those checks. Both wheels find torch through Python.
unset LDFLAGS CPPFLAGS

# The plugin of metatomic-torch finds libmetatensor_torch (and libtorch,
# libmetatensor) relative to its own directory, so metatomic has to go in the
# same site-packages as metatensor-torch, which PLUMED's CI installs with --user.
# Elsewhere, PLUMED fails to dlopen the plugin.
PIP_USER=$("$PYTHON_BIN" -c 'import importlib.util, site; print(int(importlib.util.find_spec("metatensor_torch").origin.startswith(site.getusersitepackages())))')
export PIP_USER

cd "$(mktemp -dt plumed.XXXXXX)"

# blobless rather than shallow, the packages compute their version from git tags
git clone --quiet --filter=blob:none https://github.com/metatensor/metatomic.git metatomic
cd metatomic
git fetch --quiet origin "$METATOMIC_COMMIT"
git checkout --quiet "$METATOMIC_COMMIT"

"$PYTHON_BIN" -m pip install "setuptools>=77" "packaging>=26" cmake setuptools-scm \
  "metatensor-core>=0.2.0,<0.3" "metatensor-operations>=0.5.0,<0.6" \
  "metatensor-learn>=0.6.0,<0.7" "wigners>=0.4.0"

"$PYTHON_BIN" -m pip install --no-deps --no-build-isolation ./python/metatomic_core
"$PYTHON_BIN" -m pip install --no-deps --no-build-isolation ./python/metatomic_torch

"$PYTHON_BIN" -c "import metatomic_torch; print(metatomic_torch.utils.legacy_plugin_path)"
