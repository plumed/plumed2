#include <plumed/mpiwrap/mpiwrap.h>
#include <plumed/mpiwrap/provider-callbacks.h>

static_assert(sizeof(((plumed_mpiw_handle_storage *)0)->bytes) == 24,
              "configured handle capacity remains available in native builds");
static_assert(sizeof(((plumed_mpiw_status *)0)->raw) == 192,
              "configured status capacity remains available in native builds");

int main() {
  return MPI_SUCCESS;
}
