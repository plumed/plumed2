#include "provider-abi.h"

#include <cstdlib>
#include <fstream>

namespace {
plumed_mpiw_provider_descriptor descriptor{};
struct UnloadMarker {
  ~UnloadMarker() {
    const char *path=std::getenv("MPIW_TEST_PROVIDER_MARKER");
    if(path) {
      std::ofstream output(path);
      output << "unloaded\n";
    }
  }
} unload_marker;
}

extern "C" const plumed_mpiw_provider_descriptor *plumed_mpiw_provider_factory() {
  return &descriptor;
}
