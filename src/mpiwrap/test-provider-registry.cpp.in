// Focused tests for ABI3 provider validation and owned descriptor snapshots.
#include "provider-registry.hpp"
#include "provider-callbacks.h"
#include "mpiwrap.h"

#include <cassert>
#include <cstdint>
#include <cstring>
#include <stdexcept>
#include <string>

namespace PLMD {
namespace mpiwrap_provider_test {

void fakeRank(void *communicator_storage, void *rank_storage, void *result) {
  std::uint32_t communicator = 0;
  std::memcpy(&communicator, communicator_storage, sizeof(communicator));
  *static_cast<std::int32_t *>(rank_storage) = static_cast<std::int32_t>(communicator + 42);
  const std::int32_t success = 0;
  std::memcpy(result, &success, sizeof(success));
}

void fakeCommDup(void *communicator_storage, void *new_communicator_storage,
                 void *result) {
  std::uint32_t communicator = 0;
  std::memcpy(&communicator, communicator_storage, sizeof(communicator));
  if (communicator == UINT32_C(13)) {
    const std::int32_t failure = 17;
    std::memcpy(result, &failure, sizeof(failure));
    return;
  }
  const std::uint32_t duplicate = UINT32_C(0x12345678);
  std::memcpy(new_communicator_storage, &duplicate, sizeof(duplicate));
  const std::int32_t success = 0;
  std::memcpy(result, &success, sizeof(success));
}

void fakeRankAlternative(void *, void *, void *result) {
  const std::int32_t success = 0;
  std::memcpy(result, &success, sizeof(success));
}

void fakeFinalized(void *flag_storage, void *result) {
  const std::int32_t finalized = 1;
  const std::int32_t success = 0;
  std::memcpy(flag_storage, &finalized, sizeof(finalized));
  std::memcpy(result, &success, sizeof(success));
}

void fakeConstant(void *output) {
  const std::int32_t value = 23;
  std::memcpy(output, &value, sizeof(value));
}

void fakeConstantAlternative(void *output) {
  fakeConstant(output);
}

plumed_mpiw_provider_descriptor makeDescriptor(
  plumed_mpiw_function_entry *functions, std::uint64_t function_count,
  plumed_mpiw_metadata_entry *metadata, std::uint64_t metadata_count,
  const char *description) {
  plumed_mpiw_provider_descriptor descriptor{};
  descriptor.struct_size = sizeof(descriptor);
  descriptor.abi_major = PLUMED_MPIW_PROVIDER_ABI_MAJOR;
  descriptor.abi_minor = 0;
  descriptor.ranks_are_threads = 0;
  descriptor.description = description;
  descriptor.native_comm_size = sizeof(std::uint32_t);
  descriptor.native_group_size = sizeof(std::uint64_t);
  descriptor.native_datatype_size = sizeof(std::uint64_t);
  descriptor.native_request_size = sizeof(std::uint64_t);
  descriptor.native_op_size = sizeof(std::uint64_t);
  descriptor.native_errhandler_size = sizeof(std::uint64_t);
  descriptor.native_status_size = 20;
  descriptor.native_status_source_offset = 0;
  descriptor.native_status_tag_offset = 4;
  descriptor.native_status_error_offset = 8;
  descriptor.native_fint_size = sizeof(std::int32_t);
  descriptor.native_fint_signed = 1;
  descriptor.function_count = function_count;
  descriptor.functions = functions;
  descriptor.metadata_count = metadata_count;
  descriptor.metadata = metadata;
  return descriptor;
}

plumed_mpiw_function_entry rankEntry(plumed_mpiw_generic_fn function) {
  plumed_mpiw_function_entry entry{};
  entry.struct_size = sizeof(entry);
  entry.name = "MPI_Comm_rank";
  entry.signature_id = UINT32_C(0x4e7672aa);
  entry.signature_version = 1;
  entry.argument_count = 2;
  entry.function = function;
  return entry;
}

plumed_mpiw_function_entry commDupEntry(plumed_mpiw_generic_fn function) {
  plumed_mpiw_function_entry entry{};
  entry.struct_size = sizeof(entry);
  entry.name = "MPI_Comm_dup";
  entry.signature_id = UINT32_C(0xf0dc6608);
  entry.signature_version = 1;
  entry.argument_count = 2;
  entry.function = function;
  return entry;
}

plumed_mpiw_function_entry finalizedEntry(plumed_mpiw_generic_fn function) {
  plumed_mpiw_function_entry entry{};
  entry.struct_size = sizeof(entry);
  entry.name = "MPI_Finalized";
  entry.signature_id = UINT32_C(0x105b65c7);
  entry.signature_version = 1;
  entry.argument_count = 1;
  entry.function = function;
  return entry;
}

int run() {
  using PLMD::mpiwrap_provider::Registry;

  Registry &current = PLMD::mpiwrap_provider::currentRegistry();
  assert(!current.installed());
  assert(!PLMD::pointers::ready.load(std::memory_order_acquire));
#define PLUMED_MPIW_PROVIDER_POINTER(name, suffix) assert(!PLMD::mpiwrap_has_##suffix());
#define PLUMED_MPIW_PROVIDER_CONSTANT(name, suffix, bridge)
#include "provider-pointer-publish.inc"
#undef PLUMED_MPIW_PROVIDER_CONSTANT
#undef PLUMED_MPIW_PROVIDER_POINTER
  assert(!current.installed());
  assert(!PLMD::pointers::ready.load(std::memory_order_acquire));

  plumed_mpiw_function_entry functions[] = {
    rankEntry(reinterpret_cast<plumed_mpiw_generic_fn>(&fakeRank)),
    commDupEntry(reinterpret_cast<plumed_mpiw_generic_fn>(&fakeCommDup)),
    finalizedEntry(reinterpret_cast<plumed_mpiw_generic_fn>(&fakeFinalized)),
  };
  plumed_mpiw_constant_accessor_fn constant = &fakeConstant;
  char optional_payload[] = "future";
  char optional_name[] = "future:payload";
  plumed_mpiw_metadata_entry metadata[] = {
    {
      sizeof(plumed_mpiw_metadata_entry), PLUMED_MPIW_VALUE_ACCESSOR, 0,
      "value:MPI_SUCCESS", sizeof(constant), sizeof(std::int32_t), &constant
    },
    {
      sizeof(plumed_mpiw_metadata_entry), 91, 0, optional_name,
      sizeof(optional_payload), 0, optional_payload
    },
  };
  char description[] = "temporary test description";
  plumed_mpiw_provider_descriptor descriptor = makeDescriptor(
        functions, 3, metadata, 2, description);

  Registry registry;
  std::string error;
  assert(registry.install(&descriptor, error));
  assert(error.empty());
  std::memset(description, 'x', sizeof(description) - 1);
  std::memset(optional_payload, 'y', sizeof(optional_payload) - 1);
  std::memset(optional_name, 'z', sizeof(optional_name) - 1);

  const plumed_mpiw_provider_descriptor *snapshot = registry.descriptorSnapshot();
  assert(snapshot && snapshot != &descriptor);
  assert(std::strcmp(snapshot->description, "temporary test description") == 0);
  assert(snapshot->metadata_count == 2);
  assert(std::strcmp(snapshot->metadata[1].name, "future:payload") == 0);
  assert(snapshot->metadata[1].value_size == sizeof(optional_payload));
  assert(std::memcmp(snapshot->metadata[1].value, "future", sizeof(optional_payload)) == 0);
  assert(snapshot->metadata[0].value_size == sizeof(constant));
  assert(snapshot->metadata[0].native_value_size == sizeof(std::int32_t));

  plumed_mpiw_generic_fn erased = registry.dispatch(
                                    "MPI_Comm_rank", UINT32_C(0x4e7672aa), 1, 2);
  assert(erased == reinterpret_cast<plumed_mpiw_generic_fn>(&fakeRank));
  plumed_mpiw_transport_MPI_Comm_rank_fn dispatch =
    reinterpret_cast<plumed_mpiw_transport_MPI_Comm_rank_fn>(erased);
  std::uint32_t communicator = 7;
  std::int32_t rank_value = -1;
  std::int32_t return_value = -1;
  dispatch(&communicator, &rank_value, &return_value);
  assert(return_value == 0 && rank_value == 49);
  assert(registry.dispatch("MPI_Comm_dup", UINT32_C(0xf0dc6608), 1, 2) != nullptr);
  plumed_mpiw_generic_fn finalized_erased = registry.dispatch(
        "MPI_Finalized", UINT32_C(0x105b65c7), 1, 1);
  assert(finalized_erased == reinterpret_cast<plumed_mpiw_generic_fn>(&fakeFinalized));
  plumed_mpiw_transport_MPI_Finalized_fn finalized_dispatch =
    reinterpret_cast<plumed_mpiw_transport_MPI_Finalized_fn>(finalized_erased);
  std::int32_t finalized_flag = 0;
  std::int32_t finalized_result = -1;
  finalized_dispatch(&finalized_flag, &finalized_result);
  assert(finalized_result == 0 && finalized_flag == 1);
  Registry &bridge_registry = PLMD::mpiwrap_provider::currentRegistry();
  assert(bridge_registry.install(&descriptor, error));
  plumed_mpiw_handle_storage comm_handle{};
  std::memset(comm_handle.bytes, 0x5a, sizeof(comm_handle.bytes));
  std::memcpy(comm_handle.bytes, &communicator, sizeof(communicator));
  plumed_mpiw_handle_storage duplicate_handle;
  std::memset(duplicate_handle.bytes, 0xa5, sizeof(duplicate_handle.bytes));
  assert(bridge_registry.bindings().MPI_Comm_dup_pointer(comm_handle, &duplicate_handle) == 0);
  std::uint32_t duplicate_value = 0;
  std::memcpy(&duplicate_value, duplicate_handle.bytes, sizeof(duplicate_value));
  assert(duplicate_value == UINT32_C(0x12345678));
  for (std::size_t i = sizeof(duplicate_value); i < sizeof(duplicate_handle.bytes); ++i) {
    assert(duplicate_handle.bytes[i] == 0);
  }
  std::memset(comm_handle.bytes, 0x5a, sizeof(comm_handle.bytes));
  const std::uint32_t fail_input = 13;
  std::memcpy(comm_handle.bytes, &fail_input, sizeof(fail_input));
  std::memset(duplicate_handle.bytes, 0xa5, sizeof(duplicate_handle.bytes));
  assert(bridge_registry.bindings().MPI_Comm_dup_pointer(comm_handle, &duplicate_handle) == 17);
  for (std::size_t i = 0; i < sizeof(duplicate_handle.bytes); ++i) {
    assert(duplicate_handle.bytes[i] == 0xa5);
  }
  assert(!registry.dispatch("MPI_Comm_rank", UINT32_C(0x4e7672aa), 1, 1));
  assert(registry.nativeConstantSize("MPI_SUCCESS") == sizeof(std::int32_t));
  std::int32_t success = 0;
  assert(registry.copyNativeValue("MPI_SUCCESS", &success, sizeof(success)));
  assert(success == 23);

  // A changed diagnostic label does not make an otherwise identical provider conflict.
  plumed_mpiw_provider_descriptor same_provider = descriptor;
  same_provider.description = "another diagnostic label";
  metadata[1].name = "future:payload";
  std::memcpy(optional_payload, "future", sizeof(optional_payload));
  assert(registry.install(&same_provider, error));

  plumed_mpiw_function_entry conflicting_functions[] = {
    rankEntry(reinterpret_cast<plumed_mpiw_generic_fn>(&fakeRankAlternative)),
    functions[1],
    functions[2],
  };
  plumed_mpiw_provider_descriptor conflict = makeDescriptor(
        conflicting_functions, 3, metadata, 2, "conflict");
  assert(!registry.install(&conflict, error));
  assert(error.find("conflicting") != std::string::npos);

  // Independent header instantiations share a native runtime but have their
  // own transport/accessor addresses. Keep the first installed table alive.
  plumed_mpiw_generic_fn runtime_identity =
    reinterpret_cast<plumed_mpiw_generic_fn>(&fakeFinalized);
  plumed_mpiw_metadata_entry identified_metadata[] = {
    metadata[0],
    {
      sizeof(plumed_mpiw_metadata_entry), PLUMED_MPIW_VALUE_OPAQUE, 0,
      "identity:runtime", sizeof(runtime_identity), 0, &runtime_identity
    },
  };
  auto identified = makeDescriptor(functions, 3, identified_metadata, 2, "identified");
  Registry independent_headers;
  assert(independent_headers.install(&identified, error));
  plumed_mpiw_constant_accessor_fn other_constant = &fakeConstantAlternative;
  identified_metadata[0].value = &other_constant;
  identified.functions = conflicting_functions;
  assert(independent_headers.install(&identified, error));
  assert(independent_headers.dispatch("MPI_Comm_rank", UINT32_C(0x4e7672aa), 1, 2) ==
         reinterpret_cast<plumed_mpiw_generic_fn>(&fakeRank));
  identified_metadata[0].native_value_size = sizeof(std::int64_t);
  assert(!independent_headers.install(&identified, error));
  identified_metadata[0].native_value_size = sizeof(std::int32_t);
  runtime_identity = reinterpret_cast<plumed_mpiw_generic_fn>(&fakeRank);
  assert(!independent_headers.install(&identified, error));

  Registry null_description_registry;
  plumed_mpiw_provider_descriptor no_description = makeDescriptor(
        functions, 3, metadata, 2, nullptr);
  assert(null_description_registry.install(&no_description, error));
  assert(null_description_registry.descriptorSnapshot()->description == nullptr);

  Registry late_provider;
  late_provider.markProviderValueUsed("MPI_COMM_WORLD");
  assert(!late_provider.install(&descriptor, error));
  assert(error.find("before the first MPI value") != std::string::npos);

  plumed_mpiw_provider_descriptor old_abi = descriptor;
  old_abi.abi_major = 2;
  Registry old_provider;
  assert(!old_provider.install(&old_abi, error));
  assert(error.find("ABI major") != std::string::npos);

  plumed_mpiw_provider_descriptor bad_size = descriptor;
  bad_size.native_comm_size = sizeof(plumed_mpiw_handle_storage) + 1;
  Registry invalid_size;
  assert(!invalid_size.install(&bad_size, error));

  // Check the minimum before subtracting field widths from an unsigned size.
  auto truncated_status = descriptor;
  truncated_status.native_status_size = 1;
  truncated_status.native_status_source_offset = 0;
  truncated_status.native_status_tag_offset = 0;
  truncated_status.native_status_error_offset = 0;
  Registry invalid_status;
  assert(!invalid_status.install(&truncated_status, error));

  plumed_mpiw_metadata_entry unknown_required = metadata[1];
  unknown_required.flags = PLUMED_MPIW_METADATA_REQUIRED;
  plumed_mpiw_provider_descriptor required_unknown = makeDescriptor(
        functions, 2, &unknown_required, 1, "required unknown");
  Registry rejects_unknown;
  assert(!rejects_unknown.install(&required_unknown, error));
  assert(error.find("unknown required") != std::string::npos);

  return 0;
}

}  // namespace mpiwrap_provider_test
}  // namespace PLMD

int main() {
  return PLMD::mpiwrap_provider_test::run();
}
