#! /usr/bin/env bash
# cd ../../src ; tar cf - */*.h */*.cuh */*/*.h | tar xf - -C "$(DESTDIR)$(includedir)/$(program_name)/"

cd ../../src

where="$1"
shift

script=""
includedir=
dirs=$*

for dir in $dirs
do
script="$script"'
s|^# *include *"'$dir'/|#include "../'$dir'/|'
done
export LC_ALL=C

for dir in $dirs
do
# .cuh: the CUDA headers of the modules with toolchain cuda, for the modules built against an installed base
for file in $dir/*.h $dir/*.cuh
do
  if test -e $file ; then
    mkdir -p "$where/${file%/*}"
    cat $file | sed "$script" > "$where/$file"
  fi
done
done
