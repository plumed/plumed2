#! /bin/sh
# Flags for the compilers of the modules with "toolchain: cuda" in their module.yml.
# The only copy of these rules: used by configure (native build) and by
# extensions/build.py (build against an installed base). No Python is needed.
#
#   cuda-flags compile nvcc|hipcc FLAGS...   C++ compiler flags (CXXFLAGS) translated for nvcc or hipcc
#   cuda-flags host-compiler CXX...          the host compiler for nvcc -ccbin (CXX without a launcher such as ccache)
#   cuda-flags mpi-include CXX...            -I for the directory of mpi.h found by CXX (hipcc does not use
#                                            the host compiler, that may be an MPI wrapper)
#   cuda-flags libdirs NVCC...               the directories of the CUDA runtime libraries known to nvcc
#
# Each translated flag is printed on its own line.

usage() {
  echo "usage: $0 compile nvcc|hipcc FLAGS... | host-compiler CXX... | mpi-include CXX... | libdirs NVCC..." >&2
  exit 1
}

test $# -ge 1 || usage
mode=$1
shift

case $mode in
(compile)
  test $# -ge 1 || usage
  kind=$1
  shift
  # the options that nvcc does not know go to the host compiler (e.g. -pipe in conda builds)
  test "$kind" = nvcc && printf '%s\n' --forward-unknown-to-host-compiler
  for flag in "$@"; do
    case $kind in
    (nvcc)
      case $flag in
      # -fconcepts (e.g. needed by ITensor in the main build) makes libstdc++ expose C++20
      # concepts code that nvcc cannot parse in C++17 mode
      (-fconcepts) ;;
      # -pedantic adds a useless warning for each line directive of the code generated by nvcc
      (-pedantic|-Wpedantic) ;;
      # options of the host compiler: -f..., -W..., -m... (e.g. -march=native), -gdwarf..., -pthread
      (-f*|-W*|-m*|-gdwarf*|-pthread) printf '%s\n' -Xcompiler "$flag" ;;
      (*) printf '%s\n' "$flag" ;;
      esac
      ;;
    (hipcc)
      case $flag in
      # hipcc (clang) takes the flags of the host compiler as they are, except these
      (-fconcepts|-fno-gnu-unique) ;;
      (*) printf '%s\n' "$flag" ;;
      esac
      ;;
    (*) usage ;;
    esac
  done
  ;;
(host-compiler)
  test $# -ge 1 || usage
  # nvcc -ccbin takes a compiler, not a launcher: ccache is removed
  # (e.g. PLUMED configured with CXX="ccache mpic++")
  case $1 in
  (ccache|*/ccache|sccache|*/sccache) shift ;;
  esac
  test $# -ge 1 || usage
  printf '%s\n' "$1"
  ;;
(mpi-include)
  test $# -ge 1 || usage
  mpih=$(echo '#include <mpi.h>' | "$@" -x c++ -E -H -o /dev/null - 2>&1 |
    sed -n 's|^\. \(.*/mpi\.h\)$|\1|p' | head -n 1)
  if test -z "$mpih"; then
    echo "$0: mpi.h not found by $*" >&2
    exit 1
  fi
  printf '%s\n' "-I${mpih%/mpi.h}"
  ;;
(libdirs)
  test $# -ge 1 || usage
  # nvcc -dryrun prints the library directories of its configuration (nvcc.profile),
  # e.g. #$ LIBRARIES=  "-L/opt/cuda/targets/x86_64-linux/lib/stubs" "-L/opt/cuda/targets/x86_64-linux/lib"
  # (the stubs directory has only a stub of the driver library)
  dir=${TMPDIR:-/tmp}/plumed-cuda-flags-$$
  mkdir "$dir" || exit 1
  : >"$dir/empty.cu"
  "$@" -dryrun -o "$dir/empty" "$dir/empty.cu" 2>&1 |
    sed -n 's/^#\$ *LIBRARIES=//p' | tr ' ' '\n' | sed -e 's/^"//' -e 's/"$//' |
    sed -n 's/^-L//p' | grep -v '/stubs/*$'
  rm -rf "$dir"
  ;;
(*) usage ;;
esac
