# Native dependencies are data in module.yml; no Python is needed by Make.
# Modules whose headers are used, but that are neither enabled nor linked (include: in module.yml).
# Always defined here: not a name taken from the environment (e.g. INCLUDE, a compiler search path)
INCLUDED_MODULES :=
ifneq ($(wildcard module.yml),)
USE := $(shell ../maketools/module-header use module.yml || echo __INVALID_MODULE_HEADER__)
ifneq ($(filter __INVALID_MODULE_HEADER__,$(USE)),)
$(error Invalid module.yml; see the diagnostic above)
endif
INCLUDED_MODULES := $(shell ../maketools/module-header include module.yml)
endif

#
# This is a generic makefile which will work for any
# subpackage which just depends on config/
# It just compiles objects locally
# 

# include the machine dependent configuration
ifneq ($(MAKECMDGOALS),clean)
  -include ../../Makefile.conf
endif

# if machine dependent configuration has been found:
ifdef GCCDEP

# source for plumed kernel
SRC=$(wildcard *.cpp)

# CUDA sources, compiled with $(CUDA_COMPILER) (modules with toolchain cuda in module.yml)
SRC_CU=$(wildcard *.cu)

# corresponding objects:
OBJ=$(SRC:.cpp=.o) $(SRC_CU:.cu=.o)

# dependency files for all c++ and CUDA sources
DEP=$(addprefix deps/,$(SRC:.cpp=.d) $(SRC_CU:.cu=.d))


.PHONY: all dirslinks obj lib install

# default target:
# update all links then build this module
all: dirslinks
	@echo Preparing for make
	$(PREMAKE)
	@echo "*** Compile local objects ***"
	$(MAKE) obj


# build links for all modules
dirslinks:
	$(MAKE) -C ../lib dirslinks

# buils objects in this module
obj: $(OBJ)

# build everything
lib:
	$(MAKE) -C ../lib

.PHONY: install
install:
	$(MAKE) -C ../lib install

ifneq ($(disable_dependency_tracking),yes)
-include $(DEP)
endif

# if machine dependent configuration has not been found:
else

.PHONY: error
error:
	@echo No configuration available
	@echo First run ./configure in the root directory
endif

# this target is available anyway

.PHONY: clean links
clean:
	@echo Clean $(CURDIR)
	../maketools/cleanlinks.sh
	rm -fr deps links
	rm -f $(CLEANLIST)

# build links for this module
links: Makefile $(wildcard module.yml) ../maketools/module-header ../maketools/module-header.awk
	@echo Verify modules and create links in $(CURDIR)
	@for dir in $(USE) ; do ../maketools/check_module.sh $$dir || exit 1 ; ../maketools/makelinks.sh $$dir || exit 1 ;  done
# an included module is not checked (it can be disabled), but it gets its own links:
# its headers include those of the modules it uses, which are searched from its directory
	@for dir in $(INCLUDED_MODULES) ; do test -f ../$$dir/module.yml || { echo "ERROR: this module includes $$dir, which does not exist" ; exit 1 ; } ; ../maketools/makelinks.sh $$dir || exit 1 ; $(MAKE) -C ../$$dir links || exit 1 ; done

.PHONY: cppcheck
cppcheck:
	../maketools/codecheck --cppcheck --local

.PHONY: plumedcheck
plumedcheck:
	../maketools/codecheck --plumedcheck --local

.PHONY: codecheck
codecheck:
	../maketools/codecheck --local

.PHONY: astyle
astyle:
	$(MAKE) -C ../../astyle
	cd ../ ; ./astyle.sh $(CURDIR)

.PHONY: show_used_modules
show_used_modules:
	@echo used_modules $(USE) $(INCLUDED_MODULES)



# generic makefile rules
include ../maketools/make.rules

