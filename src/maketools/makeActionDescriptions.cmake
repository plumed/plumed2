# Generate ActionDescriptions.inc without requiring a shell or an interpreter.
if(NOT DEFINED SRC OR NOT DEFINED OUT)
  message(FATAL_ERROR "SRC and OUT must be defined")
endif()

file(GLOB sources "${SRC}/src/*/*.cpp")
list(SORT sources)
set(content "")
foreach(source IN LISTS sources)
  file(STRINGS "${source}" lines ENCODING UTF-8)
  set(in_doc FALSE)
  set(action "")
  foreach(line IN LISTS lines)
    if(in_doc)
      if(line MATCHES "[^ \t\r]")
        if(NOT line MATCHES "^[ \t]*/\\*([ \t]|$)" AND NOT line MATCHES "^[ \t]*\\*/([ \t]|$)")
          string(HEX "${action}" action_hex)
          string(HEX "${line}" summary_hex)
          set(action_literal "")
          set(summary_literal "")
          string(LENGTH "${action_hex}" action_hex_length)
          string(LENGTH "${summary_hex}" summary_hex_length)
          if(action_hex_length GREATER 0)
            math(EXPR action_last "${action_hex_length} - 2")
            foreach(offset RANGE 0 ${action_last} 2)
              string(SUBSTRING "${action_hex}" ${offset} 2 byte)
              string(APPEND action_literal "\\x${byte}")
            endforeach()
          endif()
          if(summary_hex_length GREATER 0)
            math(EXPR summary_last "${summary_hex_length} - 2")
            foreach(offset RANGE 0 ${summary_last} 2)
              string(SUBSTRING "${summary_hex}" ${offset} 2 byte)
              string(APPEND summary_literal "\\x${byte}")
            endforeach()
          endif()
          string(APPEND content "  {\"${action_literal}\", \"${summary_literal}\"},\n")
          set(in_doc FALSE)
        endif()
      endif()
    endif()
    if(line MATCHES "^[ \t]*//\\+PLUMEDOC([ \t]+[^ \t]+)?([ \t]+([^ \t]+))?")
      set(action "${CMAKE_MATCH_3}")
      set(in_doc TRUE)
    endif()
  endforeach()
endforeach()

set(output "${OUT}/ActionDescriptions.inc")
set(temporary "${output}.tmp")
file(WRITE "${temporary}" "${content}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${temporary}" "${output}" RESULT_VARIABLE differs)
if(NOT differs EQUAL 0)
  file(RENAME "${temporary}" "${output}")
else()
  file(REMOVE "${temporary}")
endif()
