namespace PLMD {
namespace config {

namespace {
/// local tool that, given a string, returns a new string which is:
/// - enclosed in single quotes (')
/// - with all single quotes escaped
std::string escapeForSingleQuote(const std::string& input) {
  std::string escaped;
  for (char c : input) {
    if (c == '\'') {
      escaped += "'\\''";
    } else {
      escaped += c;
    }
  }
  return "'" + escaped + "'";
}
}

// This is a fix to allow conda to correctly replace paths in binary files.
// These functions should not be static or they will be optimized away!
const char* plumed_root() {
  return "@PLUMED_ROOT@";
}
const char* plumed_soext() {
  return "@SOEXT@";
}
const char* plumed_htmldir() {
  return "@htmldir@";
}
const char* plumed_includedir() {
  return "@includedir@";
}
const char* plumed_program_name() {
  return "@program_name@";
}

std::string getSoExt() {
  return plumed_soext();
}

bool isInstalled() {
  return @ISINSTALLED@;
}

std::string getPlumedRoot() {
  std::string ss;
  if(!getenvUTF8("PLUMED_ROOT",ss)) {
#ifdef __PLUMED_PIP_BUNDLE
    const std::string library=getLibraryPath();
    if(!library.empty()) {
      // Wheels use a private installation prefix: <prefix>/lib/plumed.
      // The kernel is in <prefix>/lib, or in <prefix>/bin on Windows, where DLLs are
      // installed next to the executables.
      const std::filesystem::path directory=pathFromUTF8(library).parent_path();
      const std::filesystem::path candidates[]= {directory/"plumed",directory.parent_path()/"lib"/"plumed"};
      for(const auto& candidate : candidates) {
        if(std::filesystem::exists(candidate/"scripts")) {
          return pathToUTF8(candidate);
        }
      }
    }
#endif
    ss=plumed_root();
  }
  return ss;
}

std::string getPlumedHtmldir() {
  if(!isInstalled()) {
    return getPlumedRoot();
  }
  std::string ss;
  if(!getenvUTF8("PLUMED_HTMLDIR",ss)) {
    ss=plumed_htmldir();
  }
  return ss;
}

std::string getPlumedIncludedir() {
  if(!isInstalled()) {
    return getPlumedRoot()+"/src/include";
  }
  std::string ss;
  if(!getenvUTF8("PLUMED_INCLUDEDIR",ss)) {
#ifdef __PLUMED_PIP_BUNDLE
    // Resolve headers independently of PLUMED_ROOT, as in a normal install.
    const std::string library=getLibraryPath();
    if(!library.empty()) {
      const std::filesystem::path candidate=pathFromUTF8(library).parent_path().parent_path()/"include";
      if(std::filesystem::exists(candidate/"plumed"/"wrapper"/"Plumed.h")) {
        return pathToUTF8(candidate);
      }
    }
#endif
    ss=plumed_includedir();
  }
  return ss;
}

std::string getPlumedProgramName() {
  if(!isInstalled()) {
    return "plumed";
  }
  std::string ss;
  if(!getenvUTF8("PLUMED_PROGRAM_NAME",ss)) {
    ss=plumed_program_name();
  }
  return ss;
}

std::string getEnvCommand() {
  return "env PLUMED_ROOT="+escapeForSingleQuote(getPlumedRoot())+
         " PLUMED_VERSION="+escapeForSingleQuote(getVersionLong())+
         " PLUMED_HTMLDIR="+escapeForSingleQuote(getPlumedHtmldir())+
         " PLUMED_INCLUDEDIR="+escapeForSingleQuote(getPlumedIncludedir())+
         " PLUMED_PROGRAM_NAME="+escapeForSingleQuote(getPlumedProgramName())+
         " PLUMED_IS_INSTALLED='"+(@ISINSTALLED@?"yes":"no")+"'";
}

std::string getVersion() {
  return PLUMED_VERSION_SHORT;
}

std::string getVersionLong() {
  return PLUMED_VERSION_LONG;
}

std::string getVersionGit() {
  return PLUMED_VERSION_GIT;
}

std::string getMakefile() {
  static const unsigned char confu [] = {
#include "Makefile.conf.xxd"
    , 0x00
  };
  auto conf=(char*)confu;
  return std::string(conf,conf+std::strlen(conf));
}

