std::string getCompilationDate() {
  return __DATE__;
}

std::string getCompilationTime() {
  return __TIME__;
}

std::string getModuleBuildID() {
  return PLUMED_MODULE_BUILD_ID;
}

std::vector<std::string> getBuiltInModules() {
  std::istringstream input(PLUMED_BUILTIN_MODULES);
  std::vector<std::string> modules;
  std::string name;
  while(input>>name) {
    modules.push_back(name);
  }
  return modules;
}

std::string getLibraryPath() {
#if defined(_WIN32)
  // the module (DLL, or executable for a static kernel) containing this function,
  // in UTF-8 as the other file names in PLUMED
  HMODULE module=nullptr;
  if(!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS|GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
                         reinterpret_cast<LPCWSTR>(&getLibraryPath),&module)) {
    return "";
  }
  std::wstring path(MAX_PATH,L'\0');
  for(;;) {
    const DWORD length=GetModuleFileNameW(module,path.data(),static_cast<DWORD>(path.size()));
    if(length==0) {
      return "";
    }
    if(length<path.size()) {
      path.resize(length);
      return pathToUTF8(std::filesystem::path(path));
    }
    // truncated
    path.resize(2*path.size());
  }
#elif defined(__PLUMED_HAS_DLADDR)
  Dl_info info;
  if(dladdr((void*)getLibraryPath,&info) && info.dli_fname) {
    return info.dli_fname;
  } else {
    return "";
  }
#else
  return "";
#endif
}


}
}

