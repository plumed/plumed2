

function plumed_preliminary_test(){
# check if the README.md contains the word ESPRESSO and if qe has been already configured
  grep -q ESPRESSO  README.md 1>/dev/null 2>/dev/null && test -f make.inc 
}

function plumed_before_patch(){
cp make.inc make.inc.plumedbck
PWD=`pwd`
echo "include  ${PWD}/Plumed.inc ">make.inc
# - link PLUMED
# - PLUMED is called from the legacy plugin hooks, that are only compiled with -D__LEGACY_PLUGINS:
#   add it here if QE was not configured with --enable-legacy_plugins
awk '{
  if($1=="QELIBS" && $2=="="){sub("=","= $(PLUMED_LOAD)")}
  else if($1=="DFLAGS" && $2=="=" && !/-D__LEGACY_PLUGINS/){sub("=","= -D__LEGACY_PLUGINS")}
  print
}' make.inc.plumedbck >> make.inc
}

function plumed_after_revert(){
  mv make.inc.plumedbck make.inc
}

function plumed_patch_info(){
  echo ""
  echo "For more information on Quantum Espresso you should visit http://www.quantum-espresso.org"
  echo "To apply this patch configure Quantum Espresso by running ./configure first."
  echo "PLUMED is called through the legacy plugins interface of Quantum Espresso:"
  echo "the patch adds -D__LEGACY_PLUGINS to DFLAGS in make.inc if it is not there already"
  echo "(equivalent to ./configure --enable-legacy_plugins)."
  echo "The newer CMake installation workflow is not supported yet."
  echo "To enable PLUMED on md runs use pw.x -plumed < md.in > md.out."
  echo "A fixed PLUMED input file name 'plumed.dat' is used."
  echo "By default the virial of PLUMED is NOT added to the stress of Quantum Espresso (as in the 7.2 patch),"
  echo "so the bias does not act on the cell in variable-cell runs. To add it, set the environment"
  echo "variable PLUMED_QESPRESSO_VIRIAL (to any non empty value) when running pw.x."
  echo "In that case the stress and pressure printed at each step do not include the PLUMED term,"
  echo "because it is added just after the printout: the XML file and the cell dynamics do include it."
  echo "The forces of PLUMED and its contribution to the stress are not symmetrised by Quantum Espresso."
  echo "A bias that does not have the symmetry of the crystal breaks the symmetry that Quantum Espresso"
  echo "assumes for k-points and charge density: use nosym=.true. in the pw.x input unless the collective"
  echo "variables share the crystal symmetry."
  echo "This patch was kindly provided by Ralf Meyer, email: meyer.ralf(at)yahoo.com"
}

