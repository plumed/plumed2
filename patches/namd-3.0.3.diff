patch -u -l -b -F 5 -N --suffix=.preplumed "./src/ComputeMgr.C" << \EOF_EOF
--- ./src/ComputeMgr.C.preplumed
+++ ./src/ComputeMgr.C
@@ -89,12 +89,249 @@
 #include "GlobalMasterSMD.h"
 #include "GlobalMasterTMD.h"
 #include "GlobalMasterSymmetry.h"
 #include "GlobalMasterEasy.h"
 #include "GlobalMasterMisc.h"
+// PLUMED
+#include "../Plumed.h"
+#include <cstdlib>
+#include <utility>
+#include <vector>
+#include <algorithm>
+#include "ReductionMgr.h"
+#include "Lattice.h"
+#include "Tensor.h"
+#include "Molecule.h"
+#include "PatchData.h"
+#if defined(NAMD_CUDA) && !defined(NAMD_HIP)
+// the GPU used by NAMD is passed to PLUMED
+#include "DeviceCUDA.h"
+#ifdef WIN32
+#define __thread __declspec(thread)
+#endif
+extern __thread DeviceCUDA *deviceCUDA;
+#endif
+// END PLUMED
 #include "GlobalMasterFreeEnergy.h"
 #include "GlobalMasterColvars.h"
+class GlobalMasterPlumed:
+  public  GlobalMaster,
+  private PLMD::Plumed
+{
+  // global indexes of the atoms requested by PLUMED, sorted.
+  // NAMD passes the positions in the same order
+  std::vector<int> index;
+  std::vector<double> positions;
+  std::vector<double> forces;
+  std::vector<double> masses;
+  std::vector<double> charges;
+  double box[3][3];
+  double virial[3][3];
+  SimParameters *spar;
+  Molecule *mol;
+  // used to pass to NAMD the bias energy and the part of the virial
+  // that it cannot compute by itself
+  SubmitReduction *reduction;
+#ifdef NODEGROUP_FORCE_REGISTER
+  // used instead of reduction in GPU-resident mode
+  NodeReduction *nodeReduction;
+#endif
+  // NAMD does not destroy the GlobalMaster objects when it terminates.
+  // The PLUMED object is thus finalized (files are closed) by BackEnd::exit
+  // (see plumedFinalize below), or at exit if NAMD stops in another way.
+  static GlobalMasterPlumed* & instance()
+  {
+    static GlobalMasterPlumed* p=NULL;
+    return p;
+  }
+public:
+  static void finalizeAtExit()
+  {
+    if(instance()){
+      // the temporary takes the ownership and finalizes PLUMED when it goes out of scope
+      PLMD::Plumed tmp(std::move(static_cast<PLMD::Plumed&>(*instance())));
+      // only once
+      instance()=NULL;
+    }
+  }
+  GlobalMasterPlumed()
+  {
+    spar=Node::Object()->simParameters;
+    mol=Node::Object()->molecule;
+    reduction = ReductionMgr::Object()->willSubmit(REDUCTIONS_BASIC);
+#ifdef NODEGROUP_FORCE_REGISTER
+    CProxy_PatchData cpdata(CkpvAccess(BOCclass_group).patchData);
+    nodeReduction = cpdata.ckLocalBranch()->reduction;
+#endif
+
+    int realPrecision=sizeof(double);
+    cmd("setRealPrecision",&realPrecision);
+
+    double energyUnits=4.184;
+    double lengthUnits=0.1;
+    double timeUnits=0.001;
+    cmd("setMDEnergyUnits",&energyUnits);
+    cmd("setMDLengthUnits",&lengthUnits);
+    cmd("setMDTimeUnits",&timeUnits);
+
+    cmd("setPlumedDat",spar->plumedFilename);
+
+    int natoms=mol->numAtoms;
+    cmd("setNatoms",&natoms);
+
+    cmd("setMDEngine","namd");
+
+    cmd("setLog",stdout);
+
+#if defined(NAMD_CUDA) && !defined(NAMD_HIP)
+    // The PLUMED actions that run on a GPU (plugins) use the GPU of this PE,
+    // the one that calls PLUMED, unless the user chooses otherwise
+    int plumedApi=0;
+    cmd("getApiVersion",&plumedApi);
+    if(plumedApi>9 && deviceCUDA){
+      int gpu=deviceCUDA->getDeviceID();
+      cmd("setGpuDeviceId",&gpu);
+    }
+#endif
+
+    double dt=spar->dt;
+    cmd("setTimestep",&dt);
+    cmd("init");
+
+    int s=spar->firstTimestep;
+    cmd("setStep",&s);
+    share();
+
+    // registered after PLUMED has been created, so that it is executed
+    // before the static objects of the PLUMED library are destroyed
+    if(!instance()){
+      instance()=this;
+      std::atexit(finalizeAtExit);
+    }
+  }
+  ~GlobalMasterPlumed()
+  {
+    if(instance()==this) instance()=NULL;
+    delete reduction;
+  }
+
+  // ask to NAMD the atoms needed by PLUMED at the next step
+  void share(){
+    const int* p;
+    int n;
+    cmd("prepareDependencies");
+    cmd("createFullList",&n);
+    cmd("getFullList",&p);
+    std::vector<int> sorted(p,p+n);
+    cmd("clearFullList");
+    std::sort(sorted.begin(),sorted.end());
+    if(sorted!=index){
+      index.swap(sorted);
+      masses.resize(n);
+      charges.resize(n);
+      positions.resize(3*n);
+      forces.resize(3*n);
+      modifyRequestedAtoms().resize(0);
+      for(int i=0;i<n;i++){
+        if(index[i]<0 || index[i]>=mol->numAtoms) NAMD_die("PLUMED requested an atom that does not exist");
+        modifyRequestedAtoms().add(index[i]);
+        masses[i]=mol->atommass(index[i]);
+        charges[i]=mol->atomcharge(index[i]);
+      }
+      cmd("setAtomsNlocal",&n);
+      cmd("setAtomsGatindex",index.data());
+    }
+  }
+
+protected:
+  virtual void calculate(){
+    const int n=index.size();
+
+    // the server passes the requested atoms sorted by index, as they are stored here
+    AtomIDList::const_iterator a_i=getAtomIdBegin();
+    PositionList::const_iterator p_i=getAtomPositionBegin();
+    if(getAtomIdEnd()-a_i!=n) NAMD_bug("PLUMED received a wrong number of atoms");
+    for(int i=0;i<n;i++){
+      if(a_i[i]!=index[i]) NAMD_bug("PLUMED received the atoms in an unexpected order");
+      positions[3*i+0]=p_i[i].x;
+      positions[3*i+1]=p_i[i].y;
+      positions[3*i+2]=p_i[i].z;
+    }
+
+    // use the lattice of the current step (GlobalMaster::lattice), since
+    // SimParameters::lattice is not updated by the barostats
+    const bool periodic=(lattice && lattice->volume()>0.0);
+    if(periodic){
+      for(int i=0;i<3;i++) box[0][i]=lattice->a()[i];
+      for(int i=0;i<3;i++) box[1][i]=lattice->b()[i];
+      for(int i=0;i<3;i++) box[2][i]=lattice->c()[i];
+      cmd("setBox",&box[0][0]);
+    }
+
+    for(int i=0;i<3*n;i++) forces[i]=0.0;
+    for(int i=0;i<3;i++) for(int j=0;j<3;j++) virial[i][j]=0.0;
+
+    cmd("setMasses",masses.data()); cmd("setCharges",charges.data());
+    cmd("setPositions",positions.data());
+    cmd("setForces",forces.data());
+    cmd("setVirial",&virial[0][0]);
+
+    cmd("shareData");
+    cmd("performCalc");
+
+    // energy of the bias (MISC column, included in the total energy)
+    double bias=0.0;
+    cmd("getBias",&bias);
+
+    // NAMD (ComputeGlobal::recvResults) adds to its virial sum_i outer(f_i,x_i)
+    // for the forces returned here, using the same positions passed to PLUMED.
+    // This misses the explicit dependence of the bias on the cell (periodic
+    // images chosen by PLUMED, collective variables that depend on the cell).
+    // Here we submit the difference with respect to the full PLUMED virial.
+    // PLUMED: virial[a][b] = - sum_i x_i[a] f_i[b]; NAMD: W.ab = sum_i f_i[a] x_i[b]
+    Tensor vcorr;
+    if(periodic){
+      vcorr.xx=-virial[0][0]; vcorr.xy=-virial[1][0]; vcorr.xz=-virial[2][0];
+      vcorr.yx=-virial[0][1]; vcorr.yy=-virial[1][1]; vcorr.yz=-virial[2][1];
+      vcorr.zx=-virial[0][2]; vcorr.zy=-virial[1][2]; vcorr.zz=-virial[2][2];
+    }
+
+    modifyForcedAtoms().resize(0);
+    modifyAppliedForces().resize(0);
+    for(int i=0;i<n;i++){
+      const Vector f(forces[3*i+0],forces[3*i+1],forces[3*i+2]);
+      modifyForcedAtoms().add(index[i]);
+      modifyAppliedForces().add(f);
+      if(periodic) vcorr-=outer(f,Vector(positions[3*i+0],positions[3*i+1],positions[3*i+2]));
+    }
+
+#ifdef NODEGROUP_FORCE_REGISTER
+    if(spar->CUDASOAintegrate){
+      // GPU-resident mode: the standard reductions are not used
+      nodeReduction->item(REDUCTION_MISC_ENERGY)+=bias;
+      ADD_TENSOR_OBJECT(nodeReduction,REDUCTION_VIRIAL_NORMAL,vcorr);
+    } else
+#endif
+    {
+      reduction->item(REDUCTION_MISC_ENERGY)+=bias;
+      ADD_TENSOR_OBJECT(reduction,REDUCTION_VIRIAL_NORMAL,vcorr);
+      reduction->submit();
+    }
+
+    int s=step+1;
+    cmd("setStep",&s);
+    share();
+  }
+};
+
+// Called by BackEnd::exit before NAMD releases the GPUs (cuda_finalize resets them):
+// the PLUMED actions that run on a GPU (plugins) free their memory while the GPU is
+// still there. Without this, PLUMED would be finalized at exit, after the reset.
+void plumedFinalize()
+{
+  GlobalMasterPlumed::finalizeAtExit();
+}
 
 #include "ComputeNonbondedMICKernel.h"
 #include "PatchData.h"
 #include "NamdEventsProfiling.h"
 #include "DeviceCUDA.h"
