FROM plumed:fedora44

RUN source /etc/bashrc \
 && module load mpi \
 && export OMPI_MCA_btl_base_warn_component_unused=0 \
 && export OMPI_MCA_btl_base_verbose=0 \
 && export OMPI_MCA_btl_vader_single_copy_mechanism=none \
 && export PRTE_MCA_rmaps_default_mapping_policy=:oversubscribe \
 && export PATH=$HOME/opt/bin:$PATH \
 && export CPATH=$HOME/opt/include:$CPATH \
 && export INCLUDE=$HOME/opt/include:$INCLUDE \
 && export LIBRARY_PATH=$HOME/opt/lib:$LIBRARY_PATH \
 && export LD_LIBRARY_PATH=$HOME/opt/lib:$LD_LIBRARY_PATH \
 && cd plumed2 \
 && make install \
 && pip3 install --user -r extensions/requirements.txt "pybind11>=3.0" numpy pytest \
 && ./configure --with-extension-base=$HOME/opt --enable-extension-modules=pycv \
      --prefix=$HOME/pycv PYTHON_BIN=python3 \
 && make \
 && make install \
 && export PLUMED_PLUGIN_PATH=$HOME/pycv/lib/plumed/plugins \
 && make -C regtest/pycv \
 && .ci/check-module-regtests regtest/pycv \
 && export PYTHONPATH=$HOME/opt/lib/plumed/python:$PYTHONPATH \
 && cd regtest/pycv/pythontests \
 && PLUMED_KERNEL=$HOME/opt/lib/libplumedKernel.so python3 -m pytest -v
